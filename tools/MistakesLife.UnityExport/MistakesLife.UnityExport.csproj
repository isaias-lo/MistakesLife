<Project Sdk="Microsoft.NET.Sdk">

  <!-- Copia el núcleo compilado y los paquetes dentro del proyecto de Unity. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>MistakesLife.UnityExport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../core/MistakesLife.Core/MistakesLife.Core.csproj" />
  </ItemGroup>

</Project>
