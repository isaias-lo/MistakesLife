<Project Sdk="Microsoft.NET.Sdk">

  <!-- Consola para jugar una vida en texto (fase 1). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>mistakeslife</AssemblyName>
    <RootNamespace>MistakesLife.ConsoleGame</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../core/MistakesLife.Core/MistakesLife.Core.csproj" />
  </ItemGroup>

</Project>
