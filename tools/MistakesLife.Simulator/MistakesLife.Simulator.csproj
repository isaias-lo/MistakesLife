<Project Sdk="Microsoft.NET.Sdk">

  <!-- Simulador de vidas: corre miles de vidas automáticas y escribe un informe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>mistakeslife-sim</AssemblyName>
    <RootNamespace>MistakesLife.Simulator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../core/MistakesLife.Core/MistakesLife.Core.csproj" />
  </ItemGroup>

</Project>
