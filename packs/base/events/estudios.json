[
  {
    "id": "evento.estudios.semestre_pesado",
    "condiciones": "jugador.estudia != nada && jugador.semestres_aprobados >= 1",
    "probabilidad_anual": 0.6,
    "enfriamiento_semanas": 26,
    "opciones": [
      {
        "texto": "opcion.estudios.semestre_pesado.aguantar",
        "tendencia": "jugador.responsabilidad",
        "efectos": [
          "jugador.salud -= 2",
          "jugador.felicidad -= 2",
          "jugador.inteligencia += 1"
        ]
      },
      {
        "texto": "opcion.estudios.semestre_pesado.botar_ramo",
        "tendencia": "100 - jugador.responsabilidad + si(jugador.tiene('trabaja_y_estudia') || jugador.trabaja, 25, 0)",
        "efectos": [
          "jugador.semestres_aprobados -= 1",
          "jugador.felicidad += 1",
          "diario('diario.estudios.boto_ramo')"
        ]
      }
    ]
  },
  {
    "id": "evento.estudios.ramo_reprobado",
    "condiciones": "jugador.estudia != nada && jugador.semestres_aprobados >= 1",
