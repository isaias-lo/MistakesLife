[
  {
    "id": "evento.oferta_ascenso",
    "condiciones": "jugador.puede_ascender && jugador.caminos_ascenso == 1 && mundo.ciclo != 'economia.ciclo.crisis'",
    "probabilidad_anual": 0.4,
    "enfriamiento_semanas": 26,
    "opciones": [
      {
        "texto": "opcion.oferta_ascenso.aceptar",
        "tendencia": "60 + jugador.extraversion / 4",
        "efectos": [
          "jugador.ascender()",
          "jugador.felicidad += 6",
          "jugador.salud -= 1",
          "diario('diario.ascenso')"
        ]
      },
      {
        "texto": "opcion.oferta_ascenso.rechazar",
        "tendencia": "5 + jugador.neuroticismo / 4",
        "efectos": [
          "jugador.felicidad += 1"
        ]
      }
    ]
  },
  {
    "id": "evento.mala_racha_trabajo",
    "condiciones": "jugador.area != nada && jugador.desempeno < 45",
    "probabilidad_anual": 0.4,
    "enfriamiento_semanas": 52,
    "opciones": [
      {
        "texto": "opcion.mala_racha_trabajo.esforzarse",
        "tendencia": "jugador.responsabilidad",
        "efectos": [
          "jugador.desempeno += 12",
          "jugador.salud -= 3",
          "jugador.felicidad -= 2",
          "jugador.desmarcar('ignoro_mala_racha')"
        ]
      },
      {
        "texto": "opcion.mala_racha_trabajo.pedir_ayuda",
        "condiciones": "jugador.colega != nada",
