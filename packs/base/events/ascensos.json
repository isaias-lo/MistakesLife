        "efectos": [
          "jugador.desempeno += 8",
          "jugador.colega.confianza += 5",
          "jugador.desmarcar('ignoro_mala_racha')"
        ]
      },
      {
        "texto": "opcion.mala_racha_trabajo.seguir",
        "tendencia": "jugador.neuroticismo / 2",
        "efectos": [
          "jugador.desempeno -= 3",
          "jugador.marcar('ignoro_mala_racha')"
        ]
      }
    ]
  },
  {
    "id": "evento.degradacion",
    "condiciones": "jugador.cargo_anterior != nada && jugador.desempeno < 45 && (jugador.tiene('ignoro_mala_racha') || jugador.tiene('en_la_mira'))",
    "probabilidad_anual": 0.5,
    "enfriamiento_semanas": 52,
    "opciones": [
      {
        "texto": "opcion.degradacion.aceptar",
        "tendencia": "50 + jugador.responsabilidad / 3",
        "efectos": [
          "jugador.bajar_cargo()",
          "jugador.desempeno += 15",
          "jugador.felicidad -= 8",
          "diario('diario.degradacion')",
          "jugador.desmarcar('ignoro_mala_racha')",
          "jugador.desmarcar('en_la_mira')"
        ]
      },
      {
        "texto": "opcion.degradacion.renunciar",
        "tendencia": "10 + jugador.neuroticismo / 2",
        "efectos": [
          "jugador.desmarcar('trabajando')",
          "jugador.dejar_trabajo()",
          "jugador.marcar('buscando_trabajo')",
          "jugador.felicidad -= 6",
          "jugador.desmarcar('ignoro_mala_racha')",
          "jugador.desmarcar('en_la_mira')"
        ]
      }
    ]
  },
  {
    "id": "evento.despido_por_desempeno",
    "condiciones": "jugador.area != nada && jugador.cargo_anterior == nada && jugador.desempeno < 45 && jugador.tiene('ignoro_mala_racha')",
    "probabilidad_anual": 0.5,
    "efectos": [
      "jugador.desmarcar('trabajando')",
      "jugador.dejar_trabajo()",
      "jugador.marcar('buscando_trabajo')",
      "jugador.felicidad -= 8",
      "diario('diario.despido_por_desempeno')",
      "jugador.desmarcar('ignoro_mala_racha')"
    ]
  },
  {
    "id": "evento.plazo_imposible",
    "condiciones": "jugador.area != nada",
    "probabilidad_anual": 0.25,
    "enfriamiento_semanas": 52,
    "opciones": [
      {
        "texto": "opcion.plazo_imposible.trasnochar",
        "tendencia": "jugador.responsabilidad / 2 + 20",
        "efectos": [
          "jugador.desempeno += 6",
          "jugador.salud -= 4"
        ]
      },
      {
        "texto": "opcion.plazo_imposible.negociar",
        "tendencia": "jugador.extraversion / 2 + jugador.responsabilidad / 4",
        "efectos": [
          "jugador.desempeno += 2",
          "jugador.felicidad += 1"
        ]
      },
      {
        "texto": "opcion.plazo_imposible.prometer",
        "tendencia": "(100 - jugador.responsabilidad) / 3",
        "efectos": [
          "jugador.desempeno -= 8"
        ]
      }
    ]
  },
  {
    "id": "evento.credito_robado",
    "condiciones": "jugador.area != nada && jugador.desempeno >= 55",
