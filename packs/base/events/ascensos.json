    "condiciones": "jugador.en_la_cima",
    "peso": 100,
    "dia_clave": true,
    "unico": true,
    "efectos": [
      "jugador.felicidad += 10",
      "jugador.marcar('llego_a_la_cima')",
      "diario('diario.cima_carrera')"
    ]
  }
