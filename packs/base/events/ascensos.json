        "efectos": [
          "jugador.desempeno += 4",
          "jugador.felicidad -= 1",
          "jugador.conocer('rival')"
        ]
      },
      {
        "texto": "opcion.credito_robado.callar",
        "tendencia": "jugador.amabilidad / 2",
        "efectos": [
          "jugador.desempeno -= 3",
          "jugador.felicidad -= 4"
        ]
      }
    ]
  },
  {
    "id": "evento.curso_empresa",
    "condiciones": "jugador.area != nada && jugador.meses_en_cargo >= 6",
    "probabilidad_anual": 0.15,
    "enfriamiento_semanas": 104,
    "opciones": [
      {
        "texto": "opcion.curso_empresa.tomar",
        "tendencia": "jugador.apertura",
        "efectos": [
          "jugador.inteligencia += 2",
          "jugador.desempeno += 5",
          "jugador.salud -= 1"
        ]
      },
      {
        "texto": "opcion.curso_empresa.no",
        "tendencia": "100 - jugador.apertura",
        "efectos": [
          "jugador.felicidad += 1"
        ]
      }
    ]
  },
  {
    "id": "evento.reconocimiento_trabajo",
    "condiciones": "jugador.area != nada && jugador.desempeno >= 75",
