{
  "tema.chile.ingles.m1.relationships": "Relationships",
  "tema.chile.ingles.m1.relationships.texto": "Camila and Diego have been friends since they were six. Last year they had an argument because Diego was spreading rumours about her. They didn't talk for months, but eventually he apologised and they made up.\n\nTo keep a friendship, people need trust, respect and communication.",
  "pregunta.chile.ingles.m1.relationships.1": "¿Desde cuándo son amigos Camila y Diego?",
  "pregunta.chile.ingles.m1.relationships.1.a": "Desde los seis años",
  "pregunta.chile.ingles.m1.relationships.1.b": "Desde el año pasado",
  "pregunta.chile.ingles.m1.relationships.1.c": "Desde hace meses",
  "pregunta.chile.ingles.m1.relationships.1.por_que": "Since they were six.",
  "pregunta.chile.ingles.m1.relationships.2": "¿Por qué pelearon?",
  "pregunta.chile.ingles.m1.relationships.2.a": "Porque Camila se cambió de colegio",
  "pregunta.chile.ingles.m1.relationships.2.b": "Porque Diego esparcía rumores sobre ella",
  "pregunta.chile.ingles.m1.relationships.2.c": "Por un partido de fútbol",
  "pregunta.chile.ingles.m1.relationships.2.por_que": "Spreading rumours.",
  "pregunta.chile.ingles.m1.relationships.3": "¿Qué significa \"made up\" en el texto?",
  "pregunta.chile.ingles.m1.relationships.3.a": "Inventaron algo",
  "pregunta.chile.ingles.m1.relationships.3.b": "Se maquillaron",
  "pregunta.chile.ingles.m1.relationships.3.c": "Se reconciliaron",
  "pregunta.chile.ingles.m1.relationships.3.por_que": "Make up = hacer las paces (en este contexto).",
  "pregunta.chile.ingles.m1.relationships.4": "¿Qué significa \"apologised\"?",
  "pregunta.chile.ingles.m1.relationships.4.a": "Pidió disculpas",
  "pregunta.chile.ingles.m1.relationships.4.b": "Se enojó",
  "pregunta.chile.ingles.m1.relationships.4.c": "Se fue",
  "pregunta.chile.ingles.m1.relationships.4.por_que": "Apologise = disculparse.",
  "pregunta.chile.ingles.m1.relationships.5": "¿Qué significa \"trust\"?",
  "pregunta.chile.ingles.m1.relationships.5.a": "Verdad",
  "pregunta.chile.ingles.m1.relationships.5.b": "Confianza",
  "pregunta.chile.ingles.m1.relationships.5.c": "Fuerza",
  "pregunta.chile.ingles.m1.relationships.5.por_que": "Trust = confiar.",
  "pregunta.chile.ingles.m1.relationships.6": "Completa: \"They ___ friends since 2015.\"",
  "pregunta.chile.ingles.m1.relationships.6.a": "are",
  "pregunta.chile.ingles.m1.relationships.6.b": "were being",
  "pregunta.chile.ingles.m1.relationships.6.c": "have been",
  "pregunta.chile.ingles.m1.relationships.6.por_que": "Present perfect con since.",
  "pregunta.chile.ingles.m1.relationships.7": "¿Qué significa \"eventually\"?",
  "pregunta.chile.ingles.m1.relationships.7.a": "Finalmente, al final",
  "pregunta.chile.ingles.m1.relationships.7.b": "Eventualmente, quizás",
  "pregunta.chile.ingles.m1.relationships.7.c": "Nunca",
  "pregunta.chile.ingles.m1.relationships.7.por_que": "Falso amigo: no significa \"eventualmente\".",
  "pregunta.chile.ingles.m1.relationships.8": "Completa: \"I have known her ___ three years.\"",
  "pregunta.chile.ingles.m1.relationships.8.a": "since",
  "pregunta.chile.ingles.m1.relationships.8.b": "for",
  "pregunta.chile.ingles.m1.relationships.8.c": "during",
  "pregunta.chile.ingles.m1.relationships.8.por_que": "For + período; since + punto de inicio.",
  "pregunta.chile.ingles.m1.relationships.9": "¿Qué significa \"argument\" en el texto?",
  "pregunta.chile.ingles.m1.relationships.9.a": "Argumento de una obra",
  "pregunta.chile.ingles.m1.relationships.9.b": "Acuerdo",
  "pregunta.chile.ingles.m1.relationships.9.c": "Discusión, pelea",
  "pregunta.chile.ingles.m1.relationships.9.por_que": "Had an argument = tuvieron una discusión.",
  "pregunta.chile.ingles.m1.relationships.10": "¿Qué significa \"respect\"?",
  "pregunta.chile.ingles.m1.relationships.10.a": "Respeto",
  "pregunta.chile.ingles.m1.relationships.10.b": "Responsabilidad",
  "pregunta.chile.ingles.m1.relationships.10.c": "Reposo",
  "pregunta.chile.ingles.m1.relationships.10.por_que": "Un valor clave en la amistad.",
  "tema.chile.ingles.m1.health": "Health and wellbeing",
  "tema.chile.ingles.m1.health.texto": "Doctors say teenagers need eight to ten hours of sleep. If you don't sleep enough, you can't concentrate at school. Eating fruit and vegetables and doing exercise three times a week also help.\n\nIf you feel stressed, you should talk to someone you trust. Mental health is as important as physical health.",
  "pregunta.chile.ingles.m1.health.1": "¿Cuántas horas de sueño necesitan los adolescentes?",
  "pregunta.chile.ingles.m1.health.1.a": "Entre ocho y diez",
  "pregunta.chile.ingles.m1.health.1.b": "Entre cinco y seis",
  "pregunta.chile.ingles.m1.health.1.c": "Doce o más",
  "pregunta.chile.ingles.m1.health.1.por_que": "Eight to ten hours.",
  "pregunta.chile.ingles.m1.health.2": "¿Qué pasa si no duermes lo suficiente?",
  "pregunta.chile.ingles.m1.health.2.a": "Creces más",
  "pregunta.chile.ingles.m1.health.2.b": "No te puedes concentrar en el colegio",
  "pregunta.chile.ingles.m1.health.2.c": "Tienes más energía",
  "pregunta.chile.ingles.m1.health.2.por_que": "You can't concentrate.",
  "pregunta.chile.ingles.m1.health.3": "¿Cuántas veces por semana recomienda hacer ejercicio?",
  "pregunta.chile.ingles.m1.health.3.a": "Una",
  "pregunta.chile.ingles.m1.health.3.b": "Siete",
  "pregunta.chile.ingles.m1.health.3.c": "Tres",
  "pregunta.chile.ingles.m1.health.3.por_que": "Three times a week.",
  "pregunta.chile.ingles.m1.health.4": "¿Qué recomienda si te sientes estresado?",
  "pregunta.chile.ingles.m1.health.4.a": "Hablar con alguien de confianza",
  "pregunta.chile.ingles.m1.health.4.b": "Dormir menos",
  "pregunta.chile.ingles.m1.health.4.c": "No contarle a nadie",
  "pregunta.chile.ingles.m1.health.4.por_que": "Talk to someone you trust.",
  "pregunta.chile.ingles.m1.health.5": "¿Qué significa \"Mental health is as important as physical health\"?",
  "pregunta.chile.ingles.m1.health.5.a": "La salud mental es más importante",
  "pregunta.chile.ingles.m1.health.5.b": "La salud mental es tan importante como la física",
  "pregunta.chile.ingles.m1.health.5.c": "La salud física no importa",
  "pregunta.chile.ingles.m1.health.5.por_que": "As... as = tan... como.",
  "pregunta.chile.ingles.m1.health.6": "¿Qué significa \"stressed\"?",
  "pregunta.chile.ingles.m1.health.6.a": "Cansado",
  "pregunta.chile.ingles.m1.health.6.b": "Aburrido",
  "pregunta.chile.ingles.m1.health.6.c": "Estresado",
  "pregunta.chile.ingles.m1.health.6.por_que": "Stress = estrés.",
  "pregunta.chile.ingles.m1.health.7": "Completa: \"If you eat well, you ___ feel better.\"",
  "pregunta.chile.ingles.m1.health.7.a": "will",
  "pregunta.chile.ingles.m1.health.7.b": "would",
  "pregunta.chile.ingles.m1.health.7.c": "are",
  "pregunta.chile.ingles.m1.health.7.por_que": "First conditional: if + presente, will + verbo.",
  "pregunta.chile.ingles.m1.health.8": "¿Qué significa \"you should\"?",
  "pregunta.chile.ingles.m1.health.8.a": "Puedes",
  "pregunta.chile.ingles.m1.health.8.b": "Deberías",
  "pregunta.chile.ingles.m1.health.8.c": "Debes obligatoriamente",
  "pregunta.chile.ingles.m1.health.8.por_que": "Should = consejo.",
  "pregunta.chile.ingles.m1.health.9": "¿Qué significa \"headache\"?",
  "pregunta.chile.ingles.m1.health.9.a": "Dolor de estómago",
  "pregunta.chile.ingles.m1.health.9.b": "Fiebre",
  "pregunta.chile.ingles.m1.health.9.c": "Dolor de cabeza",
  "pregunta.chile.ingles.m1.health.9.por_que": "Stomachache = dolor de estómago.",
  "pregunta.chile.ingles.m1.health.10": "Completa: \"If it rains, we ___ stay at home.\"",
  "pregunta.chile.ingles.m1.health.10.a": "will",
  "pregunta.chile.ingles.m1.health.10.b": "are",
  "pregunta.chile.ingles.m1.health.10.c": "would have",
  "pregunta.chile.ingles.m1.health.10.por_que": "Condición posible en el futuro.",
  "tema.chile.ingles.m1.past_continuous": "Stories from the past",
  "tema.chile.ingles.m1.past_continuous.texto": "It was a cold night. I was walking home when suddenly the lights went out. While I was looking for my phone, I heard a strange noise. It was only a cat!\n\nThe past continuous (was/were + -ing) describes an action in progress; the simple past, a short action that interrupts it.",
  "pregunta.chile.ingles.m1.past_continuous.1": "¿Qué estaba haciendo el narrador cuando se cortó la luz?",
  "pregunta.chile.ingles.m1.past_continuous.1.a": "Caminando a casa",
  "pregunta.chile.ingles.m1.past_continuous.1.b": "Durmiendo",
  "pregunta.chile.ingles.m1.past_continuous.1.c": "Comiendo",
  "pregunta.chile.ingles.m1.past_continuous.1.por_que": "I was walking home.",
  "pregunta.chile.ingles.m1.past_continuous.2": "¿Qué causó el ruido extraño?",
  "pregunta.chile.ingles.m1.past_continuous.2.a": "Un perro",
  "pregunta.chile.ingles.m1.past_continuous.2.b": "Un gato",
  "pregunta.chile.ingles.m1.past_continuous.2.c": "Un ladrón",
  "pregunta.chile.ingles.m1.past_continuous.2.por_que": "It was only a cat!",
  "pregunta.chile.ingles.m1.past_continuous.3": "Completa: \"I ___ TV when you called.\"",
  "pregunta.chile.ingles.m1.past_continuous.3.a": "watched",
  "pregunta.chile.ingles.m1.past_continuous.3.b": "am watching",
  "pregunta.chile.ingles.m1.past_continuous.3.c": "was watching",
  "pregunta.chile.ingles.m1.past_continuous.3.por_que": "Acción en progreso interrumpida.",
  "pregunta.chile.ingles.m1.past_continuous.4": "Completa: \"They ___ playing football.\"",
  "pregunta.chile.ingles.m1.past_continuous.4.a": "were",
  "pregunta.chile.ingles.m1.past_continuous.4.b": "was",
  "pregunta.chile.ingles.m1.past_continuous.4.c": "are being",
  "pregunta.chile.ingles.m1.past_continuous.4.por_que": "They + were.",
  "pregunta.chile.ingles.m1.past_continuous.5": "¿Qué significa \"suddenly\"?",
  "pregunta.chile.ingles.m1.past_continuous.5.a": "Lentamente",
  "pregunta.chile.ingles.m1.past_continuous.5.b": "De repente",
  "pregunta.chile.ingles.m1.past_continuous.5.c": "Siempre",
  "pregunta.chile.ingles.m1.past_continuous.5.por_que": "Marca una interrupción.",
  "pregunta.chile.ingles.m1.past_continuous.6": "¿Qué significa \"while\"?",
  "pregunta.chile.ingles.m1.past_continuous.6.a": "Cuando termine",
  "pregunta.chile.ingles.m1.past_continuous.6.b": "Después",
  "pregunta.chile.ingles.m1.past_continuous.6.c": "Mientras",
  "pregunta.chile.ingles.m1.past_continuous.6.por_que": "While I was looking...",
  "pregunta.chile.ingles.m1.past_continuous.7": "¿Qué tiempo verbal es \"the lights went out\"?",
  "pregunta.chile.ingles.m1.past_continuous.7.a": "Pasado simple",
  "pregunta.chile.ingles.m1.past_continuous.7.b": "Pasado continuo",
  "pregunta.chile.ingles.m1.past_continuous.7.c": "Presente perfecto",
  "pregunta.chile.ingles.m1.past_continuous.7.por_que": "Went = pasado de go.",
  "pregunta.chile.ingles.m1.past_continuous.8": "Completa: \"She was cooking when the phone ___.\"",
  "pregunta.chile.ingles.m1.past_continuous.8.a": "was ringing",
  "pregunta.chile.ingles.m1.past_continuous.8.b": "rang",
  "pregunta.chile.ingles.m1.past_continuous.8.c": "rings",
  "pregunta.chile.ingles.m1.past_continuous.8.por_que": "La acción corta va en pasado simple.",
  "pregunta.chile.ingles.m1.past_continuous.9": "¿Qué significa \"noise\"?",
  "pregunta.chile.ingles.m1.past_continuous.9.a": "Nariz",
  "pregunta.chile.ingles.m1.past_continuous.9.b": "Noche",
  "pregunta.chile.ingles.m1.past_continuous.9.c": "Ruido",
  "pregunta.chile.ingles.m1.past_continuous.9.por_que": "Strange noise = ruido extraño.",
  "pregunta.chile.ingles.m1.past_continuous.10": "¿Cuál es correcto?",
  "pregunta.chile.ingles.m1.past_continuous.10.a": "What were you doing at 8?",
  "pregunta.chile.ingles.m1.past_continuous.10.b": "What was you doing at 8?",
  "pregunta.chile.ingles.m1.past_continuous.10.c": "What did you doing at 8?",
  "pregunta.chile.ingles.m1.past_continuous.10.por_que": "You + were.",
  "tema.chile.ingles.m1.work": "The world of work",
  "tema.chile.ingles.m1.work.texto": "Ignacio works part-time in a café on weekends. He serves customers and cleans tables. He earns money to pay for his studies, but sometimes it's hard to balance work and school.\n\nIn a job interview you can say: \"I'm hard-working and I can work in a team.\"",
  "pregunta.chile.ingles.m1.work.1": "¿Cuándo trabaja Ignacio?",
  "pregunta.chile.ingles.m1.work.1.a": "Los fines de semana",
  "pregunta.chile.ingles.m1.work.1.b": "Todos los días",
  "pregunta.chile.ingles.m1.work.1.c": "En las noches",
  "pregunta.chile.ingles.m1.work.1.por_que": "Part-time on weekends.",
  "pregunta.chile.ingles.m1.work.2": "¿Para qué gana dinero?",
  "pregunta.chile.ingles.m1.work.2.a": "Para viajar",
  "pregunta.chile.ingles.m1.work.2.b": "Para pagar sus estudios",
  "pregunta.chile.ingles.m1.work.2.c": "Para comprar un auto",
  "pregunta.chile.ingles.m1.work.2.por_que": "To pay for his studies.",
  "pregunta.chile.ingles.m1.work.3": "¿Qué significa \"part-time\"?",
  "pregunta.chile.ingles.m1.work.3.a": "Tiempo completo",
  "pregunta.chile.ingles.m1.work.3.b": "Por un rato",
  "pregunta.chile.ingles.m1.work.3.c": "Medio tiempo",
  "pregunta.chile.ingles.m1.work.3.por_que": "Full-time = jornada completa.",
  "pregunta.chile.ingles.m1.work.4": "¿Qué significa \"customers\"?",
  "pregunta.chile.ingles.m1.work.4.a": "Clientes",
  "pregunta.chile.ingles.m1.work.4.b": "Costumbres",
  "pregunta.chile.ingles.m1.work.4.c": "Cocineros",
  "pregunta.chile.ingles.m1.work.4.por_que": "Falso amigo de \"costumbres\".",
  "pregunta.chile.ingles.m1.work.5": "¿Qué significa \"hard-working\"?",
  "pregunta.chile.ingles.m1.work.5.a": "Trabajo duro de piedra",
  "pregunta.chile.ingles.m1.work.5.b": "Trabajador, esforzado",
  "pregunta.chile.ingles.m1.work.5.c": "Flojo",
  "pregunta.chile.ingles.m1.work.5.por_que": "Una cualidad para una entrevista.",
  "pregunta.chile.ingles.m1.work.6": "¿Qué significa \"work in a team\"?",
  "pregunta.chile.ingles.m1.work.6.a": "Trabajar solo",
  "pregunta.chile.ingles.m1.work.6.b": "Trabajar en un estadio",
  "pregunta.chile.ingles.m1.work.6.c": "Trabajar en equipo",
  "pregunta.chile.ingles.m1.work.6.por_que": "Team = equipo.",
  "pregunta.chile.ingles.m1.work.7": "¿Qué es difícil para Ignacio?",
  "pregunta.chile.ingles.m1.work.7.a": "Equilibrar el trabajo y el colegio",
  "pregunta.chile.ingles.m1.work.7.b": "Limpiar mesas",
  "pregunta.chile.ingles.m1.work.7.c": "Hablar con clientes",
  "pregunta.chile.ingles.m1.work.7.por_que": "Balance work and school.",
  "pregunta.chile.ingles.m1.work.8": "¿Qué significa \"earn\"?",
  "pregunta.chile.ingles.m1.work.8.a": "Aprender",
  "pregunta.chile.ingles.m1.work.8.b": "Ganar (dinero)",
  "pregunta.chile.ingles.m1.work.8.c": "Gastar",
  "pregunta.chile.ingles.m1.work.8.por_que": "Earn money.",
  "pregunta.chile.ingles.m1.work.9": "¿Qué es un \"CV\" o \"résumé\"?",
  "pregunta.chile.ingles.m1.work.9.a": "Un contrato",
  "pregunta.chile.ingles.m1.work.9.b": "Un sueldo",
  "pregunta.chile.ingles.m1.work.9.c": "Un currículum",
  "pregunta.chile.ingles.m1.work.9.por_que": "Resume tu experiencia.",
  "pregunta.chile.ingles.m1.work.10": "Completa: \"I am good ___ working with people.\"",
  "pregunta.chile.ingles.m1.work.10.a": "at",
  "pregunta.chile.ingles.m1.work.10.b": "in",
  "pregunta.chile.ingles.m1.work.10.c": "for",
  "pregunta.chile.ingles.m1.work.10.por_que": "Good at + -ing."
}
