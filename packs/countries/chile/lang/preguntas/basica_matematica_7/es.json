{
  "tema.chile.matematica.7.enteros": "Los números enteros",
  "tema.chile.matematica.7.enteros.texto": "Los números enteros incluyen los positivos, el cero y los negativos. Los negativos sirven para temperaturas bajo cero, deudas o profundidades: −5 °C es 5 grados bajo cero.\n\nEn la recta numérica, un número es mayor mientras más a la derecha esté: −2 > −7. Para sumar enteros de distinto signo se restan sus valores y se pone el signo del mayor: −8 + 5 = −3.",
  "pregunta.chile.matematica.7.enteros.1": "¿Cuál es mayor: −2 o −7?",
  "pregunta.chile.matematica.7.enteros.1.a": "−2",
  "pregunta.chile.matematica.7.enteros.1.b": "−7",
  "pregunta.chile.matematica.7.enteros.1.c": "Son iguales",
  "pregunta.chile.matematica.7.enteros.1.por_que": "−2 está más a la derecha en la recta.",
  "pregunta.chile.matematica.7.enteros.2": "¿Cuánto es −8 + 5?",
  "pregunta.chile.matematica.7.enteros.2.a": "3",
  "pregunta.chile.matematica.7.enteros.2.b": "−3",
  "pregunta.chile.matematica.7.enteros.2.c": "−13",
  "pregunta.chile.matematica.7.enteros.2.por_que": "8 − 5 = 3 y el signo es del 8.",
  "pregunta.chile.matematica.7.enteros.3": "¿Cuánto es −4 − 6?",
  "pregunta.chile.matematica.7.enteros.3.a": "−2",
  "pregunta.chile.matematica.7.enteros.3.b": "10",
  "pregunta.chile.matematica.7.enteros.3.c": "−10",
  "pregunta.chile.matematica.7.enteros.3.por_que": "Bajar 6 más desde −4.",
  "pregunta.chile.matematica.7.enteros.4": "Si la temperatura era −3 °C y subió 7 grados, ¿cuánto marca?",
  "pregunta.chile.matematica.7.enteros.4.a": "4 °C",
  "pregunta.chile.matematica.7.enteros.4.b": "−10 °C",
  "pregunta.chile.matematica.7.enteros.4.c": "10 °C",
  "pregunta.chile.matematica.7.enteros.4.por_que": "−3 + 7 = 4.",
  "pregunta.chile.matematica.7.enteros.5": "¿Cuánto es 5 − 9?",
  "pregunta.chile.matematica.7.enteros.5.a": "4",
  "pregunta.chile.matematica.7.enteros.5.b": "−4",
  "pregunta.chile.matematica.7.enteros.5.c": "14",
  "pregunta.chile.matematica.7.enteros.5.por_que": "Se pasa del cero hacia abajo.",
  "pregunta.chile.matematica.7.enteros.6": "¿Cuál es el opuesto de 6?",
  "pregunta.chile.matematica.7.enteros.6.a": "6",
  "pregunta.chile.matematica.7.enteros.6.b": "1/6",
  "pregunta.chile.matematica.7.enteros.6.c": "−6",
  "pregunta.chile.matematica.7.enteros.6.por_que": "Está a la misma distancia del cero, al otro lado.",
  "pregunta.chile.matematica.7.enteros.7": "¿Cuánto es −3 − (−5)?",
  "pregunta.chile.matematica.7.enteros.7.a": "2",
  "pregunta.chile.matematica.7.enteros.7.b": "−8",
  "pregunta.chile.matematica.7.enteros.7.c": "−2",
  "pregunta.chile.matematica.7.enteros.7.por_que": "Restar un negativo es sumar: −3 + 5.",
  "pregunta.chile.matematica.7.enteros.8": "Ordena de menor a mayor: 0, −4, 3",
  "pregunta.chile.matematica.7.enteros.8.a": "0, −4, 3",
  "pregunta.chile.matematica.7.enteros.8.b": "−4, 0, 3",
  "pregunta.chile.matematica.7.enteros.8.c": "3, 0, −4",
  "pregunta.chile.matematica.7.enteros.8.por_que": "Los negativos van primero.",
  "pregunta.chile.matematica.7.enteros.9": "Un buzo está a −20 m y sube 8 m. ¿A qué profundidad queda?",
  "pregunta.chile.matematica.7.enteros.9.a": "−28 m",
  "pregunta.chile.matematica.7.enteros.9.b": "12 m",
  "pregunta.chile.matematica.7.enteros.9.c": "−12 m",
  "pregunta.chile.matematica.7.enteros.9.por_que": "−20 + 8 = −12.",
  "pregunta.chile.matematica.7.enteros.10": "Tienes $3 000 y debes $5 000. ¿Cuál es tu saldo?",
  "pregunta.chile.matematica.7.enteros.10.a": "−$2 000",
  "pregunta.chile.matematica.7.enteros.10.b": "$2 000",
  "pregunta.chile.matematica.7.enteros.10.c": "$8 000",
  "pregunta.chile.matematica.7.enteros.10.por_que": "3 000 − 5 000.",
  "tema.chile.matematica.7.porcentajes_ecuaciones": "Porcentajes y ecuaciones",
  "tema.chile.matematica.7.porcentajes_ecuaciones.texto": "Para calcular un porcentaje se multiplica por el porcentaje y se divide por 100: el 15 % de 2 000 es 2 000 × 15 : 100 = 300. Un aumento del 10 % equivale a multiplicar por 1,1.\n\nPara resolver ecuaciones se hace lo mismo a ambos lados: en 4x − 3 = 17 se suma 3 (4x = 20) y se divide por 4 (x = 5). Una inecuación como x + 2 > 5 tiene muchas soluciones: todos los x mayores que 3.",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.1": "¿Cuánto es el 15 % de 2 000?",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.1.a": "300",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.1.b": "150",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.1.c": "1 500",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.1.por_que": "2 000 × 15 : 100.",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.2": "Un precio de $5 000 sube un 10 %. ¿Cuál es el precio nuevo?",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.2.a": "$5 010",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.2.b": "$5 500",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.2.c": "$6 000",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.2.por_que": "5 000 × 1,1.",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.3": "Resuelve 4x − 3 = 17",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.3.a": "x = 3,5",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.3.b": "x = 20",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.3.c": "x = 5",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.3.por_que": "4x = 20.",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.4": "Resuelve 2x + 7 = 3",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.4.a": "x = −2",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.4.b": "x = 5",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.4.c": "x = 2",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.4.por_que": "2x = −4.",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.5": "¿Qué valores cumplen x + 2 > 5?",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.5.a": "Solo el 3",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.5.b": "Todos los mayores que 3",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.5.c": "Todos los menores que 3",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.5.por_que": "x > 3.",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.6": "Una polera de $12 000 tiene 25 % de descuento. ¿Cuánto pagas?",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.6.a": "$3 000",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.6.b": "$11 750",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.6.c": "$9 000",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.6.por_que": "Se descuenta 3 000.",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.7": "Si 30 % de un número es 60, ¿cuál es el número?",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.7.a": "200",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.7.b": "18",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.7.c": "90",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.7.por_que": "60 : 0,3 = 200.",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.8": "Resuelve x/3 = 9",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.8.a": "x = 3",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.8.b": "x = 27",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.8.c": "x = 12",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.8.por_que": "9 × 3 = 27.",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.9": "El triple de un número menos 4 es 11. ¿Cuál es el número?",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.9.a": "7",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.9.b": "3",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.9.c": "5",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.9.por_que": "3x − 4 = 11, 3x = 15.",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.10": "¿Qué porcentaje es 9 de 36?",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.10.a": "25 %",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.10.b": "9 %",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.10.c": "4 %",
  "pregunta.chile.matematica.7.porcentajes_ecuaciones.10.por_que": "9/36 = 1/4.",
  "tema.chile.matematica.7.circulo": "El círculo y los triángulos",
  "tema.chile.matematica.7.circulo.texto": "El perímetro de una circunferencia es 2 × π × radio, y el área del círculo es π × radio². π vale aproximadamente 3,14. El diámetro es el doble del radio.\n\nEn un triángulo, la suma de dos lados siempre es mayor que el tercero (desigualdad triangular). Las alturas, bisectrices y transversales son rectas notables del triángulo.",
  "pregunta.chile.matematica.7.circulo.1": "¿Cuánto vale aproximadamente π?",
  "pregunta.chile.matematica.7.circulo.1.a": "3,14",
  "pregunta.chile.matematica.7.circulo.1.b": "2,5",
  "pregunta.chile.matematica.7.circulo.1.c": "10",
  "pregunta.chile.matematica.7.circulo.1.por_que": "Relación entre el perímetro y el diámetro.",
  "pregunta.chile.matematica.7.circulo.2": "Si el radio de un círculo es 5 cm, ¿cuánto mide el diámetro?",
  "pregunta.chile.matematica.7.circulo.2.a": "2,5 cm",
  "pregunta.chile.matematica.7.circulo.2.b": "10 cm",
  "pregunta.chile.matematica.7.circulo.2.c": "25 cm",
  "pregunta.chile.matematica.7.circulo.2.por_que": "El diámetro es el doble.",
  "pregunta.chile.matematica.7.circulo.3": "¿Cuál es el perímetro de una circunferencia de radio 1 m (π ≈ 3,14)?",
  "pregunta.chile.matematica.7.circulo.3.a": "3,14 m",
  "pregunta.chile.matematica.7.circulo.3.b": "1 m",
  "pregunta.chile.matematica.7.circulo.3.c": "6,28 m",
  "pregunta.chile.matematica.7.circulo.3.por_que": "2 × 3,14 × 1.",
  "pregunta.chile.matematica.7.circulo.4": "¿Cuál es el área de un círculo de radio 10 cm (π ≈ 3,14)?",
  "pregunta.chile.matematica.7.circulo.4.a": "314 cm²",
  "pregunta.chile.matematica.7.circulo.4.b": "62,8 cm²",
  "pregunta.chile.matematica.7.circulo.4.c": "31,4 cm²",
  "pregunta.chile.matematica.7.circulo.4.por_que": "3,14 × 10 × 10.",
  "pregunta.chile.matematica.7.circulo.5": "¿Se puede formar un triángulo con lados 2, 3 y 10?",
  "pregunta.chile.matematica.7.circulo.5.a": "Sí, siempre",
  "pregunta.chile.matematica.7.circulo.5.b": "No, porque 2 + 3 es menor que 10",
  "pregunta.chile.matematica.7.circulo.5.c": "Sí, pero es rectángulo",
  "pregunta.chile.matematica.7.circulo.5.por_que": "Desigualdad triangular.",
  "pregunta.chile.matematica.7.circulo.6": "¿Qué es la altura de un triángulo?",
  "pregunta.chile.matematica.7.circulo.6.a": "El lado más largo",
  "pregunta.chile.matematica.7.circulo.6.b": "Una diagonal",
  "pregunta.chile.matematica.7.circulo.6.c": "El segmento perpendicular desde un vértice al lado opuesto",
  "pregunta.chile.matematica.7.circulo.6.por_que": "Se usa para calcular el área.",
  "pregunta.chile.matematica.7.circulo.7": "¿Qué hace una bisectriz?",
  "pregunta.chile.matematica.7.circulo.7.a": "Divide un ángulo en dos iguales",
  "pregunta.chile.matematica.7.circulo.7.b": "Divide un lado en dos",
  "pregunta.chile.matematica.7.circulo.7.c": "Une dos vértices",
  "pregunta.chile.matematica.7.circulo.7.por_que": "Bi = dos.",
  "pregunta.chile.matematica.7.circulo.8": "Si un círculo tiene diámetro 8 cm, ¿cuál es su radio?",
  "pregunta.chile.matematica.7.circulo.8.a": "16 cm",
  "pregunta.chile.matematica.7.circulo.8.b": "4 cm",
  "pregunta.chile.matematica.7.circulo.8.c": "8 cm",
  "pregunta.chile.matematica.7.circulo.8.por_que": "La mitad del diámetro.",
  "pregunta.chile.matematica.7.circulo.9": "¿Qué fórmula da el área de un círculo?",
  "pregunta.chile.matematica.7.circulo.9.a": "2 × π × r",
  "pregunta.chile.matematica.7.circulo.9.b": "b × h",
  "pregunta.chile.matematica.7.circulo.9.c": "π × r²",
  "pregunta.chile.matematica.7.circulo.9.por_que": "La otra es el perímetro.",
  "pregunta.chile.matematica.7.circulo.10": "¿Cuál es el área de un trapecio de bases 6 y 4, y altura 5?",
  "pregunta.chile.matematica.7.circulo.10.a": "25",
  "pregunta.chile.matematica.7.circulo.10.b": "50",
  "pregunta.chile.matematica.7.circulo.10.c": "30",
  "pregunta.chile.matematica.7.circulo.10.por_que": "(6 + 4) × 5 : 2.",
  "tema.chile.matematica.7.estadistica": "Estadística y probabilidad",
  "tema.chile.matematica.7.estadistica.texto": "Para resumir datos usamos la media (promedio), la mediana (el dato del medio al ordenarlos) y la moda (el dato que más se repite). Con 2, 3, 3, 5 y 7: media 4, mediana 3 y moda 3.\n\nLa probabilidad de un suceso es casos favorables dividido por casos posibles. La probabilidad de sacar un 4 al lanzar un dado es 1/6.",
  "pregunta.chile.matematica.7.estadistica.1": "¿Cuál es la media de 2, 3, 3, 5 y 7?",
  "pregunta.chile.matematica.7.estadistica.1.a": "4",
  "pregunta.chile.matematica.7.estadistica.1.b": "3",
  "pregunta.chile.matematica.7.estadistica.1.c": "5",
  "pregunta.chile.matematica.7.estadistica.1.por_que": "20 : 5 = 4.",
  "pregunta.chile.matematica.7.estadistica.2": "¿Cuál es la mediana de 2, 3, 3, 5 y 7?",
  "pregunta.chile.matematica.7.estadistica.2.a": "4",
  "pregunta.chile.matematica.7.estadistica.2.b": "3",
  "pregunta.chile.matematica.7.estadistica.2.c": "5",
  "pregunta.chile.matematica.7.estadistica.2.por_que": "El dato del medio al ordenar.",
  "pregunta.chile.matematica.7.estadistica.3": "¿Cuál es la moda de 1, 4, 4, 6, 8?",
  "pregunta.chile.matematica.7.estadistica.3.a": "1",
  "pregunta.chile.matematica.7.estadistica.3.b": "6",
  "pregunta.chile.matematica.7.estadistica.3.c": "4",
  "pregunta.chile.matematica.7.estadistica.3.por_que": "Es el que más se repite.",
  "pregunta.chile.matematica.7.estadistica.4": "¿Cuál es la probabilidad de sacar un 4 con un dado?",
  "pregunta.chile.matematica.7.estadistica.4.a": "1/6",
  "pregunta.chile.matematica.7.estadistica.4.b": "1/4",
  "pregunta.chile.matematica.7.estadistica.4.c": "4/6",
  "pregunta.chile.matematica.7.estadistica.4.por_que": "1 caso favorable de 6.",
  "pregunta.chile.matematica.7.estadistica.5": "¿Cuál es la probabilidad de sacar cara con una moneda?",
  "pregunta.chile.matematica.7.estadistica.5.a": "1/4",
  "pregunta.chile.matematica.7.estadistica.5.b": "1/2",
  "pregunta.chile.matematica.7.estadistica.5.c": "1",
  "pregunta.chile.matematica.7.estadistica.5.por_que": "Hay dos resultados posibles.",
  "pregunta.chile.matematica.7.estadistica.6": "En una bolsa hay 3 bolitas rojas y 7 azules. ¿Probabilidad de sacar roja?",
  "pregunta.chile.matematica.7.estadistica.6.a": "3/7",
  "pregunta.chile.matematica.7.estadistica.6.b": "7/10",
  "pregunta.chile.matematica.7.estadistica.6.c": "3/10",
  "pregunta.chile.matematica.7.estadistica.6.por_que": "3 de 10 bolitas.",
  "pregunta.chile.matematica.7.estadistica.7": "¿Qué probabilidad tiene un suceso imposible?",
  "pregunta.chile.matematica.7.estadistica.7.a": "0",
  "pregunta.chile.matematica.7.estadistica.7.b": "1",
  "pregunta.chile.matematica.7.estadistica.7.c": "1/2",
  "pregunta.chile.matematica.7.estadistica.7.por_que": "Nunca ocurre.",
  "pregunta.chile.matematica.7.estadistica.8": "¿Qué probabilidad tiene un suceso seguro?",
  "pregunta.chile.matematica.7.estadistica.8.a": "0",
  "pregunta.chile.matematica.7.estadistica.8.b": "1",
  "pregunta.chile.matematica.7.estadistica.8.c": "1/2",
  "pregunta.chile.matematica.7.estadistica.8.por_que": "Siempre ocurre.",
  "pregunta.chile.matematica.7.estadistica.9": "¿Cuál es la mediana de 4, 8, 10 y 12?",
  "pregunta.chile.matematica.7.estadistica.9.a": "8",
  "pregunta.chile.matematica.7.estadistica.9.b": "10",
  "pregunta.chile.matematica.7.estadistica.9.c": "9",
  "pregunta.chile.matematica.7.estadistica.9.por_que": "Con cantidad par, se promedian los dos del medio: (8 + 10) : 2.",
  "pregunta.chile.matematica.7.estadistica.10": "Las notas de Ana son 5,0; 6,0 y 7,0. ¿Cuál es su promedio?",
  "pregunta.chile.matematica.7.estadistica.10.a": "6,0",
  "pregunta.chile.matematica.7.estadistica.10.b": "5,5",
  "pregunta.chile.matematica.7.estadistica.10.c": "18,0",
  "pregunta.chile.matematica.7.estadistica.10.por_que": "(5 + 6 + 7) : 3."
}
