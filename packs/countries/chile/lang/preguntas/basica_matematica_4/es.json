  "pregunta.chile.matematica.4.hasta_10000.7.b": "5 999",
  "pregunta.chile.matematica.4.hasta_10000.7.c": "6 000",
  "pregunta.chile.matematica.4.hasta_10000.7.por_que": "6 001 es uno más que 6 000.",
  "pregunta.chile.matematica.4.hasta_10000.8": "¿Cuánto vale el 3 en 3 456?",
  "pregunta.chile.matematica.4.hasta_10000.8.a": "300",
