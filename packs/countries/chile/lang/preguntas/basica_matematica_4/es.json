  "pregunta.chile.matematica.4.hasta_10000.9.c": "6 000",
  "pregunta.chile.matematica.4.hasta_10000.9.por_que": "1 500 × 4 = 6 000.",
  "pregunta.chile.matematica.4.hasta_10000.10": "¿Qué número va justo antes de 10 000?",
