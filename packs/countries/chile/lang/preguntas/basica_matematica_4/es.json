{
  "tema.chile.matematica.4.hasta_10000": "Números hasta el 10 000",
  "tema.chile.matematica.4.hasta_10000.texto": "Las unidades de mil son grupos de mil. En 4 625 hay 4 unidades de mil, 6 centenas, 2 decenas y 5 unidades; se lee \"cuatro mil seiscientos veinticinco\".\n\nPara multiplicar 23 × 4 puedes separar: 20 × 4 = 80 y 3 × 4 = 12; 80 + 12 = 92. Para sumar y restar números grandes se ordenan por columnas, unidades bajo unidades.",
  "pregunta.chile.matematica.4.hasta_10000.1": "¿Cuántas unidades de mil hay en 4 625?",
  "pregunta.chile.matematica.4.hasta_10000.1.a": "4",
  "pregunta.chile.matematica.4.hasta_10000.1.b": "6",
  "pregunta.chile.matematica.4.hasta_10000.1.c": "46",
  "pregunta.chile.matematica.4.hasta_10000.1.por_que": "4 625 = 4 000 + 600 + 20 + 5.",
  "pregunta.chile.matematica.4.hasta_10000.2": "¿Cómo se lee 7 080?",
  "pregunta.chile.matematica.4.hasta_10000.2.a": "Setecientos ocho",
  "pregunta.chile.matematica.4.hasta_10000.2.b": "Siete mil ochenta",
  "pregunta.chile.matematica.4.hasta_10000.2.c": "Siete mil ocho",
  "pregunta.chile.matematica.4.hasta_10000.2.por_que": "7 mil, 0 centenas, 8 decenas.",
  "pregunta.chile.matematica.4.hasta_10000.3": "¿Cuánto es 23 × 4?",
  "pregunta.chile.matematica.4.hasta_10000.3.a": "82",
  "pregunta.chile.matematica.4.hasta_10000.3.b": "812",
  "pregunta.chile.matematica.4.hasta_10000.3.c": "92",
  "pregunta.chile.matematica.4.hasta_10000.3.por_que": "20 × 4 + 3 × 4 = 80 + 12.",
  "pregunta.chile.matematica.4.hasta_10000.4": "¿Cuánto es 1 250 + 2 340?",
  "pregunta.chile.matematica.4.hasta_10000.4.a": "3 590",
  "pregunta.chile.matematica.4.hasta_10000.4.b": "3 490",
  "pregunta.chile.matematica.4.hasta_10000.4.c": "4 590",
  "pregunta.chile.matematica.4.hasta_10000.4.por_que": "Se suma por columnas.",
  "pregunta.chile.matematica.4.hasta_10000.5": "¿Cuánto es 5 000 − 1 200?",
  "pregunta.chile.matematica.4.hasta_10000.5.a": "4 200",
  "pregunta.chile.matematica.4.hasta_10000.5.b": "3 800",
  "pregunta.chile.matematica.4.hasta_10000.5.c": "3 200",
  "pregunta.chile.matematica.4.hasta_10000.5.por_que": "5 000 − 1 000 = 4 000 y − 200 = 3 800.",
  "pregunta.chile.matematica.4.hasta_10000.6": "¿Cuánto es 125 × 3?",
  "pregunta.chile.matematica.4.hasta_10000.6.a": "365",
  "pregunta.chile.matematica.4.hasta_10000.6.b": "128",
  "pregunta.chile.matematica.4.hasta_10000.6.c": "375",
  "pregunta.chile.matematica.4.hasta_10000.6.por_que": "100 × 3 + 25 × 3 = 300 + 75.",
  "pregunta.chile.matematica.4.hasta_10000.7": "¿Cuál es mayor?",
