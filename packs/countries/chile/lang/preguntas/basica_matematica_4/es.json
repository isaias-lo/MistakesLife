  "pregunta.chile.matematica.4.division.9.por_que": "Divisor × cociente + resto = dividendo.",
  "pregunta.chile.matematica.4.division.10": "¿Cuántas semanas completas hay en 30 días?",
  "pregunta.chile.matematica.4.division.10.a": "4, y sobran 2 días",
  "pregunta.chile.matematica.4.division.10.b": "5",
  "pregunta.chile.matematica.4.division.10.c": "3, y sobran 9 días",
  "pregunta.chile.matematica.4.division.10.por_que": "7 × 4 = 28.",
  "tema.chile.matematica.4.fracciones_decimales": "Fracciones y decimales",
  "tema.chile.matematica.4.fracciones_decimales.texto": "Dos fracciones son equivalentes si representan la misma cantidad: 1/2 = 2/4 = 4/8. Si tienen el mismo denominador, es mayor la de numerador mayor.\n\nLos decimales escriben partes de un entero: 0,1 es un décimo (1/10) y 0,01 es un centésimo (1/100). También se usan al medir: 1,5 metros es un metro y medio.",
  "pregunta.chile.matematica.4.fracciones_decimales.1": "¿Qué fracción es equivalente a 1/2?",
  "pregunta.chile.matematica.4.fracciones_decimales.1.a": "4/8",
  "pregunta.chile.matematica.4.fracciones_decimales.1.b": "1/4",
  "pregunta.chile.matematica.4.fracciones_decimales.1.c": "2/3",
  "pregunta.chile.matematica.4.fracciones_decimales.1.por_que": "Se multiplica arriba y abajo por 4.",
  "pregunta.chile.matematica.4.fracciones_decimales.2": "¿Qué es mayor: 3/8 o 5/8?",
  "pregunta.chile.matematica.4.fracciones_decimales.2.a": "3/8",
  "pregunta.chile.matematica.4.fracciones_decimales.2.b": "5/8",
  "pregunta.chile.matematica.4.fracciones_decimales.2.c": "Son iguales",
  "pregunta.chile.matematica.4.fracciones_decimales.2.por_que": "Mismo denominador: gana el numerador mayor.",
  "pregunta.chile.matematica.4.fracciones_decimales.3": "¿Cómo se escribe un décimo en decimal?",
  "pregunta.chile.matematica.4.fracciones_decimales.3.a": "0,01",
  "pregunta.chile.matematica.4.fracciones_decimales.3.b": "1,0",
  "pregunta.chile.matematica.4.fracciones_decimales.3.c": "0,1",
  "pregunta.chile.matematica.4.fracciones_decimales.3.por_que": "1/10 = 0,1.",
  "pregunta.chile.matematica.4.fracciones_decimales.4": "¿Cómo se escribe un centésimo en decimal?",
  "pregunta.chile.matematica.4.fracciones_decimales.4.a": "0,01",
  "pregunta.chile.matematica.4.fracciones_decimales.4.b": "0,1",
  "pregunta.chile.matematica.4.fracciones_decimales.4.c": "100",
  "pregunta.chile.matematica.4.fracciones_decimales.4.por_que": "1/100 = 0,01.",
  "pregunta.chile.matematica.4.fracciones_decimales.5": "¿Qué fracción es 0,3?",
  "pregunta.chile.matematica.4.fracciones_decimales.5.a": "3/100",
  "pregunta.chile.matematica.4.fracciones_decimales.5.b": "3/10",
  "pregunta.chile.matematica.4.fracciones_decimales.5.c": "1/3",
  "pregunta.chile.matematica.4.fracciones_decimales.5.por_que": "Tres décimos.",
  "pregunta.chile.matematica.4.fracciones_decimales.6": "¿Cuánto es 1/4 + 2/4?",
  "pregunta.chile.matematica.4.fracciones_decimales.6.a": "3/8",
  "pregunta.chile.matematica.4.fracciones_decimales.6.b": "1/2",
  "pregunta.chile.matematica.4.fracciones_decimales.6.c": "3/4",
  "pregunta.chile.matematica.4.fracciones_decimales.6.por_que": "Mismo denominador: 1 + 2 = 3.",
  "pregunta.chile.matematica.4.fracciones_decimales.7": "¿Cuánto es 1/3 de 12?",
  "pregunta.chile.matematica.4.fracciones_decimales.7.a": "4",
  "pregunta.chile.matematica.4.fracciones_decimales.7.b": "3",
  "pregunta.chile.matematica.4.fracciones_decimales.7.c": "9",
  "pregunta.chile.matematica.4.fracciones_decimales.7.por_que": "12 : 3 = 4.",
  "pregunta.chile.matematica.4.fracciones_decimales.8": "¿Qué es mayor: 0,5 o 0,45?",
  "pregunta.chile.matematica.4.fracciones_decimales.8.a": "0,45",
  "pregunta.chile.matematica.4.fracciones_decimales.8.b": "0,5",
  "pregunta.chile.matematica.4.fracciones_decimales.8.c": "Son iguales",
  "pregunta.chile.matematica.4.fracciones_decimales.8.por_que": "0,5 = 0,50, que es más que 0,45.",
  "pregunta.chile.matematica.4.fracciones_decimales.9": "¿Cuántos décimos forman un entero?",
  "pregunta.chile.matematica.4.fracciones_decimales.9.a": "100",
  "pregunta.chile.matematica.4.fracciones_decimales.9.b": "1",
  "pregunta.chile.matematica.4.fracciones_decimales.9.c": "10",
  "pregunta.chile.matematica.4.fracciones_decimales.9.por_que": "10/10 = 1.",
  "pregunta.chile.matematica.4.fracciones_decimales.10": "¿Qué fracción es equivalente a 2/3?",
  "pregunta.chile.matematica.4.fracciones_decimales.10.a": "4/6",
  "pregunta.chile.matematica.4.fracciones_decimales.10.b": "2/6",
  "pregunta.chile.matematica.4.fracciones_decimales.10.c": "3/2",
  "pregunta.chile.matematica.4.fracciones_decimales.10.por_que": "Multiplicando por 2 arriba y abajo.",
  "tema.chile.matematica.4.geometria": "Ángulos, simetría y área",
  "tema.chile.matematica.4.geometria.texto": "Un ángulo se forma donde se juntan dos líneas. El ángulo recto mide 90°, como la esquina de una hoja; si es menor, es agudo, y si es mayor, obtuso.\n\nUna figura es simétrica si al doblarla por una línea (el eje de simetría) las dos mitades calzan. El área se puede contar en cuadrados: un rectángulo de 3 × 5 cuadraditos tiene 15 cuadraditos de área.",
  "pregunta.chile.matematica.4.geometria.1": "¿Cuánto mide un ángulo recto?",
  "pregunta.chile.matematica.4.geometria.1.a": "90°",
  "pregunta.chile.matematica.4.geometria.1.b": "180°",
  "pregunta.chile.matematica.4.geometria.1.c": "45°",
  "pregunta.chile.matematica.4.geometria.1.por_que": "Como la esquina de una hoja.",
  "pregunta.chile.matematica.4.geometria.2": "¿Cómo se llama un ángulo menor que 90°?",
  "pregunta.chile.matematica.4.geometria.2.a": "Obtuso",
  "pregunta.chile.matematica.4.geometria.2.b": "Agudo",
  "pregunta.chile.matematica.4.geometria.2.c": "Recto",
  "pregunta.chile.matematica.4.geometria.2.por_que": "Es más cerrado.",
  "pregunta.chile.matematica.4.geometria.3": "¿Cómo se llama un ángulo mayor que 90° y menor que 180°?",
  "pregunta.chile.matematica.4.geometria.3.a": "Agudo",
  "pregunta.chile.matematica.4.geometria.3.b": "Recto",
  "pregunta.chile.matematica.4.geometria.3.c": "Obtuso",
  "pregunta.chile.matematica.4.geometria.3.por_que": "Es más abierto.",
  "pregunta.chile.matematica.4.geometria.4": "¿Qué es un eje de simetría?",
  "pregunta.chile.matematica.4.geometria.4.a": "Una línea que divide la figura en dos mitades iguales",
  "pregunta.chile.matematica.4.geometria.4.b": "Una esquina",
  "pregunta.chile.matematica.4.geometria.4.c": "Un ángulo recto",
  "pregunta.chile.matematica.4.geometria.4.por_que": "Al doblar, las mitades calzan.",
  "pregunta.chile.matematica.4.geometria.5": "¿Cuántos ejes de simetría tiene un cuadrado?",
  "pregunta.chile.matematica.4.geometria.5.a": "2",
  "pregunta.chile.matematica.4.geometria.5.b": "4",
  "pregunta.chile.matematica.4.geometria.5.c": "1",
  "pregunta.chile.matematica.4.geometria.5.por_que": "Dos diagonales y dos por el medio.",
  "pregunta.chile.matematica.4.geometria.6": "¿Qué letra es simétrica con un eje vertical?",
  "pregunta.chile.matematica.4.geometria.6.a": "F",
  "pregunta.chile.matematica.4.geometria.6.b": "G",
  "pregunta.chile.matematica.4.geometria.6.c": "A",
  "pregunta.chile.matematica.4.geometria.6.por_que": "Si la doblas por el medio, calza.",
  "pregunta.chile.matematica.4.geometria.7": "Un rectángulo de 3 por 5 cuadraditos, ¿cuántos cuadraditos tiene?",
  "pregunta.chile.matematica.4.geometria.7.a": "15",
  "pregunta.chile.matematica.4.geometria.7.b": "8",
  "pregunta.chile.matematica.4.geometria.7.c": "16",
  "pregunta.chile.matematica.4.geometria.7.por_que": "3 × 5 = 15.",
  "pregunta.chile.matematica.4.geometria.8": "¿Cuántos ángulos rectos tiene un rectángulo?",
  "pregunta.chile.matematica.4.geometria.8.a": "2",
  "pregunta.chile.matematica.4.geometria.8.b": "4",
  "pregunta.chile.matematica.4.geometria.8.c": "0",
  "pregunta.chile.matematica.4.geometria.8.por_que": "Sus cuatro esquinas son rectas.",
  "pregunta.chile.matematica.4.geometria.9": "Un cubo de 2 × 2 × 2 cubitos, ¿cuántos cubitos tiene?",
  "pregunta.chile.matematica.4.geometria.9.a": "6",
  "pregunta.chile.matematica.4.geometria.9.b": "4",
  "pregunta.chile.matematica.4.geometria.9.c": "8",
  "pregunta.chile.matematica.4.geometria.9.por_que": "2 × 2 × 2 = 8: es su volumen.",
  "pregunta.chile.matematica.4.geometria.10": "¿Qué mide el área?",
  "pregunta.chile.matematica.4.geometria.10.a": "Lo que ocupa una figura por dentro",
  "pregunta.chile.matematica.4.geometria.10.b": "Lo que mide su borde",
  "pregunta.chile.matematica.4.geometria.10.c": "Su peso",
  "pregunta.chile.matematica.4.geometria.10.por_que": "El borde es el perímetro."
}
