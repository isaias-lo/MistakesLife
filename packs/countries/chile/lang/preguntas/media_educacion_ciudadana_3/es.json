  "pregunta.chile.educacion_ciudadana.m3.democracia.4.por_que": "Con voto secreto.",
  "pregunta.chile.educacion_ciudadana.m3.democracia.5": "¿Qué es la democracia representativa?",
  "pregunta.chile.educacion_ciudadana.m3.democracia.5.a": "Todos votan cada ley",
  "pregunta.chile.educacion_ciudadana.m3.democracia.5.b": "El pueblo elige representantes que deciden en su nombre",
