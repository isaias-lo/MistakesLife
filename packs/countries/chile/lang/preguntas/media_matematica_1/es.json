  "pregunta.chile.matematica.m1.racionales.3.por_que": "Se elevan numerador y denominador.",
  "pregunta.chile.matematica.m1.racionales.4": "¿Cuánto es 5³ · 5²?",
  "pregunta.chile.matematica.m1.racionales.4.a": "5⁵",
  "pregunta.chile.matematica.m1.racionales.4.b": "5⁶",
