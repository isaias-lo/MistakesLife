  "pregunta.chile.matematica.m1.racionales.2.por_que": "a⁻ⁿ = 1/aⁿ.",
  "pregunta.chile.matematica.m1.racionales.3": "¿Cuánto es (2/3)²?",
  "pregunta.chile.matematica.m1.racionales.3.a": "4/6",
  "pregunta.chile.matematica.m1.racionales.3.b": "2/9",
