  "pregunta.chile.lengua_literatura.m2.tragedia.8.por_que": "Edipo reconoce quién es.",
  "pregunta.chile.lengua_literatura.m2.tragedia.9": "¿Qué es el destino en la tragedia griega?",
  "pregunta.chile.lengua_literatura.m2.tragedia.9.a": "Un viaje",
