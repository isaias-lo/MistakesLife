  "pregunta.chile.lengua_literatura.m2.tragedia.10": "¿Qué tragedia de Shakespeare trata de un príncipe que quiere vengar a su padre?",
  "pregunta.chile.lengua_literatura.m2.tragedia.10.a": "Hamlet",
  "pregunta.chile.lengua_literatura.m2.tragedia.10.b": "Romeo y Julieta",
  "pregunta.chile.lengua_literatura.m2.tragedia.10.c": "El sueño de una noche de verano",
  "pregunta.chile.lengua_literatura.m2.tragedia.10.por_que": "\"Ser o no ser\"."
