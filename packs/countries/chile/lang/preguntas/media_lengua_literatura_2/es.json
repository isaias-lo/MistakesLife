  "pregunta.chile.lengua_literatura.m2.tragedia.7.por_que": "Según la Poética de Aristóteles.",
  "pregunta.chile.lengua_literatura.m2.tragedia.8": "¿Qué es la anagnórisis?",
  "pregunta.chile.lengua_literatura.m2.tragedia.8.a": "El final de la obra",
