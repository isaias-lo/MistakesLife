  "pregunta.chile.ciencias_ciudadania.m3.riesgos.2.c": "El Registro Civil",
  "pregunta.chile.ciencias_ciudadania.m3.riesgos.2.por_que": "Servicio Nacional de Prevención y Respuesta ante Desastres.",
  "pregunta.chile.ciencias_ciudadania.m3.riesgos.3": "¿Qué hacer si tras un sismo fuerte en la costa no puedes mantenerte en pie?",
  "pregunta.chile.ciencias_ciudadania.m3.riesgos.3.a": "Ir a la playa a mirar",
  "pregunta.chile.ciencias_ciudadania.m3.riesgos.3.b": "Esperar en la casa",
  "pregunta.chile.ciencias_ciudadania.m3.riesgos.3.c": "Evacuar a la zona de seguridad en altura",
  "pregunta.chile.ciencias_ciudadania.m3.riesgos.3.por_que": "Puede venir un tsunami.",
  "pregunta.chile.ciencias_ciudadania.m3.riesgos.4": "¿Qué debe tener un kit de emergencia?",
  "pregunta.chile.ciencias_ciudadania.m3.riesgos.4.a": "Agua, linterna, radio, botiquín y comida no perecible",
