  "pregunta.chile.ciencias_ciudadania.m3.salud.2.por_que": "Protege a quienes no pueden vacunarse.",
  "pregunta.chile.ciencias_ciudadania.m3.salud.3": "¿Qué enfermedad crónica se previene con buenos hábitos?",
  "pregunta.chile.ciencias_ciudadania.m3.salud.3.a": "La gripe",
