  "pregunta.chile.ciencias_ciudadania.m3.ambiente.4.por_que": "Afecta la zona central desde 2010.",
  "pregunta.chile.ciencias_ciudadania.m3.ambiente.5": "¿Qué es la huella hídrica?",
  "pregunta.chile.ciencias_ciudadania.m3.ambiente.5.a": "Una marca de agua",
