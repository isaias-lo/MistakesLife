  "pregunta.chile.ciencias_ciudadania.m3.ambiente.3.a": "Un parque nacional",
  "pregunta.chile.ciencias_ciudadania.m3.ambiente.3.b": "Una reserva indígena",
  "pregunta.chile.ciencias_ciudadania.m3.ambiente.3.c": "Un territorio muy contaminado por concentración industrial",
  "pregunta.chile.ciencias_ciudadania.m3.ambiente.3.por_que": "Como Quintero-Puchuncaví.",
  "pregunta.chile.ciencias_ciudadania.m3.ambiente.4": "¿Qué es la megasequía?",
  "pregunta.chile.ciencias_ciudadania.m3.ambiente.4.a": "Un déficit de lluvias prolongado por más de una década",
