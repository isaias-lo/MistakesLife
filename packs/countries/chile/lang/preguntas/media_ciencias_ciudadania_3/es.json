  "pregunta.chile.ciencias_ciudadania.m3.tecnologia.1.b": "Más batería",
  "pregunta.chile.ciencias_ciudadania.m3.tecnologia.1.c": "Menos internet",
  "pregunta.chile.ciencias_ciudadania.m3.tecnologia.1.por_que": "Empresas usan tus datos.",
