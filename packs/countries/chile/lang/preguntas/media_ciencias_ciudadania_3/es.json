  "pregunta.chile.ciencias_ciudadania.m3.salud.1.c": "Tener buen peso",
  "pregunta.chile.ciencias_ciudadania.m3.salud.1.por_que": "Concepto integral.",
  "pregunta.chile.ciencias_ciudadania.m3.salud.2": "¿Qué es la inmunidad de rebaño?",
