  "pregunta.chile.ciencias_ciudadania.m3.salud.3.c": "La diabetes tipo 2",
  "pregunta.chile.ciencias_ciudadania.m3.salud.3.por_que": "Alimentación y ejercicio.",
  "pregunta.chile.ciencias_ciudadania.m3.salud.4": "¿Qué es una enfermedad crónica?",
