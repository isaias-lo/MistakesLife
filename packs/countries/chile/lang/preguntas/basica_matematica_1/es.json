{
  "tema.chile.matematica.1.contar": "Contar hasta 100",
  "tema.chile.matematica.1.contar.texto": "Contamos de uno en uno: 1, 2, 3... También de dos en dos (2, 4, 6), de cinco en cinco (5, 10, 15) y de diez en diez (10, 20, 30).\n\nUn número tiene decenas y unidades: en 34 hay 3 decenas (30) y 4 unidades. El número más grande es el que tiene más decenas.",
  "pregunta.chile.matematica.1.contar.1": "¿Qué número va después del 19?",
  "pregunta.chile.matematica.1.contar.1.a": "20",
  "pregunta.chile.matematica.1.contar.1.b": "18",
  "pregunta.chile.matematica.1.contar.1.c": "29",
  "pregunta.chile.matematica.1.contar.1.por_que": "Después del 19 viene el 20.",
  "pregunta.chile.matematica.1.contar.2": "¿Qué número va antes del 50?",
  "pregunta.chile.matematica.1.contar.2.a": "51",
  "pregunta.chile.matematica.1.contar.2.b": "49",
  "pregunta.chile.matematica.1.contar.2.c": "40",
  "pregunta.chile.matematica.1.contar.2.por_que": "Antes del 50 viene el 49.",
  "pregunta.chile.matematica.1.contar.3": "Contando de 2 en 2: 2, 4, 6, ... ¿qué sigue?",
  "pregunta.chile.matematica.1.contar.3.a": "7",
  "pregunta.chile.matematica.1.contar.3.b": "10",
  "pregunta.chile.matematica.1.contar.3.c": "8",
  "pregunta.chile.matematica.1.contar.3.por_que": "Se suma 2 cada vez: 6 + 2 = 8.",
  "pregunta.chile.matematica.1.contar.4": "Contando de 5 en 5: 5, 10, 15, ... ¿qué sigue?",
  "pregunta.chile.matematica.1.contar.4.a": "20",
  "pregunta.chile.matematica.1.contar.4.b": "16",
  "pregunta.chile.matematica.1.contar.4.c": "25",
  "pregunta.chile.matematica.1.contar.4.por_que": "Se suma 5 cada vez: 15 + 5 = 20.",
  "pregunta.chile.matematica.1.contar.5": "Contando de 10 en 10: 10, 20, 30, ... ¿qué sigue?",
  "pregunta.chile.matematica.1.contar.5.a": "31",
  "pregunta.chile.matematica.1.contar.5.b": "40",
  "pregunta.chile.matematica.1.contar.5.c": "50",
  "pregunta.chile.matematica.1.contar.5.por_que": "Se suma 10 cada vez.",
  "pregunta.chile.matematica.1.contar.6": "¿Cuántas decenas tiene el 34?",
  "pregunta.chile.matematica.1.contar.6.a": "4",
  "pregunta.chile.matematica.1.contar.6.b": "34",
  "pregunta.chile.matematica.1.contar.6.c": "3",
  "pregunta.chile.matematica.1.contar.6.por_que": "34 es 3 decenas y 4 unidades.",
  "pregunta.chile.matematica.1.contar.7": "¿Cuál número es mayor?",
  "pregunta.chile.matematica.1.contar.7.a": "52",
  "pregunta.chile.matematica.1.contar.7.b": "25",
  "pregunta.chile.matematica.1.contar.7.c": "49",
  "pregunta.chile.matematica.1.contar.7.por_que": "52 tiene 5 decenas; 49 tiene 4 y 25 tiene 2.",
  "pregunta.chile.matematica.1.contar.8": "¿Cuál número es menor?",
  "pregunta.chile.matematica.1.contar.8.a": "71",
  "pregunta.chile.matematica.1.contar.8.b": "17",
  "pregunta.chile.matematica.1.contar.8.c": "27",
  "pregunta.chile.matematica.1.contar.8.por_que": "17 tiene solo 1 decena.",
  "pregunta.chile.matematica.1.contar.9": "¿Qué número es 6 decenas y 2 unidades?",
  "pregunta.chile.matematica.1.contar.9.a": "26",
  "pregunta.chile.matematica.1.contar.9.b": "8",
  "pregunta.chile.matematica.1.contar.9.c": "62",
  "pregunta.chile.matematica.1.contar.9.por_que": "6 decenas son 60; más 2 es 62.",
  "pregunta.chile.matematica.1.contar.10": "¿Cómo se escribe \"cuarenta y cinco\"?",
  "pregunta.chile.matematica.1.contar.10.a": "45",
  "pregunta.chile.matematica.1.contar.10.b": "54",
  "pregunta.chile.matematica.1.contar.10.c": "405",
  "pregunta.chile.matematica.1.contar.10.por_que": "Cuarenta es 40 y cinco es 5: 45.",
  "tema.chile.matematica.1.sumar_restar": "Sumar y restar hasta 20",
  "tema.chile.matematica.1.sumar_restar.texto": "Sumar es juntar: si tienes 5 dulces y te dan 3, tienes 5 + 3 = 8. Restar es quitar: si tienes 9 y regalas 4, te quedan 9 − 4 = 5.\n\nUn truco para sumar es contar hacia adelante desde el número más grande. Para restar puedes contar hacia atrás.",
  "pregunta.chile.matematica.1.sumar_restar.1": "¿Cuánto es 5 + 3?",
  "pregunta.chile.matematica.1.sumar_restar.1.a": "8",
  "pregunta.chile.matematica.1.sumar_restar.1.b": "7",
  "pregunta.chile.matematica.1.sumar_restar.1.c": "9",
  "pregunta.chile.matematica.1.sumar_restar.1.por_que": "5 y contamos 3 más: 6, 7, 8.",
  "pregunta.chile.matematica.1.sumar_restar.2": "¿Cuánto es 9 − 4?",
  "pregunta.chile.matematica.1.sumar_restar.2.a": "4",
  "pregunta.chile.matematica.1.sumar_restar.2.b": "5",
  "pregunta.chile.matematica.1.sumar_restar.2.c": "6",
  "pregunta.chile.matematica.1.sumar_restar.2.por_que": "De 9 quitamos 4: quedan 5.",
  "pregunta.chile.matematica.1.sumar_restar.3": "¿Cuánto es 7 + 7?",
  "pregunta.chile.matematica.1.sumar_restar.3.a": "13",
  "pregunta.chile.matematica.1.sumar_restar.3.b": "15",
  "pregunta.chile.matematica.1.sumar_restar.3.c": "14",
  "pregunta.chile.matematica.1.sumar_restar.3.por_que": "Es un doble: 7 + 7 = 14.",
  "pregunta.chile.matematica.1.sumar_restar.4": "¿Cuánto es 12 − 2?",
  "pregunta.chile.matematica.1.sumar_restar.4.a": "10",
  "pregunta.chile.matematica.1.sumar_restar.4.b": "8",
  "pregunta.chile.matematica.1.sumar_restar.4.c": "14",
  "pregunta.chile.matematica.1.sumar_restar.4.por_que": "12 menos 2 es 10.",
  "pregunta.chile.matematica.1.sumar_restar.5": "¿Cuánto es 10 + 6?",
  "pregunta.chile.matematica.1.sumar_restar.5.a": "15",
  "pregunta.chile.matematica.1.sumar_restar.5.b": "16",
  "pregunta.chile.matematica.1.sumar_restar.5.c": "106",
  "pregunta.chile.matematica.1.sumar_restar.5.por_que": "Una decena y 6 unidades: 16.",
  "pregunta.chile.matematica.1.sumar_restar.6": "Tienes 6 lápices y te regalan 4. ¿Cuántos tienes?",
  "pregunta.chile.matematica.1.sumar_restar.6.a": "2",
  "pregunta.chile.matematica.1.sumar_restar.6.b": "9",
  "pregunta.chile.matematica.1.sumar_restar.6.c": "10",
  "pregunta.chile.matematica.1.sumar_restar.6.por_que": "Juntamos: 6 + 4 = 10.",
  "pregunta.chile.matematica.1.sumar_restar.7": "Había 15 globos y se reventaron 5. ¿Cuántos quedan?",
  "pregunta.chile.matematica.1.sumar_restar.7.a": "10",
  "pregunta.chile.matematica.1.sumar_restar.7.b": "20",
  "pregunta.chile.matematica.1.sumar_restar.7.c": "11",
  "pregunta.chile.matematica.1.sumar_restar.7.por_que": "Quitamos: 15 − 5 = 10.",
  "pregunta.chile.matematica.1.sumar_restar.8": "¿Cuánto es 8 + 5?",
  "pregunta.chile.matematica.1.sumar_restar.8.a": "12",
  "pregunta.chile.matematica.1.sumar_restar.8.b": "13",
  "pregunta.chile.matematica.1.sumar_restar.8.c": "14",
  "pregunta.chile.matematica.1.sumar_restar.8.por_que": "8 + 2 = 10 y faltan 3: 13.",
  "pregunta.chile.matematica.1.sumar_restar.9": "¿Qué número falta? 4 + ___ = 10",
  "pregunta.chile.matematica.1.sumar_restar.9.a": "5",
  "pregunta.chile.matematica.1.sumar_restar.9.b": "14",
  "pregunta.chile.matematica.1.sumar_restar.9.c": "6",
  "pregunta.chile.matematica.1.sumar_restar.9.por_que": "4 + 6 = 10.",
  "pregunta.chile.matematica.1.sumar_restar.10": "¿Cuánto es 18 − 9?",
  "pregunta.chile.matematica.1.sumar_restar.10.a": "9",
  "pregunta.chile.matematica.1.sumar_restar.10.b": "8",
  "pregunta.chile.matematica.1.sumar_restar.10.c": "11",
  "pregunta.chile.matematica.1.sumar_restar.10.por_que": "9 + 9 = 18, así que 18 − 9 = 9.",
  "tema.chile.matematica.1.figuras": "Figuras y ubicación",
  "tema.chile.matematica.1.figuras.texto": "Las figuras planas son el cuadrado (4 lados iguales), el rectángulo (4 lados, dos largos y dos cortos), el triángulo (3 lados) y el círculo (redondo, sin lados).\n\nLos cuerpos geométricos ocupan espacio: el cubo como un dado, la esfera como una pelota, el cilindro como un tarro. Para ubicar cosas decimos arriba, abajo, delante, detrás, izquierda y derecha.",
  "pregunta.chile.matematica.1.figuras.1": "¿Cuántos lados tiene un triángulo?",
  "pregunta.chile.matematica.1.figuras.1.a": "3",
  "pregunta.chile.matematica.1.figuras.1.b": "4",
  "pregunta.chile.matematica.1.figuras.1.c": "5",
  "pregunta.chile.matematica.1.figuras.1.por_que": "Tri quiere decir tres.",
  "pregunta.chile.matematica.1.figuras.2": "¿Qué figura no tiene lados?",
  "pregunta.chile.matematica.1.figuras.2.a": "El cuadrado",
  "pregunta.chile.matematica.1.figuras.2.b": "El círculo",
  "pregunta.chile.matematica.1.figuras.2.c": "El triángulo",
  "pregunta.chile.matematica.1.figuras.2.por_que": "El círculo es redondo.",
  "pregunta.chile.matematica.1.figuras.3": "¿Qué figura tiene 4 lados iguales?",
  "pregunta.chile.matematica.1.figuras.3.a": "El triángulo",
  "pregunta.chile.matematica.1.figuras.3.b": "El círculo",
  "pregunta.chile.matematica.1.figuras.3.c": "El cuadrado",
  "pregunta.chile.matematica.1.figuras.3.por_que": "El rectángulo tiene 4, pero dos largos y dos cortos.",
  "pregunta.chile.matematica.1.figuras.4": "¿A qué cuerpo se parece una pelota?",
  "pregunta.chile.matematica.1.figuras.4.a": "A una esfera",
  "pregunta.chile.matematica.1.figuras.4.b": "A un cubo",
  "pregunta.chile.matematica.1.figuras.4.c": "A un cilindro",
  "pregunta.chile.matematica.1.figuras.4.por_que": "La pelota es redonda por todos lados.",
  "pregunta.chile.matematica.1.figuras.5": "¿A qué cuerpo se parece un dado?",
  "pregunta.chile.matematica.1.figuras.5.a": "A una esfera",
  "pregunta.chile.matematica.1.figuras.5.b": "A un cubo",
  "pregunta.chile.matematica.1.figuras.5.c": "A un cono",
  "pregunta.chile.matematica.1.figuras.5.por_que": "Tiene 6 caras cuadradas.",
  "pregunta.chile.matematica.1.figuras.6": "¿A qué cuerpo se parece un tarro de leche?",
  "pregunta.chile.matematica.1.figuras.6.a": "A un cubo",
  "pregunta.chile.matematica.1.figuras.6.b": "A una esfera",
  "pregunta.chile.matematica.1.figuras.6.c": "A un cilindro",
  "pregunta.chile.matematica.1.figuras.6.por_que": "Es redondo arriba y abajo, y largo.",
  "pregunta.chile.matematica.1.figuras.7": "¿Qué figura se parece a la puerta de la sala?",
  "pregunta.chile.matematica.1.figuras.7.a": "Un rectángulo",
  "pregunta.chile.matematica.1.figuras.7.b": "Un triángulo",
  "pregunta.chile.matematica.1.figuras.7.c": "Un círculo",
  "pregunta.chile.matematica.1.figuras.7.por_que": "Tiene dos lados largos y dos cortos.",
  "pregunta.chile.matematica.1.figuras.8": "Si el gato está sobre la mesa, está...",
  "pregunta.chile.matematica.1.figuras.8.a": "Debajo de la mesa",
  "pregunta.chile.matematica.1.figuras.8.b": "Arriba de la mesa",
  "pregunta.chile.matematica.1.figuras.8.c": "Detrás de la mesa",
  "pregunta.chile.matematica.1.figuras.8.por_que": "Sobre quiere decir arriba.",
  "pregunta.chile.matematica.1.figuras.9": "¿Con qué mano sueles escribir si eres diestro?",
  "pregunta.chile.matematica.1.figuras.9.a": "Con la izquierda",
  "pregunta.chile.matematica.1.figuras.9.b": "Con las dos",
  "pregunta.chile.matematica.1.figuras.9.c": "Con la derecha",
  "pregunta.chile.matematica.1.figuras.9.por_que": "Diestro quiere decir que usa la mano derecha.",
  "pregunta.chile.matematica.1.figuras.10": "¿Qué cuerpo geométrico rueda?",
  "pregunta.chile.matematica.1.figuras.10.a": "La esfera",
  "pregunta.chile.matematica.1.figuras.10.b": "El cubo",
  "pregunta.chile.matematica.1.figuras.10.c": "La pirámide",
  "pregunta.chile.matematica.1.figuras.10.por_que": "La esfera rueda hacia todos lados.",
  "tema.chile.matematica.1.medir_tiempo": "Medir y el calendario",
  "tema.chile.matematica.1.medir_tiempo.texto": "La semana tiene 7 días: lunes, martes, miércoles, jueves, viernes, sábado y domingo. El año tiene 12 meses, de enero a diciembre.\n\nPodemos medir el largo de las cosas con la mano, con clips o con una regla. Algo es más largo si ocupa más clips; algo es más pesado si cuesta más levantarlo.",
  "pregunta.chile.matematica.1.medir_tiempo.1": "¿Cuántos días tiene la semana?",
  "pregunta.chile.matematica.1.medir_tiempo.1.a": "7",
  "pregunta.chile.matematica.1.medir_tiempo.1.b": "5",
  "pregunta.chile.matematica.1.medir_tiempo.1.c": "10",
  "pregunta.chile.matematica.1.medir_tiempo.1.por_que": "De lunes a domingo son 7 días.",
  "pregunta.chile.matematica.1.medir_tiempo.2": "¿Qué día va después del martes?",
  "pregunta.chile.matematica.1.medir_tiempo.2.a": "Lunes",
  "pregunta.chile.matematica.1.medir_tiempo.2.b": "Miércoles",
  "pregunta.chile.matematica.1.medir_tiempo.2.c": "Jueves",
  "pregunta.chile.matematica.1.medir_tiempo.2.por_que": "Lunes, martes, miércoles...",
  "pregunta.chile.matematica.1.medir_tiempo.3": "¿Cuántos meses tiene el año?",
  "pregunta.chile.matematica.1.medir_tiempo.3.a": "10",
  "pregunta.chile.matematica.1.medir_tiempo.3.b": "7",
  "pregunta.chile.matematica.1.medir_tiempo.3.c": "12",
  "pregunta.chile.matematica.1.medir_tiempo.3.por_que": "De enero a diciembre son 12.",
  "pregunta.chile.matematica.1.medir_tiempo.4": "¿Cuál es el primer mes del año?",
  "pregunta.chile.matematica.1.medir_tiempo.4.a": "Enero",
  "pregunta.chile.matematica.1.medir_tiempo.4.b": "Marzo",
  "pregunta.chile.matematica.1.medir_tiempo.4.c": "Diciembre",
  "pregunta.chile.matematica.1.medir_tiempo.4.por_que": "El año parte en enero.",
  "pregunta.chile.matematica.1.medir_tiempo.5": "¿En qué mes se celebra Navidad?",
  "pregunta.chile.matematica.1.medir_tiempo.5.a": "Septiembre",
  "pregunta.chile.matematica.1.medir_tiempo.5.b": "Diciembre",
  "pregunta.chile.matematica.1.medir_tiempo.5.c": "Marzo",
  "pregunta.chile.matematica.1.medir_tiempo.5.por_que": "Navidad es el 25 de diciembre.",
  "pregunta.chile.matematica.1.medir_tiempo.6": "En Chile, ¿en qué mes se celebran las Fiestas Patrias?",
  "pregunta.chile.matematica.1.medir_tiempo.6.a": "Enero",
  "pregunta.chile.matematica.1.medir_tiempo.6.b": "Julio",
  "pregunta.chile.matematica.1.medir_tiempo.6.c": "Septiembre",
  "pregunta.chile.matematica.1.medir_tiempo.6.por_que": "El 18 de septiembre.",
  "pregunta.chile.matematica.1.medir_tiempo.7": "¿Qué es más pesado?",
  "pregunta.chile.matematica.1.medir_tiempo.7.a": "Una sandía",
  "pregunta.chile.matematica.1.medir_tiempo.7.b": "Una pluma",
  "pregunta.chile.matematica.1.medir_tiempo.7.c": "Un lápiz",
  "pregunta.chile.matematica.1.medir_tiempo.7.por_que": "La sandía cuesta más levantarla.",
  "pregunta.chile.matematica.1.medir_tiempo.8": "Una mesa mide 10 clips y un cuaderno 4 clips. ¿Qué es más largo?",
  "pregunta.chile.matematica.1.medir_tiempo.8.a": "El cuaderno",
  "pregunta.chile.matematica.1.medir_tiempo.8.b": "La mesa",
  "pregunta.chile.matematica.1.medir_tiempo.8.c": "Miden lo mismo",
  "pregunta.chile.matematica.1.medir_tiempo.8.por_que": "Ocupa más clips.",
  "pregunta.chile.matematica.1.medir_tiempo.9": "¿Qué día va antes del sábado?",
  "pregunta.chile.matematica.1.medir_tiempo.9.a": "Domingo",
  "pregunta.chile.matematica.1.medir_tiempo.9.b": "Jueves",
  "pregunta.chile.matematica.1.medir_tiempo.9.c": "Viernes",
  "pregunta.chile.matematica.1.medir_tiempo.9.por_que": "Jueves, viernes, sábado.",
  "pregunta.chile.matematica.1.medir_tiempo.10": "Si hoy es domingo, ¿qué día es mañana?",
  "pregunta.chile.matematica.1.medir_tiempo.10.a": "Lunes",
  "pregunta.chile.matematica.1.medir_tiempo.10.b": "Sábado",
  "pregunta.chile.matematica.1.medir_tiempo.10.c": "Martes",
  "pregunta.chile.matematica.1.medir_tiempo.10.por_que": "Después del domingo vuelve el lunes."
}
