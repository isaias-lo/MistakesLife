{
  "tema.chile.matematica.6.razones": "Razones y porcentajes",
  "tema.chile.matematica.6.razones.texto": "Una razón compara dos cantidades: si en un curso hay 12 niñas y 18 niños, la razón niñas a niños es 12 : 18, que se simplifica a 2 : 3.\n\nUn porcentaje es una razón con 100: 25 % es 25 de cada 100, o sea 1/4. Para calcular el 10 % de algo se divide por 10; el 50 % es la mitad.",
  "pregunta.chile.matematica.6.razones.1": "12 niñas y 18 niños: ¿cuál es la razón niñas a niños simplificada?",
  "pregunta.chile.matematica.6.razones.1.a": "2 : 3",
  "pregunta.chile.matematica.6.razones.1.b": "3 : 2",
  "pregunta.chile.matematica.6.razones.1.c": "12 : 30",
  "pregunta.chile.matematica.6.razones.1.por_que": "Se dividen ambos por 6.",
  "pregunta.chile.matematica.6.razones.2": "¿Qué es el 50 % de 80?",
  "pregunta.chile.matematica.6.razones.2.a": "50",
  "pregunta.chile.matematica.6.razones.2.b": "40",
  "pregunta.chile.matematica.6.razones.2.c": "30",
  "pregunta.chile.matematica.6.razones.2.por_que": "El 50 % es la mitad.",
  "pregunta.chile.matematica.6.razones.3": "¿Qué es el 10 % de 350?",
  "pregunta.chile.matematica.6.razones.3.a": "3,5",
  "pregunta.chile.matematica.6.razones.3.b": "10",
  "pregunta.chile.matematica.6.razones.3.c": "35",
  "pregunta.chile.matematica.6.razones.3.por_que": "Se divide por 10.",
  "pregunta.chile.matematica.6.razones.4": "¿Qué fracción es el 25 %?",
  "pregunta.chile.matematica.6.razones.4.a": "1/4",
  "pregunta.chile.matematica.6.razones.4.b": "1/2",
  "pregunta.chile.matematica.6.razones.4.c": "1/25",
  "pregunta.chile.matematica.6.razones.4.por_que": "25 de 100 = 1/4.",
  "pregunta.chile.matematica.6.razones.5": "¿Qué es el 25 % de 200?",
  "pregunta.chile.matematica.6.razones.5.a": "25",
  "pregunta.chile.matematica.6.razones.5.b": "50",
  "pregunta.chile.matematica.6.razones.5.c": "75",
  "pregunta.chile.matematica.6.razones.5.por_que": "200 : 4 = 50.",
  "pregunta.chile.matematica.6.razones.6": "Una polera cuesta $10 000 y tiene 20 % de descuento. ¿Cuánto se descuenta?",
  "pregunta.chile.matematica.6.razones.6.a": "$200",
  "pregunta.chile.matematica.6.razones.6.b": "$8 000",
  "pregunta.chile.matematica.6.razones.6.c": "$2 000",
  "pregunta.chile.matematica.6.razones.6.por_que": "10 % es 1 000; 20 % es 2 000.",
  "pregunta.chile.matematica.6.razones.7": "En una receta van 2 tazas de harina por 1 de azúcar. Para 6 de harina, ¿cuánta azúcar?",
  "pregunta.chile.matematica.6.razones.7.a": "3 tazas",
  "pregunta.chile.matematica.6.razones.7.b": "2 tazas",
  "pregunta.chile.matematica.6.razones.7.c": "6 tazas",
  "pregunta.chile.matematica.6.razones.7.por_que": "La razón 2 : 1 se mantiene.",
  "pregunta.chile.matematica.6.razones.8": "¿Cómo se escribe 3/4 como porcentaje?",
  "pregunta.chile.matematica.6.razones.8.a": "34 %",
  "pregunta.chile.matematica.6.razones.8.b": "75 %",
  "pregunta.chile.matematica.6.razones.8.c": "43 %",
  "pregunta.chile.matematica.6.razones.8.por_que": "3/4 = 75/100.",
  "pregunta.chile.matematica.6.razones.9": "Si de 20 preguntas aciertas 15, ¿qué porcentaje acertaste?",
  "pregunta.chile.matematica.6.razones.9.a": "15 %",
  "pregunta.chile.matematica.6.razones.9.b": "85 %",
  "pregunta.chile.matematica.6.razones.9.c": "75 %",
  "pregunta.chile.matematica.6.razones.9.por_que": "15/20 = 75/100.",
  "pregunta.chile.matematica.6.razones.10": "¿Qué es el 1 % de 500?",
  "pregunta.chile.matematica.6.razones.10.a": "5",
  "pregunta.chile.matematica.6.razones.10.b": "50",
  "pregunta.chile.matematica.6.razones.10.c": "0,5",
  "pregunta.chile.matematica.6.razones.10.por_que": "500 : 100 = 5.",
  "tema.chile.matematica.6.operaciones": "Fracciones y decimales",
  "tema.chile.matematica.6.operaciones.texto": "Para sumar fracciones con distinto denominador se buscan fracciones equivalentes con el mismo denominador: 1/2 + 1/3 = 3/6 + 2/6 = 5/6.\n\nPara multiplicar decimales se multiplica como si fueran enteros y luego se cuentan los decimales: 0,3 × 0,2 = 0,06. Multiplicar por 10 corre la coma un lugar a la derecha.",
  "pregunta.chile.matematica.6.operaciones.1": "¿Cuánto es 1/2 + 1/3?",
  "pregunta.chile.matematica.6.operaciones.1.a": "5/6",
  "pregunta.chile.matematica.6.operaciones.1.b": "2/5",
  "pregunta.chile.matematica.6.operaciones.1.c": "1/6",
  "pregunta.chile.matematica.6.operaciones.1.por_que": "3/6 + 2/6 = 5/6.",
  "pregunta.chile.matematica.6.operaciones.2": "¿Cuánto es 3/4 − 1/2?",
  "pregunta.chile.matematica.6.operaciones.2.a": "2/2",
  "pregunta.chile.matematica.6.operaciones.2.b": "1/4",
  "pregunta.chile.matematica.6.operaciones.2.c": "1/2",
  "pregunta.chile.matematica.6.operaciones.2.por_que": "3/4 − 2/4 = 1/4.",
  "pregunta.chile.matematica.6.operaciones.3": "¿Cuánto es 0,3 × 0,2?",
  "pregunta.chile.matematica.6.operaciones.3.a": "0,6",
  "pregunta.chile.matematica.6.operaciones.3.b": "6",
  "pregunta.chile.matematica.6.operaciones.3.c": "0,06",
  "pregunta.chile.matematica.6.operaciones.3.por_que": "3 × 2 = 6 y hay dos decimales.",
  "pregunta.chile.matematica.6.operaciones.4": "¿Cuánto es 4,5 × 10?",
  "pregunta.chile.matematica.6.operaciones.4.a": "45",
  "pregunta.chile.matematica.6.operaciones.4.b": "0,45",
  "pregunta.chile.matematica.6.operaciones.4.c": "450",
  "pregunta.chile.matematica.6.operaciones.4.por_que": "La coma se corre un lugar a la derecha.",
  "pregunta.chile.matematica.6.operaciones.5": "¿Cuánto es 2,5 + 1,75?",
  "pregunta.chile.matematica.6.operaciones.5.a": "3,25",
  "pregunta.chile.matematica.6.operaciones.5.b": "4,25",
  "pregunta.chile.matematica.6.operaciones.5.c": "4,3",
  "pregunta.chile.matematica.6.operaciones.5.por_que": "Se alinean las comas.",
  "pregunta.chile.matematica.6.operaciones.6": "¿Cuánto es 1/4 de 1/2?",
  "pregunta.chile.matematica.6.operaciones.6.a": "1/6",
  "pregunta.chile.matematica.6.operaciones.6.b": "2/4",
  "pregunta.chile.matematica.6.operaciones.6.c": "1/8",
  "pregunta.chile.matematica.6.operaciones.6.por_que": "1/4 × 1/2 = 1/8.",
  "pregunta.chile.matematica.6.operaciones.7": "¿Cómo se escribe 3/5 como decimal?",
  "pregunta.chile.matematica.6.operaciones.7.a": "0,6",
  "pregunta.chile.matematica.6.operaciones.7.b": "0,35",
  "pregunta.chile.matematica.6.operaciones.7.c": "3,5",
  "pregunta.chile.matematica.6.operaciones.7.por_que": "3/5 = 6/10.",
  "pregunta.chile.matematica.6.operaciones.8": "¿Cuánto es 7,2 : 10?",
  "pregunta.chile.matematica.6.operaciones.8.a": "72",
  "pregunta.chile.matematica.6.operaciones.8.b": "0,72",
  "pregunta.chile.matematica.6.operaciones.8.c": "7,02",
  "pregunta.chile.matematica.6.operaciones.8.por_que": "La coma se corre un lugar a la izquierda.",
  "pregunta.chile.matematica.6.operaciones.9": "¿Cuál es el mínimo común múltiplo de 4 y 6?",
  "pregunta.chile.matematica.6.operaciones.9.a": "24",
  "pregunta.chile.matematica.6.operaciones.9.b": "2",
  "pregunta.chile.matematica.6.operaciones.9.c": "12",
  "pregunta.chile.matematica.6.operaciones.9.por_que": "Es el menor número que es múltiplo de ambos.",
  "pregunta.chile.matematica.6.operaciones.10": "¿Cuánto es 2/3 × 3?",
  "pregunta.chile.matematica.6.operaciones.10.a": "2",
  "pregunta.chile.matematica.6.operaciones.10.b": "6/9",
  "pregunta.chile.matematica.6.operaciones.10.c": "5/3",
  "pregunta.chile.matematica.6.operaciones.10.por_que": "2/3 tres veces es 6/3 = 2.",
  "tema.chile.matematica.6.ecuaciones": "Ecuaciones y patrones",
  "tema.chile.matematica.6.ecuaciones.texto": "Una ecuación tiene una incógnita, un número que no conocemos. Para resolver 3x = 21 se divide por 3: x = 7. Para resolver x − 8 = 12 se suma 8: x = 20. Siempre se puede comprobar reemplazando.\n\nUn patrón sigue una regla. En 5, 8, 11, 14..., la regla es sumar 3, y el término n es 3n + 2.",
  "pregunta.chile.matematica.6.ecuaciones.1": "Si 3x = 21, ¿cuánto vale x?",
  "pregunta.chile.matematica.6.ecuaciones.1.a": "7",
  "pregunta.chile.matematica.6.ecuaciones.1.b": "18",
  "pregunta.chile.matematica.6.ecuaciones.1.c": "24",
  "pregunta.chile.matematica.6.ecuaciones.1.por_que": "21 : 3 = 7.",
  "pregunta.chile.matematica.6.ecuaciones.2": "Si x − 8 = 12, ¿cuánto vale x?",
  "pregunta.chile.matematica.6.ecuaciones.2.a": "4",
  "pregunta.chile.matematica.6.ecuaciones.2.b": "20",
  "pregunta.chile.matematica.6.ecuaciones.2.c": "96",
  "pregunta.chile.matematica.6.ecuaciones.2.por_que": "12 + 8 = 20.",
  "pregunta.chile.matematica.6.ecuaciones.3": "Si x + 15 = 40, ¿cuánto vale x?",
  "pregunta.chile.matematica.6.ecuaciones.3.a": "55",
  "pregunta.chile.matematica.6.ecuaciones.3.b": "35",
  "pregunta.chile.matematica.6.ecuaciones.3.c": "25",
  "pregunta.chile.matematica.6.ecuaciones.3.por_que": "40 − 15 = 25.",
  "pregunta.chile.matematica.6.ecuaciones.4": "Si x : 4 = 6, ¿cuánto vale x?",
  "pregunta.chile.matematica.6.ecuaciones.4.a": "24",
  "pregunta.chile.matematica.6.ecuaciones.4.b": "10",
  "pregunta.chile.matematica.6.ecuaciones.4.c": "1,5",
  "pregunta.chile.matematica.6.ecuaciones.4.por_que": "6 × 4 = 24.",
  "pregunta.chile.matematica.6.ecuaciones.5": "En 5, 8, 11, 14..., ¿qué número sigue?",
  "pregunta.chile.matematica.6.ecuaciones.5.a": "16",
  "pregunta.chile.matematica.6.ecuaciones.5.b": "17",
  "pregunta.chile.matematica.6.ecuaciones.5.c": "18",
  "pregunta.chile.matematica.6.ecuaciones.5.por_que": "Se suma 3.",
  "pregunta.chile.matematica.6.ecuaciones.6": "¿Qué regla sigue 2, 4, 8, 16...?",
  "pregunta.chile.matematica.6.ecuaciones.6.a": "Sumar 2",
  "pregunta.chile.matematica.6.ecuaciones.6.b": "Sumar 4",
  "pregunta.chile.matematica.6.ecuaciones.6.c": "Multiplicar por 2",
  "pregunta.chile.matematica.6.ecuaciones.6.por_que": "Cada número es el doble del anterior.",
  "pregunta.chile.matematica.6.ecuaciones.7": "Si 2x + 3 = 11, ¿cuánto vale x?",
  "pregunta.chile.matematica.6.ecuaciones.7.a": "4",
  "pregunta.chile.matematica.6.ecuaciones.7.b": "7",
  "pregunta.chile.matematica.6.ecuaciones.7.c": "5",
  "pregunta.chile.matematica.6.ecuaciones.7.por_que": "2x = 8, x = 4.",
  "pregunta.chile.matematica.6.ecuaciones.8": "Un número más su doble da 27. ¿Cuál es?",
  "pregunta.chile.matematica.6.ecuaciones.8.a": "13",
  "pregunta.chile.matematica.6.ecuaciones.8.b": "9",
  "pregunta.chile.matematica.6.ecuaciones.8.c": "18",
  "pregunta.chile.matematica.6.ecuaciones.8.por_que": "x + 2x = 3x = 27.",
  "pregunta.chile.matematica.6.ecuaciones.9": "Si n vale 5, ¿cuánto es 3n + 2?",
  "pregunta.chile.matematica.6.ecuaciones.9.a": "35",
  "pregunta.chile.matematica.6.ecuaciones.9.b": "10",
  "pregunta.chile.matematica.6.ecuaciones.9.c": "17",
  "pregunta.chile.matematica.6.ecuaciones.9.por_que": "3 × 5 + 2 = 17.",
  "pregunta.chile.matematica.6.ecuaciones.10": "Juan tiene 4 años más que Ana. Si Juan tiene 15, ¿cuántos tiene Ana?",
  "pregunta.chile.matematica.6.ecuaciones.10.a": "11",
  "pregunta.chile.matematica.6.ecuaciones.10.b": "19",
  "pregunta.chile.matematica.6.ecuaciones.10.c": "4",
  "pregunta.chile.matematica.6.ecuaciones.10.por_que": "x + 4 = 15.",
  "tema.chile.matematica.6.geometria_datos": "Ángulos, áreas y gráficos",
  "tema.chile.matematica.6.geometria_datos.texto": "Los ángulos interiores de un triángulo suman 180°; los de un cuadrilátero, 360°. El área de un triángulo es base por altura dividido por 2. El área de un paralelogramo es base por altura.\n\nEl volumen de un cubo es arista × arista × arista. En un gráfico circular, el círculo completo es el 100 % y cada parte muestra un porcentaje.",
  "pregunta.chile.matematica.6.geometria_datos.1": "¿Cuánto suman los ángulos de un triángulo?",
  "pregunta.chile.matematica.6.geometria_datos.1.a": "180°",
  "pregunta.chile.matematica.6.geometria_datos.1.b": "360°",
  "pregunta.chile.matematica.6.geometria_datos.1.c": "90°",
  "pregunta.chile.matematica.6.geometria_datos.1.por_que": "Siempre 180°.",
  "pregunta.chile.matematica.6.geometria_datos.2": "Un triángulo tiene ángulos de 50° y 60°. ¿Cuánto mide el tercero?",
  "pregunta.chile.matematica.6.geometria_datos.2.a": "90°",
  "pregunta.chile.matematica.6.geometria_datos.2.b": "70°",
  "pregunta.chile.matematica.6.geometria_datos.2.c": "110°",
  "pregunta.chile.matematica.6.geometria_datos.2.por_que": "180 − 50 − 60 = 70.",
  "pregunta.chile.matematica.6.geometria_datos.3": "¿Cuánto suman los ángulos de un cuadrilátero?",
  "pregunta.chile.matematica.6.geometria_datos.3.a": "180°",
  "pregunta.chile.matematica.6.geometria_datos.3.b": "400°",
  "pregunta.chile.matematica.6.geometria_datos.3.c": "360°",
  "pregunta.chile.matematica.6.geometria_datos.3.por_que": "Se puede dividir en dos triángulos.",
  "pregunta.chile.matematica.6.geometria_datos.4": "¿Cuál es el área de un triángulo de base 8 cm y altura 5 cm?",
  "pregunta.chile.matematica.6.geometria_datos.4.a": "20 cm²",
  "pregunta.chile.matematica.6.geometria_datos.4.b": "40 cm²",
  "pregunta.chile.matematica.6.geometria_datos.4.c": "13 cm²",
  "pregunta.chile.matematica.6.geometria_datos.4.por_que": "8 × 5 : 2 = 20.",
  "pregunta.chile.matematica.6.geometria_datos.5": "¿Cuál es el área de un paralelogramo de base 6 m y altura 4 m?",
  "pregunta.chile.matematica.6.geometria_datos.5.a": "12 m²",
  "pregunta.chile.matematica.6.geometria_datos.5.b": "24 m²",
  "pregunta.chile.matematica.6.geometria_datos.5.c": "20 m²",
  "pregunta.chile.matematica.6.geometria_datos.5.por_que": "Base por altura.",
  "pregunta.chile.matematica.6.geometria_datos.6": "¿Cuál es el volumen de un cubo de 3 cm de arista?",
  "pregunta.chile.matematica.6.geometria_datos.6.a": "9 cm³",
  "pregunta.chile.matematica.6.geometria_datos.6.b": "18 cm³",
  "pregunta.chile.matematica.6.geometria_datos.6.c": "27 cm³",
  "pregunta.chile.matematica.6.geometria_datos.6.por_que": "3 × 3 × 3 = 27.",
  "pregunta.chile.matematica.6.geometria_datos.7": "En un gráfico circular, ¿qué representa el círculo completo?",
  "pregunta.chile.matematica.6.geometria_datos.7.a": "El 100 %",
  "pregunta.chile.matematica.6.geometria_datos.7.b": "El 50 %",
  "pregunta.chile.matematica.6.geometria_datos.7.c": "El 360 %",
  "pregunta.chile.matematica.6.geometria_datos.7.por_que": "Todo el total.",
  "pregunta.chile.matematica.6.geometria_datos.8": "Si la mitad de un gráfico circular es \"fútbol\", ¿qué porcentaje es?",
  "pregunta.chile.matematica.6.geometria_datos.8.a": "25 %",
  "pregunta.chile.matematica.6.geometria_datos.8.b": "50 %",
  "pregunta.chile.matematica.6.geometria_datos.8.c": "180 %",
  "pregunta.chile.matematica.6.geometria_datos.8.por_que": "La mitad del total.",
  "pregunta.chile.matematica.6.geometria_datos.9": "¿Cuánto mide cada ángulo de un triángulo equilátero?",
  "pregunta.chile.matematica.6.geometria_datos.9.a": "90°",
  "pregunta.chile.matematica.6.geometria_datos.9.b": "45°",
  "pregunta.chile.matematica.6.geometria_datos.9.c": "60°",
  "pregunta.chile.matematica.6.geometria_datos.9.por_que": "180 : 3 = 60.",
  "pregunta.chile.matematica.6.geometria_datos.10": "¿Cuántos cm³ caben en 1 litro?",
  "pregunta.chile.matematica.6.geometria_datos.10.a": "1 000",
  "pregunta.chile.matematica.6.geometria_datos.10.b": "100",
  "pregunta.chile.matematica.6.geometria_datos.10.c": "10",
  "pregunta.chile.matematica.6.geometria_datos.10.por_que": "1 litro = 1 000 cm³."
}
