  "pregunta.chile.tecnologia.2.necesidades.2.b": "El teléfono",
  "pregunta.chile.tecnologia.2.necesidades.2.c": "El plato",
  "pregunta.chile.tecnologia.2.necesidades.2.por_que": "Hablamos a distancia.",
  "pregunta.chile.tecnologia.2.necesidades.3": "¿Cómo se lavaba la ropa antes de la lavadora?",
