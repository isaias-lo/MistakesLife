  "pregunta.chile.tecnologia.2.necesidades.3.c": "A mano",
  "pregunta.chile.tecnologia.2.necesidades.3.por_que": "Con agua y jabón en una batea.",
  "pregunta.chile.tecnologia.2.necesidades.4": "¿Qué necesidad cubre un abrigo?",
  "pregunta.chile.tecnologia.2.necesidades.4.a": "Abrigarnos",
  "pregunta.chile.tecnologia.2.necesidades.4.b": "Comer",
  "pregunta.chile.tecnologia.2.necesidades.4.c": "Escribir",
  "pregunta.chile.tecnologia.2.necesidades.4.por_que": "Nos protege del frío.",
  "pregunta.chile.tecnologia.2.necesidades.5": "¿Qué objeto sirve para cocinar?",
