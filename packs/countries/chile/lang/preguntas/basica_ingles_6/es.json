{
  "tema.chile.ingles.6.places": "Places in my town",
  "tema.chile.ingles.6.places.texto": "In my town there is a hospital, a supermarket and a big park. There are two schools and a bus station. The bank is next to the post office.\n\nTo give directions we say: \"Go straight\", \"Turn left\", \"Turn right\".",
  "pregunta.chile.ingles.6.places.1": "¿Qué significa \"next to\"?",
  "pregunta.chile.ingles.6.places.1.a": "Al lado de",
  "pregunta.chile.ingles.6.places.1.b": "Detrás de",
  "pregunta.chile.ingles.6.places.1.c": "Lejos de",
  "pregunta.chile.ingles.6.places.1.por_que": "The bank is next to the post office.",
  "pregunta.chile.ingles.6.places.2": "¿Qué significa \"Turn left\"?",
  "pregunta.chile.ingles.6.places.2.a": "Dobla a la derecha",
  "pregunta.chile.ingles.6.places.2.b": "Dobla a la izquierda",
  "pregunta.chile.ingles.6.places.2.c": "Sigue derecho",
  "pregunta.chile.ingles.6.places.2.por_que": "Right es derecha.",
  "pregunta.chile.ingles.6.places.3": "¿Cuántos colegios hay?",
  "pregunta.chile.ingles.6.places.3.a": "Uno",
  "pregunta.chile.ingles.6.places.3.b": "Tres",
  "pregunta.chile.ingles.6.places.3.c": "Dos",
  "pregunta.chile.ingles.6.places.3.por_que": "\"There are two schools\".",
  "pregunta.chile.ingles.6.places.4": "Completa: \"There ___ a hospital.\"",
  "pregunta.chile.ingles.6.places.4.a": "is",
  "pregunta.chile.ingles.6.places.4.b": "are",
  "pregunta.chile.ingles.6.places.4.c": "am",
  "pregunta.chile.ingles.6.places.4.por_que": "Singular: there is.",
  "pregunta.chile.ingles.6.places.5": "Completa: \"There ___ three parks.\"",
  "pregunta.chile.ingles.6.places.5.a": "is",
  "pregunta.chile.ingles.6.places.5.b": "are",
  "pregunta.chile.ingles.6.places.5.c": "be",
  "pregunta.chile.ingles.6.places.5.por_que": "Plural: there are.",
  "pregunta.chile.ingles.6.places.6": "¿Qué es \"post office\"?",
  "pregunta.chile.ingles.6.places.6.a": "Policía",
  "pregunta.chile.ingles.6.places.6.b": "Panadería",
  "pregunta.chile.ingles.6.places.6.c": "Correo",
  "pregunta.chile.ingles.6.places.6.por_que": "Donde se envían cartas.",
  "pregunta.chile.ingles.6.places.7": "¿Qué significa \"Go straight\"?",
  "pregunta.chile.ingles.6.places.7.a": "Sigue derecho",
  "pregunta.chile.ingles.6.places.7.b": "Vuelve atrás",
  "pregunta.chile.ingles.6.places.7.c": "Detente",
  "pregunta.chile.ingles.6.places.7.por_que": "Straight = recto.",
  "pregunta.chile.ingles.6.places.8": "¿Qué lugar sirve para comprar comida?",
  "pregunta.chile.ingles.6.places.8.a": "Hospital",
  "pregunta.chile.ingles.6.places.8.b": "Supermarket",
  "pregunta.chile.ingles.6.places.8.c": "Bus station",
  "pregunta.chile.ingles.6.places.8.por_que": "Supermercado.",
  "pregunta.chile.ingles.6.places.9": "¿Qué significa \"between\"?",
  "pregunta.chile.ingles.6.places.9.a": "Encima",
  "pregunta.chile.ingles.6.places.9.b": "Debajo",
  "pregunta.chile.ingles.6.places.9.c": "Entre",
  "pregunta.chile.ingles.6.places.9.por_que": "The park is between the bank and the school.",
  "pregunta.chile.ingles.6.places.10": "¿Cómo preguntas dónde está el banco?",
  "pregunta.chile.ingles.6.places.10.a": "Where is the bank?",
  "pregunta.chile.ingles.6.places.10.b": "What is the bank?",
  "pregunta.chile.ingles.6.places.10.c": "Who is the bank?",
  "pregunta.chile.ingles.6.places.10.por_que": "Where = dónde.",
  "tema.chile.ingles.6.present": "What do you do every day?",
  "tema.chile.ingles.6.present.texto": "Sofía gets up at seven. She has breakfast and then she goes to school by bus. After school she does her homework and plays with her cat.\n\nWith he, she and it, the verb in present adds -s: I play, she plays.",
  "pregunta.chile.ingles.6.present.1": "¿A qué hora se levanta Sofía?",
  "pregunta.chile.ingles.6.present.1.a": "A las siete",
  "pregunta.chile.ingles.6.present.1.b": "A las ocho",
  "pregunta.chile.ingles.6.present.1.c": "A las seis",
  "pregunta.chile.ingles.6.present.1.por_que": "She gets up at seven.",
  "pregunta.chile.ingles.6.present.2": "¿Cómo va al colegio?",
  "pregunta.chile.ingles.6.present.2.a": "En auto",
  "pregunta.chile.ingles.6.present.2.b": "En bus",
  "pregunta.chile.ingles.6.present.2.c": "Caminando",
  "pregunta.chile.ingles.6.present.2.por_que": "By bus.",
  "pregunta.chile.ingles.6.present.3": "¿Qué hace después del colegio?",
  "pregunta.chile.ingles.6.present.3.a": "Duerme",
  "pregunta.chile.ingles.6.present.3.b": "Va al parque",
  "pregunta.chile.ingles.6.present.3.c": "La tarea y juega con su gato",
  "pregunta.chile.ingles.6.present.3.por_que": "Does her homework and plays with her cat.",
  "pregunta.chile.ingles.6.present.4": "Completa: \"She ___ tennis.\"",
  "pregunta.chile.ingles.6.present.4.a": "plays",
  "pregunta.chile.ingles.6.present.4.b": "play",
  "pregunta.chile.ingles.6.present.4.c": "playing",
  "pregunta.chile.ingles.6.present.4.por_que": "Con she el verbo agrega -s.",
  "pregunta.chile.ingles.6.present.5": "Completa: \"I ___ to school.\"",
  "pregunta.chile.ingles.6.present.5.a": "goes",
  "pregunta.chile.ingles.6.present.5.b": "go",
  "pregunta.chile.ingles.6.present.5.c": "going",
  "pregunta.chile.ingles.6.present.5.por_que": "Con I no se agrega -s.",
  "pregunta.chile.ingles.6.present.6": "Completa: \"He ___ TV every day.\"",
  "pregunta.chile.ingles.6.present.6.a": "watch",
  "pregunta.chile.ingles.6.present.6.b": "watchs",
  "pregunta.chile.ingles.6.present.6.c": "watches",
  "pregunta.chile.ingles.6.present.6.por_que": "Verbos que terminan en -ch agregan -es.",
  "pregunta.chile.ingles.6.present.7": "¿Qué significa \"homework\"?",
  "pregunta.chile.ingles.6.present.7.a": "Tarea",
  "pregunta.chile.ingles.6.present.7.b": "Trabajo de la casa",
  "pregunta.chile.ingles.6.present.7.c": "Escuela",
  "pregunta.chile.ingles.6.present.7.por_que": "Ojo: es la tarea del colegio.",
  "pregunta.chile.ingles.6.present.8": "¿Cuál es la negación correcta?",
  "pregunta.chile.ingles.6.present.8.a": "She don't like milk",
  "pregunta.chile.ingles.6.present.8.b": "She doesn't like milk",
  "pregunta.chile.ingles.6.present.8.c": "She not likes milk",
  "pregunta.chile.ingles.6.present.8.por_que": "Con she se usa doesn't.",
  "pregunta.chile.ingles.6.present.9": "¿Qué significa \"always\"?",
  "pregunta.chile.ingles.6.present.9.a": "Nunca",
  "pregunta.chile.ingles.6.present.9.b": "A veces",
  "pregunta.chile.ingles.6.present.9.c": "Siempre",
  "pregunta.chile.ingles.6.present.9.por_que": "Never = nunca, sometimes = a veces.",
  "pregunta.chile.ingles.6.present.10": "¿Qué significa \"gets up\"?",
  "pregunta.chile.ingles.6.present.10.a": "Se levanta",
  "pregunta.chile.ingles.6.present.10.b": "Se acuesta",
  "pregunta.chile.ingles.6.present.10.c": "Se ducha",
  "pregunta.chile.ingles.6.present.10.por_que": "Go to bed es acostarse.",
  "tema.chile.ingles.6.animals": "Animals and nature",
  "tema.chile.ingles.6.animals.texto": "The condor is a big bird. It lives in the Andes and it can fly very high. The penguin is a bird too, but it can't fly; it can swim very well.\n\nWe use \"can\" for abilities: a fish can swim, but it can't walk.",
  "pregunta.chile.ingles.6.animals.1": "¿Dónde vive el cóndor según el texto?",
  "pregunta.chile.ingles.6.animals.1.a": "En los Andes",
  "pregunta.chile.ingles.6.animals.1.b": "En el mar",
  "pregunta.chile.ingles.6.animals.1.c": "En la selva",
  "pregunta.chile.ingles.6.animals.1.por_que": "It lives in the Andes.",
  "pregunta.chile.ingles.6.animals.2": "¿Qué no puede hacer el pingüino?",
  "pregunta.chile.ingles.6.animals.2.a": "Nadar",
  "pregunta.chile.ingles.6.animals.2.b": "Volar",
  "pregunta.chile.ingles.6.animals.2.c": "Caminar",
  "pregunta.chile.ingles.6.animals.2.por_que": "It can't fly.",
  "pregunta.chile.ingles.6.animals.3": "¿Qué significa \"can swim\"?",
  "pregunta.chile.ingles.6.animals.3.a": "No puede nadar",
  "pregunta.chile.ingles.6.animals.3.b": "Quiere nadar",
  "pregunta.chile.ingles.6.animals.3.c": "Puede nadar",
  "pregunta.chile.ingles.6.animals.3.por_que": "Can = poder.",
  "pregunta.chile.ingles.6.animals.4": "Completa: \"A fish ___ walk.\"",
  "pregunta.chile.ingles.6.animals.4.a": "can't",
  "pregunta.chile.ingles.6.animals.4.b": "can",
  "pregunta.chile.ingles.6.animals.4.c": "is",
  "pregunta.chile.ingles.6.animals.4.por_que": "Los peces no caminan.",
  "pregunta.chile.ingles.6.animals.5": "¿Qué significa \"bird\"?",
  "pregunta.chile.ingles.6.animals.5.a": "Pez",
  "pregunta.chile.ingles.6.animals.5.b": "Pájaro",
  "pregunta.chile.ingles.6.animals.5.c": "Perro",
  "pregunta.chile.ingles.6.animals.5.por_que": "Bird = ave.",
  "pregunta.chile.ingles.6.animals.6": "¿Cuál es correcto?",
  "pregunta.chile.ingles.6.animals.6.a": "A dog cans run",
  "pregunta.chile.ingles.6.animals.6.b": "A dog can runs",
  "pregunta.chile.ingles.6.animals.6.c": "A dog can run",
  "pregunta.chile.ingles.6.animals.6.por_que": "Después de can, el verbo va sin -s.",
  "pregunta.chile.ingles.6.animals.7": "¿Qué significa \"high\"?",
  "pregunta.chile.ingles.6.animals.7.a": "Alto",
  "pregunta.chile.ingles.6.animals.7.b": "Bajo",
  "pregunta.chile.ingles.6.animals.7.c": "Rápido",
  "pregunta.chile.ingles.6.animals.7.por_que": "Fly very high = volar muy alto.",
  "pregunta.chile.ingles.6.animals.8": "¿Cómo preguntas si sabe nadar?",
  "pregunta.chile.ingles.6.animals.8.a": "Do you can swim?",
  "pregunta.chile.ingles.6.animals.8.b": "Can you swim?",
  "pregunta.chile.ingles.6.animals.8.c": "You can swim?",
  "pregunta.chile.ingles.6.animals.8.por_que": "Can va al principio de la pregunta.",
  "pregunta.chile.ingles.6.animals.9": "¿Qué animal es \"horse\"?",
  "pregunta.chile.ingles.6.animals.9.a": "Vaca",
  "pregunta.chile.ingles.6.animals.9.b": "Oveja",
  "pregunta.chile.ingles.6.animals.9.c": "Caballo",
  "pregunta.chile.ingles.6.animals.9.por_que": "Cow = vaca, sheep = oveja.",
  "pregunta.chile.ingles.6.animals.10": "¿Qué significa \"big\"?",
  "pregunta.chile.ingles.6.animals.10.a": "Grande",
  "pregunta.chile.ingles.6.animals.10.b": "Chico",
  "pregunta.chile.ingles.6.animals.10.c": "Largo",
  "pregunta.chile.ingles.6.animals.10.por_que": "Small es chico.",
  "tema.chile.ingles.6.clothes": "Clothes and shopping",
  "tema.chile.ingles.6.clothes.texto": "In the shop: \"How much is this T-shirt?\" \"It's ten thousand pesos.\" \"Can I try it on?\" \"Yes, of course.\"\n\nIn winter I wear a jacket, a scarf and boots. In summer I wear shorts, a T-shirt and sandals.",
  "pregunta.chile.ingles.6.clothes.1": "¿Qué significa \"How much is it?\"",
  "pregunta.chile.ingles.6.clothes.1.a": "¿Cuánto cuesta?",
  "pregunta.chile.ingles.6.clothes.1.b": "¿Cuántos son?",
  "pregunta.chile.ingles.6.clothes.1.c": "¿Qué es?",
  "pregunta.chile.ingles.6.clothes.1.por_que": "How much = cuánto.",
  "pregunta.chile.ingles.6.clothes.2": "¿Qué usa en invierno?",
  "pregunta.chile.ingles.6.clothes.2.a": "Shorts y sandalias",
  "pregunta.chile.ingles.6.clothes.2.b": "Chaqueta, bufanda y botas",
  "pregunta.chile.ingles.6.clothes.2.c": "Traje de baño",
  "pregunta.chile.ingles.6.clothes.2.por_que": "Jacket, scarf and boots.",
  "pregunta.chile.ingles.6.clothes.3": "¿Qué significa \"try it on\"?",
  "pregunta.chile.ingles.6.clothes.3.a": "Comprarlo",
  "pregunta.chile.ingles.6.clothes.3.b": "Devolverlo",
  "pregunta.chile.ingles.6.clothes.3.c": "Probárselo",
  "pregunta.chile.ingles.6.clothes.3.por_que": "Se usa en la tienda con la ropa.",
  "pregunta.chile.ingles.6.clothes.4": "¿Qué es \"scarf\"?",
  "pregunta.chile.ingles.6.clothes.4.a": "Bufanda",
  "pregunta.chile.ingles.6.clothes.4.b": "Gorro",
  "pregunta.chile.ingles.6.clothes.4.c": "Guante",
  "pregunta.chile.ingles.6.clothes.4.por_que": "Hat = gorro, gloves = guantes.",
  "pregunta.chile.ingles.6.clothes.5": "¿Qué significa \"wear\"?",
  "pregunta.chile.ingles.6.clothes.5.a": "Lavar",
  "pregunta.chile.ingles.6.clothes.5.b": "Usar o llevar puesto",
  "pregunta.chile.ingles.6.clothes.5.c": "Comprar",
  "pregunta.chile.ingles.6.clothes.5.por_que": "I wear a jacket = uso una chaqueta.",
  "pregunta.chile.ingles.6.clothes.6": "¿Cuánto cuesta la polera?",
  "pregunta.chile.ingles.6.clothes.6.a": "Mil pesos",
  "pregunta.chile.ingles.6.clothes.6.b": "Cien mil pesos",
  "pregunta.chile.ingles.6.clothes.6.c": "Diez mil pesos",
  "pregunta.chile.ingles.6.clothes.6.por_que": "Ten thousand = diez mil.",
  "pregunta.chile.ingles.6.clothes.7": "¿Qué son \"shoes\"?",
  "pregunta.chile.ingles.6.clothes.7.a": "Zapatos",
  "pregunta.chile.ingles.6.clothes.7.b": "Calcetines",
  "pregunta.chile.ingles.6.clothes.7.c": "Pantalones",
  "pregunta.chile.ingles.6.clothes.7.por_que": "Socks = calcetines, trousers = pantalones.",
  "pregunta.chile.ingles.6.clothes.8": "Completa: \"These shoes ___ expensive.\"",
  "pregunta.chile.ingles.6.clothes.8.a": "is",
  "pregunta.chile.ingles.6.clothes.8.b": "are",
  "pregunta.chile.ingles.6.clothes.8.c": "am",
  "pregunta.chile.ingles.6.clothes.8.por_que": "These (plural) va con are.",
  "pregunta.chile.ingles.6.clothes.9": "¿Qué significa \"cheap\"?",
  "pregunta.chile.ingles.6.clothes.9.a": "Caro",
  "pregunta.chile.ingles.6.clothes.9.b": "Nuevo",
  "pregunta.chile.ingles.6.clothes.9.c": "Barato",
  "pregunta.chile.ingles.6.clothes.9.por_que": "Expensive = caro.",
  "pregunta.chile.ingles.6.clothes.10": "¿Qué ropa usas en verano?",
  "pregunta.chile.ingles.6.clothes.10.a": "Shorts and sandals",
  "pregunta.chile.ingles.6.clothes.10.b": "A coat and boots",
  "pregunta.chile.ingles.6.clothes.10.c": "A scarf and gloves",
  "pregunta.chile.ingles.6.clothes.10.por_que": "En verano hace calor."
}
