{
  "tema.chile.matematica.8.potencias": "Potencias y raíces",
  "tema.chile.matematica.8.potencias.texto": "Una potencia es una multiplicación repetida: 2⁵ = 2 × 2 × 2 × 2 × 2 = 32. El 2 es la base y el 5 el exponente. Cualquier número elevado a 0 es 1.\n\nLa raíz cuadrada es lo contrario de elevar al cuadrado: √49 = 7 porque 7² = 49. Al multiplicar enteros, signos iguales dan positivo y signos distintos dan negativo: (−3) × (−4) = 12.",
  "pregunta.chile.matematica.8.potencias.1": "¿Cuánto es 2⁵?",
  "pregunta.chile.matematica.8.potencias.1.a": "32",
  "pregunta.chile.matematica.8.potencias.1.b": "10",
  "pregunta.chile.matematica.8.potencias.1.c": "25",
  "pregunta.chile.matematica.8.potencias.1.por_que": "2 × 2 × 2 × 2 × 2.",
  "pregunta.chile.matematica.8.potencias.2": "¿Cuánto es 10³?",
  "pregunta.chile.matematica.8.potencias.2.a": "30",
  "pregunta.chile.matematica.8.potencias.2.b": "1 000",
  "pregunta.chile.matematica.8.potencias.2.c": "100",
  "pregunta.chile.matematica.8.potencias.2.por_que": "10 × 10 × 10.",
  "pregunta.chile.matematica.8.potencias.3": "¿Cuánto es 7⁰?",
  "pregunta.chile.matematica.8.potencias.3.a": "0",
  "pregunta.chile.matematica.8.potencias.3.b": "7",
  "pregunta.chile.matematica.8.potencias.3.c": "1",
  "pregunta.chile.matematica.8.potencias.3.por_que": "Todo número (distinto de 0) elevado a 0 es 1.",
  "pregunta.chile.matematica.8.potencias.4": "¿Cuánto es √49?",
  "pregunta.chile.matematica.8.potencias.4.a": "7",
  "pregunta.chile.matematica.8.potencias.4.b": "24,5",
  "pregunta.chile.matematica.8.potencias.4.c": "9",
  "pregunta.chile.matematica.8.potencias.4.por_que": "7 × 7 = 49.",
  "pregunta.chile.matematica.8.potencias.5": "¿Cuánto es √144?",
  "pregunta.chile.matematica.8.potencias.5.a": "14",
  "pregunta.chile.matematica.8.potencias.5.b": "12",
  "pregunta.chile.matematica.8.potencias.5.c": "72",
  "pregunta.chile.matematica.8.potencias.5.por_que": "12 × 12 = 144.",
  "pregunta.chile.matematica.8.potencias.6": "¿Cuánto es (−3) × (−4)?",
  "pregunta.chile.matematica.8.potencias.6.a": "−12",
  "pregunta.chile.matematica.8.potencias.6.b": "−7",
  "pregunta.chile.matematica.8.potencias.6.c": "12",
  "pregunta.chile.matematica.8.potencias.6.por_que": "Signos iguales dan positivo.",
  "pregunta.chile.matematica.8.potencias.7": "¿Cuánto es (−20) : 5?",
  "pregunta.chile.matematica.8.potencias.7.a": "−4",
  "pregunta.chile.matematica.8.potencias.7.b": "4",
  "pregunta.chile.matematica.8.potencias.7.c": "−15",
  "pregunta.chile.matematica.8.potencias.7.por_que": "Signos distintos dan negativo.",
  "pregunta.chile.matematica.8.potencias.8": "¿Cuánto es 3² + 4²?",
  "pregunta.chile.matematica.8.potencias.8.a": "49",
  "pregunta.chile.matematica.8.potencias.8.b": "25",
  "pregunta.chile.matematica.8.potencias.8.c": "14",
  "pregunta.chile.matematica.8.potencias.8.por_que": "9 + 16 = 25.",
  "pregunta.chile.matematica.8.potencias.9": "¿Cuánto es 2³ × 2²?",
  "pregunta.chile.matematica.8.potencias.9.a": "64",
  "pregunta.chile.matematica.8.potencias.9.b": "10",
  "pregunta.chile.matematica.8.potencias.9.c": "32",
  "pregunta.chile.matematica.8.potencias.9.por_que": "Se suman los exponentes: 2⁵.",
  "pregunta.chile.matematica.8.potencias.10": "¿Entre qué números enteros está √50?",
  "pregunta.chile.matematica.8.potencias.10.a": "7 y 8",
  "pregunta.chile.matematica.8.potencias.10.b": "5 y 6",
  "pregunta.chile.matematica.8.potencias.10.c": "25 y 26",
  "pregunta.chile.matematica.8.potencias.10.por_que": "7² = 49 y 8² = 64.",
  "tema.chile.matematica.8.funciones": "Funciones lineales",
  "tema.chile.matematica.8.funciones.texto": "Una función relaciona cada valor de x con un único valor de y. En la función lineal y = 3x, si x = 2 entonces y = 6. Su gráfico es una recta que pasa por el origen. En y = mx + n, m es la pendiente (cuánto sube por cada unidad) y n dónde corta el eje y.\n\nDos cantidades son directamente proporcionales si al duplicar una se duplica la otra: el precio de 3 kg de pan es el triple del de 1 kg.",
  "pregunta.chile.matematica.8.funciones.1": "En y = 3x, si x = 2, ¿cuánto vale y?",
  "pregunta.chile.matematica.8.funciones.1.a": "6",
  "pregunta.chile.matematica.8.funciones.1.b": "5",
  "pregunta.chile.matematica.8.funciones.1.c": "32",
  "pregunta.chile.matematica.8.funciones.1.por_que": "3 × 2 = 6.",
  "pregunta.chile.matematica.8.funciones.2": "En y = 2x + 1, si x = 4, ¿cuánto vale y?",
  "pregunta.chile.matematica.8.funciones.2.a": "8",
  "pregunta.chile.matematica.8.funciones.2.b": "9",
  "pregunta.chile.matematica.8.funciones.2.c": "7",
  "pregunta.chile.matematica.8.funciones.2.por_que": "2 × 4 + 1.",
  "pregunta.chile.matematica.8.funciones.3": "¿Qué forma tiene el gráfico de una función lineal?",
  "pregunta.chile.matematica.8.funciones.3.a": "Una parábola",
  "pregunta.chile.matematica.8.funciones.3.b": "Un círculo",
  "pregunta.chile.matematica.8.funciones.3.c": "Una recta",
  "pregunta.chile.matematica.8.funciones.3.por_que": "Por eso se llama lineal.",
  "pregunta.chile.matematica.8.funciones.4": "En y = 5x + 3, ¿cuál es la pendiente?",
  "pregunta.chile.matematica.8.funciones.4.a": "5",
  "pregunta.chile.matematica.8.funciones.4.b": "3",
  "pregunta.chile.matematica.8.funciones.4.c": "8",
  "pregunta.chile.matematica.8.funciones.4.por_que": "Es el número que multiplica a x.",
  "pregunta.chile.matematica.8.funciones.5": "En y = 5x + 3, ¿dónde corta el eje y?",
  "pregunta.chile.matematica.8.funciones.5.a": "En 5",
  "pregunta.chile.matematica.8.funciones.5.b": "En 3",
  "pregunta.chile.matematica.8.funciones.5.c": "En 0",
  "pregunta.chile.matematica.8.funciones.5.por_que": "Cuando x = 0, y = 3.",
  "pregunta.chile.matematica.8.funciones.6": "1 kg de pan cuesta $1 800. ¿Cuánto cuestan 3 kg?",
  "pregunta.chile.matematica.8.funciones.6.a": "$1 803",
  "pregunta.chile.matematica.8.funciones.6.b": "$3 600",
  "pregunta.chile.matematica.8.funciones.6.c": "$5 400",
  "pregunta.chile.matematica.8.funciones.6.por_que": "Es proporcional: 3 × 1 800.",
  "pregunta.chile.matematica.8.funciones.7": "Un taxi cobra $400 fijo más $200 por cuadra: y = 200x + 400. ¿Cuánto por 5 cuadras?",
  "pregunta.chile.matematica.8.funciones.7.a": "$1 400",
  "pregunta.chile.matematica.8.funciones.7.b": "$1 000",
  "pregunta.chile.matematica.8.funciones.7.c": "$600",
  "pregunta.chile.matematica.8.funciones.7.por_que": "200 × 5 + 400.",
  "pregunta.chile.matematica.8.funciones.8": "Si dos magnitudes son directamente proporcionales y una se duplica, ¿qué pasa con la otra?",
  "pregunta.chile.matematica.8.funciones.8.a": "Se reduce a la mitad",
  "pregunta.chile.matematica.8.funciones.8.b": "Se duplica",
  "pregunta.chile.matematica.8.funciones.8.c": "No cambia",
  "pregunta.chile.matematica.8.funciones.8.por_que": "Crecen en la misma razón.",
  "pregunta.chile.matematica.8.funciones.9": "¿Cuál función pasa por el origen (0, 0)?",
  "pregunta.chile.matematica.8.funciones.9.a": "y = 4x + 1",
  "pregunta.chile.matematica.8.funciones.9.b": "y = x − 2",
  "pregunta.chile.matematica.8.funciones.9.c": "y = 4x",
  "pregunta.chile.matematica.8.funciones.9.por_que": "Con x = 0 da y = 0.",
  "pregunta.chile.matematica.8.funciones.10": "Si y = −2x, ¿qué pasa con y cuando x aumenta?",
  "pregunta.chile.matematica.8.funciones.10.a": "Disminuye",
  "pregunta.chile.matematica.8.funciones.10.b": "Aumenta",
  "pregunta.chile.matematica.8.funciones.10.c": "Queda igual",
  "pregunta.chile.matematica.8.funciones.10.por_que": "La pendiente es negativa.",
  "tema.chile.matematica.8.pitagoras": "Pitágoras y volúmenes",
  "tema.chile.matematica.8.pitagoras.texto": "En un triángulo rectángulo, el lado más largo es la hipotenusa y los otros dos son catetos. El teorema de Pitágoras dice que cateto² + cateto² = hipotenusa²: con catetos 3 y 4, la hipotenusa es 5.\n\nEl volumen de un prisma es el área de la base por la altura. El de un cilindro es π × radio² × altura.",
  "pregunta.chile.matematica.8.pitagoras.1": "¿Cuál es la hipotenusa si los catetos miden 3 y 4?",
  "pregunta.chile.matematica.8.pitagoras.1.a": "5",
  "pregunta.chile.matematica.8.pitagoras.1.b": "7",
  "pregunta.chile.matematica.8.pitagoras.1.c": "12",
  "pregunta.chile.matematica.8.pitagoras.1.por_que": "9 + 16 = 25, √25 = 5.",
  "pregunta.chile.matematica.8.pitagoras.2": "¿Qué dice el teorema de Pitágoras?",
  "pregunta.chile.matematica.8.pitagoras.2.a": "Lado + lado = hipotenusa",
  "pregunta.chile.matematica.8.pitagoras.2.b": "Cateto² + cateto² = hipotenusa²",
  "pregunta.chile.matematica.8.pitagoras.2.c": "Base × altura : 2",
  "pregunta.chile.matematica.8.pitagoras.2.por_que": "Solo para triángulos rectángulos.",
  "pregunta.chile.matematica.8.pitagoras.3": "¿Cuál es la hipotenusa si los catetos miden 6 y 8?",
  "pregunta.chile.matematica.8.pitagoras.3.a": "14",
  "pregunta.chile.matematica.8.pitagoras.3.b": "48",
  "pregunta.chile.matematica.8.pitagoras.3.c": "10",
  "pregunta.chile.matematica.8.pitagoras.3.por_que": "36 + 64 = 100.",
  "pregunta.chile.matematica.8.pitagoras.4": "Si la hipotenusa mide 13 y un cateto 5, ¿cuánto mide el otro?",
  "pregunta.chile.matematica.8.pitagoras.4.a": "12",
  "pregunta.chile.matematica.8.pitagoras.4.b": "8",
  "pregunta.chile.matematica.8.pitagoras.4.c": "18",
  "pregunta.chile.matematica.8.pitagoras.4.por_que": "169 − 25 = 144.",
  "pregunta.chile.matematica.8.pitagoras.5": "¿Qué es la hipotenusa?",
  "pregunta.chile.matematica.8.pitagoras.5.a": "El lado más corto",
  "pregunta.chile.matematica.8.pitagoras.5.b": "El lado opuesto al ángulo recto, el más largo",
  "pregunta.chile.matematica.8.pitagoras.5.c": "La altura",
  "pregunta.chile.matematica.8.pitagoras.5.por_que": "Los otros dos son catetos.",
  "pregunta.chile.matematica.8.pitagoras.6": "¿Cuál es el volumen de un prisma con base de 10 cm² y altura 6 cm?",
  "pregunta.chile.matematica.8.pitagoras.6.a": "16 cm³",
  "pregunta.chile.matematica.8.pitagoras.6.b": "600 cm³",
  "pregunta.chile.matematica.8.pitagoras.6.c": "60 cm³",
  "pregunta.chile.matematica.8.pitagoras.6.por_que": "Área de la base × altura.",
  "pregunta.chile.matematica.8.pitagoras.7": "¿Cuál es el volumen de una caja de 2 × 3 × 4 cm?",
  "pregunta.chile.matematica.8.pitagoras.7.a": "24 cm³",
  "pregunta.chile.matematica.8.pitagoras.7.b": "9 cm³",
  "pregunta.chile.matematica.8.pitagoras.7.c": "20 cm³",
  "pregunta.chile.matematica.8.pitagoras.7.por_que": "Largo × ancho × alto.",
  "pregunta.chile.matematica.8.pitagoras.8": "¿Qué fórmula da el volumen de un cilindro?",
  "pregunta.chile.matematica.8.pitagoras.8.a": "2 × π × r",
  "pregunta.chile.matematica.8.pitagoras.8.b": "π × r² × h",
  "pregunta.chile.matematica.8.pitagoras.8.c": "π × r",
  "pregunta.chile.matematica.8.pitagoras.8.por_que": "Área del círculo por la altura.",
  "pregunta.chile.matematica.8.pitagoras.9": "¿Cuál es el volumen de un cilindro de radio 1 m y altura 2 m (π ≈ 3,14)?",
  "pregunta.chile.matematica.8.pitagoras.9.a": "3,14 m³",
  "pregunta.chile.matematica.8.pitagoras.9.b": "12,56 m³",
  "pregunta.chile.matematica.8.pitagoras.9.c": "6,28 m³",
  "pregunta.chile.matematica.8.pitagoras.9.por_que": "3,14 × 1 × 2.",
  "pregunta.chile.matematica.8.pitagoras.10": "¿Se cumple Pitágoras en 5, 12, 13?",
  "pregunta.chile.matematica.8.pitagoras.10.a": "Sí",
  "pregunta.chile.matematica.8.pitagoras.10.b": "No",
  "pregunta.chile.matematica.8.pitagoras.10.c": "Solo si es equilátero",
  "pregunta.chile.matematica.8.pitagoras.10.por_que": "25 + 144 = 169.",
  "tema.chile.matematica.8.datos": "Datos y probabilidades",
  "tema.chile.matematica.8.datos.texto": "Los cuartiles dividen datos ordenados en cuatro partes iguales: el segundo cuartil es la mediana. El rango es la diferencia entre el dato mayor y el menor.\n\nPara contar resultados posibles se usa el principio multiplicativo: si tienes 3 poleras y 2 pantalones, puedes armar 3 × 2 = 6 combinaciones. La probabilidad de dos sucesos independientes se obtiene multiplicando: sacar dos caras seguidas es 1/2 × 1/2 = 1/4.",
  "pregunta.chile.matematica.8.datos.1": "¿Qué cuartil es la mediana?",
  "pregunta.chile.matematica.8.datos.1.a": "El segundo cuartil",
  "pregunta.chile.matematica.8.datos.1.b": "El primero",
  "pregunta.chile.matematica.8.datos.1.c": "El cuarto",
  "pregunta.chile.matematica.8.datos.1.por_que": "Deja la mitad a cada lado.",
  "pregunta.chile.matematica.8.datos.2": "¿Cuál es el rango de 3, 8, 12 y 20?",
  "pregunta.chile.matematica.8.datos.2.a": "20",
  "pregunta.chile.matematica.8.datos.2.b": "17",
  "pregunta.chile.matematica.8.datos.2.c": "11",
  "pregunta.chile.matematica.8.datos.2.por_que": "20 − 3.",
  "pregunta.chile.matematica.8.datos.3": "Con 3 poleras y 2 pantalones, ¿cuántas combinaciones puedes armar?",
  "pregunta.chile.matematica.8.datos.3.a": "5",
  "pregunta.chile.matematica.8.datos.3.b": "9",
  "pregunta.chile.matematica.8.datos.3.c": "6",
  "pregunta.chile.matematica.8.datos.3.por_que": "Principio multiplicativo: 3 × 2.",
  "pregunta.chile.matematica.8.datos.4": "¿Cuál es la probabilidad de sacar dos caras seguidas con una moneda?",
  "pregunta.chile.matematica.8.datos.4.a": "1/4",
  "pregunta.chile.matematica.8.datos.4.b": "1/2",
  "pregunta.chile.matematica.8.datos.4.c": "2",
  "pregunta.chile.matematica.8.datos.4.por_que": "1/2 × 1/2.",
  "pregunta.chile.matematica.8.datos.5": "¿Cuántos resultados hay al lanzar dos dados?",
  "pregunta.chile.matematica.8.datos.5.a": "12",
  "pregunta.chile.matematica.8.datos.5.b": "36",
  "pregunta.chile.matematica.8.datos.5.c": "6",
  "pregunta.chile.matematica.8.datos.5.por_que": "6 × 6.",
  "pregunta.chile.matematica.8.datos.6": "Un candado tiene 3 ruedas con dígitos 0 a 9. ¿Cuántas claves posibles hay?",
  "pregunta.chile.matematica.8.datos.6.a": "30",
  "pregunta.chile.matematica.8.datos.6.b": "100",
  "pregunta.chile.matematica.8.datos.6.c": "1 000",
  "pregunta.chile.matematica.8.datos.6.por_que": "10 × 10 × 10.",
  "pregunta.chile.matematica.8.datos.7": "¿Qué divide en cuatro partes iguales un conjunto de datos?",
  "pregunta.chile.matematica.8.datos.7.a": "Los cuartiles",
  "pregunta.chile.matematica.8.datos.7.b": "La media",
  "pregunta.chile.matematica.8.datos.7.c": "La moda",
  "pregunta.chile.matematica.8.datos.7.por_que": "Q1, Q2 y Q3.",
  "pregunta.chile.matematica.8.datos.8": "¿Cuál es la probabilidad de sacar un número par con un dado?",
  "pregunta.chile.matematica.8.datos.8.a": "1/6",
  "pregunta.chile.matematica.8.datos.8.b": "1/2",
  "pregunta.chile.matematica.8.datos.8.c": "1/3",
  "pregunta.chile.matematica.8.datos.8.por_que": "3 de 6 caras.",
  "pregunta.chile.matematica.8.datos.9": "Si la probabilidad de lluvia es 0,3, ¿cuál es la de que no llueva?",
  "pregunta.chile.matematica.8.datos.9.a": "0,3",
  "pregunta.chile.matematica.8.datos.9.b": "1,3",
  "pregunta.chile.matematica.8.datos.9.c": "0,7",
  "pregunta.chile.matematica.8.datos.9.por_que": "1 − 0,3.",
  "pregunta.chile.matematica.8.datos.10": "¿Qué gráfico muestra mejor los cuartiles?",
  "pregunta.chile.matematica.8.datos.10.a": "El diagrama de cajón",
  "pregunta.chile.matematica.8.datos.10.b": "El gráfico circular",
  "pregunta.chile.matematica.8.datos.10.c": "El pictograma",
  "pregunta.chile.matematica.8.datos.10.por_que": "Muestra mínimo, cuartiles y máximo."
}
