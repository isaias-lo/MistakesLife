{
  "tema.chile.ingles.5.school": "My school",
  "tema.chile.ingles.5.school.texto": "At school we have a classroom, a library and a playground. In my pencil case I have a pencil, a rubber and a ruler.\n\nWe say \"Good morning, teacher!\" when we arrive. \"Open your book\", \"Sit down\" and \"Listen\" are classroom instructions.",
  "pregunta.chile.ingles.5.school.1": "¿Qué significa \"pencil case\"?",
  "pregunta.chile.ingles.5.school.1.a": "Estuche",
  "pregunta.chile.ingles.5.school.1.b": "Lápiz",
  "pregunta.chile.ingles.5.school.1.c": "Cuaderno",
  "pregunta.chile.ingles.5.school.1.por_que": "Pencil es lápiz y case es caja o estuche.",
  "pregunta.chile.ingles.5.school.2": "¿Qué significa \"Sit down\"?",
  "pregunta.chile.ingles.5.school.2.a": "Párate",
  "pregunta.chile.ingles.5.school.2.b": "Siéntate",
  "pregunta.chile.ingles.5.school.2.c": "Escucha",
  "pregunta.chile.ingles.5.school.2.por_que": "Sit = sentarse; stand up = pararse.",
  "pregunta.chile.ingles.5.school.3": "¿Cómo se dice \"biblioteca\" en inglés?",
  "pregunta.chile.ingles.5.school.3.a": "Bookstore",
  "pregunta.chile.ingles.5.school.3.b": "Classroom",
  "pregunta.chile.ingles.5.school.3.c": "Library",
  "pregunta.chile.ingles.5.school.3.por_que": "Ojo: library no es librería; librería es bookstore.",
  "pregunta.chile.ingles.5.school.4": "\"Open your book\" quiere decir...",
  "pregunta.chile.ingles.5.school.4.a": "Abre tu libro",
  "pregunta.chile.ingles.5.school.4.b": "Cierra tu libro",
  "pregunta.chile.ingles.5.school.4.c": "Lee tu libro en voz alta",
  "pregunta.chile.ingles.5.school.4.por_que": "Open = abrir, close = cerrar.",
  "pregunta.chile.ingles.5.school.5": "¿Qué es un \"ruler\"?",
  "pregunta.chile.ingles.5.school.5.a": "Una goma",
  "pregunta.chile.ingles.5.school.5.b": "Una regla",
  "pregunta.chile.ingles.5.school.5.c": "Una tijera",
  "pregunta.chile.ingles.5.school.5.por_que": "Rubber o eraser es la goma.",
  "pregunta.chile.ingles.5.school.6": "¿Cómo saludas a tu profesora en la mañana?",
  "pregunta.chile.ingles.5.school.6.a": "Good night, teacher!",
  "pregunta.chile.ingles.5.school.6.b": "Goodbye, teacher!",
  "pregunta.chile.ingles.5.school.6.c": "Good morning, teacher!",
  "pregunta.chile.ingles.5.school.6.por_que": "Good night es para despedirse en la noche.",
  "pregunta.chile.ingles.5.school.7": "¿Qué significa \"playground\"?",
  "pregunta.chile.ingles.5.school.7.a": "Patio de juegos",
  "pregunta.chile.ingles.5.school.7.b": "Sala de clases",
  "pregunta.chile.ingles.5.school.7.c": "Comedor",
  "pregunta.chile.ingles.5.school.7.por_que": "Play = jugar, ground = suelo.",
  "pregunta.chile.ingles.5.school.8": "Completa: \"This ___ my pencil.\"",
  "pregunta.chile.ingles.5.school.8.a": "are",
  "pregunta.chile.ingles.5.school.8.b": "is",
  "pregunta.chile.ingles.5.school.8.c": "am",
  "pregunta.chile.ingles.5.school.8.por_que": "Con this (singular) va is.",
  "pregunta.chile.ingles.5.school.9": "¿Qué significa \"Listen\"?",
  "pregunta.chile.ingles.5.school.9.a": "Escribe",
  "pregunta.chile.ingles.5.school.9.b": "Mira",
  "pregunta.chile.ingles.5.school.9.c": "Escucha",
  "pregunta.chile.ingles.5.school.9.por_que": "Write = escribe, look = mira.",
  "pregunta.chile.ingles.5.school.10": "¿Cuál es el plural de \"book\"?",
  "pregunta.chile.ingles.5.school.10.a": "Books",
  "pregunta.chile.ingles.5.school.10.b": "Bookes",
  "pregunta.chile.ingles.5.school.10.c": "Book",
  "pregunta.chile.ingles.5.school.10.por_que": "La mayoría de los plurales agrega -s.",
  "tema.chile.ingles.5.family": "My family and me",
  "tema.chile.ingles.5.family.texto": "Hi! My name is Tomás. I am ten years old. I have got a sister and a brother. My mother is a nurse and my father is a bus driver.\n\nI live in Santiago with my family and my dog, Bobby. My grandmother lives with us too.",
  "pregunta.chile.ingles.5.family.1": "¿Cuántos años tiene Tomás?",
  "pregunta.chile.ingles.5.family.1.a": "Diez",
  "pregunta.chile.ingles.5.family.1.b": "Doce",
  "pregunta.chile.ingles.5.family.1.c": "Nueve",
  "pregunta.chile.ingles.5.family.1.por_que": "\"I am ten years old\".",
  "pregunta.chile.ingles.5.family.2": "¿En qué trabaja la mamá de Tomás?",
  "pregunta.chile.ingles.5.family.2.a": "Es profesora",
  "pregunta.chile.ingles.5.family.2.b": "Es enfermera",
  "pregunta.chile.ingles.5.family.2.c": "Es conductora",
  "pregunta.chile.ingles.5.family.2.por_que": "Nurse = enfermera.",
  "pregunta.chile.ingles.5.family.3": "¿Qué significa \"brother\"?",
  "pregunta.chile.ingles.5.family.3.a": "Hermana",
  "pregunta.chile.ingles.5.family.3.b": "Primo",
  "pregunta.chile.ingles.5.family.3.c": "Hermano",
  "pregunta.chile.ingles.5.family.3.por_que": "Sister es hermana.",
  "pregunta.chile.ingles.5.family.4": "¿Cómo se llama el perro?",
  "pregunta.chile.ingles.5.family.4.a": "Bobby",
  "pregunta.chile.ingles.5.family.4.b": "Tomás",
  "pregunta.chile.ingles.5.family.4.c": "Santiago",
  "pregunta.chile.ingles.5.family.4.por_que": "\"My dog, Bobby\".",
  "pregunta.chile.ingles.5.family.5": "¿Quién más vive con la familia?",
  "pregunta.chile.ingles.5.family.5.a": "El tío",
  "pregunta.chile.ingles.5.family.5.b": "La abuela",
  "pregunta.chile.ingles.5.family.5.c": "La prima",
  "pregunta.chile.ingles.5.family.5.por_que": "\"My grandmother lives with us\".",
  "pregunta.chile.ingles.5.family.6": "¿Cómo se dice \"me llamo Ana\"?",
  "pregunta.chile.ingles.5.family.6.a": "I am name Ana",
  "pregunta.chile.ingles.5.family.6.b": "Ana my name",
  "pregunta.chile.ingles.5.family.6.c": "My name is Ana",
  "pregunta.chile.ingles.5.family.6.por_que": "My name is... es la forma correcta.",
  "pregunta.chile.ingles.5.family.7": "Completa: \"She ___ my mother.\"",
  "pregunta.chile.ingles.5.family.7.a": "is",
  "pregunta.chile.ingles.5.family.7.b": "are",
  "pregunta.chile.ingles.5.family.7.c": "am",
  "pregunta.chile.ingles.5.family.7.por_que": "Con she va is.",
  "pregunta.chile.ingles.5.family.8": "¿Qué significa \"father\"?",
  "pregunta.chile.ingles.5.family.8.a": "Abuelo",
  "pregunta.chile.ingles.5.family.8.b": "Papá",
  "pregunta.chile.ingles.5.family.8.c": "Tío",
  "pregunta.chile.ingles.5.family.8.por_que": "Mother es mamá.",
  "pregunta.chile.ingles.5.family.9": "¿Cómo se pregunta la edad?",
  "pregunta.chile.ingles.5.family.9.a": "What is your name?",
  "pregunta.chile.ingles.5.family.9.b": "Where are you from?",
  "pregunta.chile.ingles.5.family.9.c": "How old are you?",
  "pregunta.chile.ingles.5.family.9.por_que": "How old = qué edad.",
  "pregunta.chile.ingles.5.family.10": "¿Qué significa \"I have got a sister\"?",
  "pregunta.chile.ingles.5.family.10.a": "Tengo una hermana",
  "pregunta.chile.ingles.5.family.10.b": "Soy una hermana",
  "pregunta.chile.ingles.5.family.10.c": "Veo a mi hermana",
  "pregunta.chile.ingles.5.family.10.por_que": "Have got = tener.",
  "tema.chile.ingles.5.food": "Food and likes",
  "tema.chile.ingles.5.food.texto": "I like apples and bananas, but I don't like onions. For breakfast I have bread and milk. For lunch I eat rice, chicken and salad.\n\n\"Do you like pizza?\" \"Yes, I do!\" or \"No, I don't.\"",
  "pregunta.chile.ingles.5.food.1": "¿Qué no le gusta?",
  "pregunta.chile.ingles.5.food.1.a": "Las cebollas",
  "pregunta.chile.ingles.5.food.1.b": "Las manzanas",
  "pregunta.chile.ingles.5.food.1.c": "Los plátanos",
  "pregunta.chile.ingles.5.food.1.por_que": "\"I don't like onions\".",
  "pregunta.chile.ingles.5.food.2": "¿Qué toma al desayuno?",
  "pregunta.chile.ingles.5.food.2.a": "Arroz y pollo",
  "pregunta.chile.ingles.5.food.2.b": "Pan y leche",
  "pregunta.chile.ingles.5.food.2.c": "Pizza",
  "pregunta.chile.ingles.5.food.2.por_que": "Breakfast = desayuno.",
  "pregunta.chile.ingles.5.food.3": "¿Qué significa \"lunch\"?",
  "pregunta.chile.ingles.5.food.3.a": "Cena",
  "pregunta.chile.ingles.5.food.3.b": "Desayuno",
  "pregunta.chile.ingles.5.food.3.c": "Almuerzo",
  "pregunta.chile.ingles.5.food.3.por_que": "Dinner es la cena.",
  "pregunta.chile.ingles.5.food.4": "¿Cómo respondes que sí te gusta?",
  "pregunta.chile.ingles.5.food.4.a": "Yes, I do!",
  "pregunta.chile.ingles.5.food.4.b": "Yes, I am!",
  "pregunta.chile.ingles.5.food.4.c": "Yes, I like!",
  "pregunta.chile.ingles.5.food.4.por_que": "A una pregunta con do se responde con do.",
  "pregunta.chile.ingles.5.food.5": "¿Qué significa \"chicken\"?",
  "pregunta.chile.ingles.5.food.5.a": "Pescado",
  "pregunta.chile.ingles.5.food.5.b": "Pollo",
  "pregunta.chile.ingles.5.food.5.c": "Carne de vacuno",
  "pregunta.chile.ingles.5.food.5.por_que": "Fish = pescado, beef = vacuno.",
  "pregunta.chile.ingles.5.food.6": "¿Cómo dices \"no me gusta el queso\"?",
  "pregunta.chile.ingles.5.food.6.a": "I not like cheese",
  "pregunta.chile.ingles.5.food.6.b": "I doesn't like cheese",
  "pregunta.chile.ingles.5.food.6.c": "I don't like cheese",
  "pregunta.chile.ingles.5.food.6.por_que": "Con I se usa don't.",
  "pregunta.chile.ingles.5.food.7": "¿Qué es \"water\"?",
  "pregunta.chile.ingles.5.food.7.a": "Agua",
  "pregunta.chile.ingles.5.food.7.b": "Leche",
  "pregunta.chile.ingles.5.food.7.c": "Jugo",
  "pregunta.chile.ingles.5.food.7.por_que": "Milk = leche, juice = jugo.",
  "pregunta.chile.ingles.5.food.8": "¿Cuál es una fruta?",
  "pregunta.chile.ingles.5.food.8.a": "Rice",
  "pregunta.chile.ingles.5.food.8.b": "Apple",
  "pregunta.chile.ingles.5.food.8.c": "Bread",
  "pregunta.chile.ingles.5.food.8.por_que": "Apple = manzana.",
  "pregunta.chile.ingles.5.food.9": "Completa: \"Do you like bananas?\" \"No, I ___.\"",
  "pregunta.chile.ingles.5.food.9.a": "doesn't",
  "pregunta.chile.ingles.5.food.9.b": "not",
  "pregunta.chile.ingles.5.food.9.c": "don't",
  "pregunta.chile.ingles.5.food.9.por_que": "Se repite el auxiliar: don't.",
  "pregunta.chile.ingles.5.food.10": "¿Qué significa \"salad\"?",
  "pregunta.chile.ingles.5.food.10.a": "Ensalada",
  "pregunta.chile.ingles.5.food.10.b": "Sal",
  "pregunta.chile.ingles.5.food.10.c": "Sopa",
  "pregunta.chile.ingles.5.food.10.por_que": "Soup es sopa.",
  "tema.chile.ingles.5.routine": "Days, time and the weather",
  "tema.chile.ingles.5.routine.texto": "On Monday I go to school at eight o'clock. On Saturday I play football in the park. On Sunday I visit my grandparents.\n\nToday it is sunny and hot. In winter it is cold and rainy in Santiago.",
  "pregunta.chile.ingles.5.routine.1": "¿A qué hora va al colegio?",
  "pregunta.chile.ingles.5.routine.1.a": "A las ocho",
  "pregunta.chile.ingles.5.routine.1.b": "A las diez",
  "pregunta.chile.ingles.5.routine.1.c": "A las siete",
  "pregunta.chile.ingles.5.routine.1.por_que": "\"At eight o'clock\".",
  "pregunta.chile.ingles.5.routine.2": "¿Qué hace el sábado?",
  "pregunta.chile.ingles.5.routine.2.a": "Visita a sus abuelos",
  "pregunta.chile.ingles.5.routine.2.b": "Juega fútbol en el parque",
  "pregunta.chile.ingles.5.routine.2.c": "Va al colegio",
  "pregunta.chile.ingles.5.routine.2.por_que": "On Saturday I play football.",
  "pregunta.chile.ingles.5.routine.3": "¿Qué significa \"sunny\"?",
  "pregunta.chile.ingles.5.routine.3.a": "Lluvioso",
  "pregunta.chile.ingles.5.routine.3.b": "Nublado",
  "pregunta.chile.ingles.5.routine.3.c": "Soleado",
  "pregunta.chile.ingles.5.routine.3.por_que": "Sun = sol.",
  "pregunta.chile.ingles.5.routine.4": "¿Cómo es el invierno en Santiago según el texto?",
  "pregunta.chile.ingles.5.routine.4.a": "Frío y lluvioso",
  "pregunta.chile.ingles.5.routine.4.b": "Caluroso y soleado",
  "pregunta.chile.ingles.5.routine.4.c": "Con nieve todo el día",
  "pregunta.chile.ingles.5.routine.4.por_que": "Cold and rainy.",
  "pregunta.chile.ingles.5.routine.5": "¿Qué día va después de Monday?",
  "pregunta.chile.ingles.5.routine.5.a": "Sunday",
  "pregunta.chile.ingles.5.routine.5.b": "Tuesday",
  "pregunta.chile.ingles.5.routine.5.c": "Friday",
  "pregunta.chile.ingles.5.routine.5.por_que": "Monday, Tuesday, Wednesday...",
  "pregunta.chile.ingles.5.routine.6": "¿Qué significa \"hot\"?",
  "pregunta.chile.ingles.5.routine.6.a": "Frío",
  "pregunta.chile.ingles.5.routine.6.b": "Ventoso",
  "pregunta.chile.ingles.5.routine.6.c": "Caluroso",
  "pregunta.chile.ingles.5.routine.6.por_que": "Cold = frío.",
  "pregunta.chile.ingles.5.routine.7": "¿Cómo se dice \"domingo\"?",
  "pregunta.chile.ingles.5.routine.7.a": "Sunday",
  "pregunta.chile.ingles.5.routine.7.b": "Saturday",
  "pregunta.chile.ingles.5.routine.7.c": "Monday",
  "pregunta.chile.ingles.5.routine.7.por_que": "Saturday es sábado.",
  "pregunta.chile.ingles.5.routine.8": "¿Qué significa \"I visit my grandparents\"?",
  "pregunta.chile.ingles.5.routine.8.a": "Vivo con mis abuelos",
  "pregunta.chile.ingles.5.routine.8.b": "Visito a mis abuelos",
  "pregunta.chile.ingles.5.routine.8.c": "Llamo a mis padres",
  "pregunta.chile.ingles.5.routine.8.por_que": "Grandparents = abuelos.",
  "pregunta.chile.ingles.5.routine.9": "¿Cómo preguntas la hora?",
  "pregunta.chile.ingles.5.routine.9.a": "How old is it?",
  "pregunta.chile.ingles.5.routine.9.b": "Where is the time?",
  "pregunta.chile.ingles.5.routine.9.c": "What time is it?",
  "pregunta.chile.ingles.5.routine.9.por_que": "What time = qué hora.",
  "pregunta.chile.ingles.5.routine.10": "¿Qué significa \"rainy\"?",
  "pregunta.chile.ingles.5.routine.10.a": "Lluvioso",
  "pregunta.chile.ingles.5.routine.10.b": "Soleado",
  "pregunta.chile.ingles.5.routine.10.c": "Caluroso",
  "pregunta.chile.ingles.5.routine.10.por_que": "Rain = lluvia."
}
