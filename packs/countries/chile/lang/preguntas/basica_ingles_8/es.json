{
  "tema.chile.ingles.8.experiences": "Life experiences",
  "tema.chile.ingles.8.experiences.texto": "Have you ever been to another country? Martín has visited Argentina and Peru, but he has never flown in a plane: he travelled by bus.\n\nThe present perfect (have + past participle) talks about experiences without saying exactly when: I have seen the sea.",
  "pregunta.chile.ingles.8.experiences.1": "¿Qué países ha visitado Martín?",
  "pregunta.chile.ingles.8.experiences.1.a": "Argentina y Perú",
  "pregunta.chile.ingles.8.experiences.1.b": "Brasil y Bolivia",
  "pregunta.chile.ingles.8.experiences.1.c": "Estados Unidos",
  "pregunta.chile.ingles.8.experiences.1.por_que": "He has visited Argentina and Peru.",
  "pregunta.chile.ingles.8.experiences.2": "¿Cómo viajó?",
  "pregunta.chile.ingles.8.experiences.2.a": "En avión",
  "pregunta.chile.ingles.8.experiences.2.b": "En bus",
  "pregunta.chile.ingles.8.experiences.2.c": "En barco",
  "pregunta.chile.ingles.8.experiences.2.por_que": "He travelled by bus.",
  "pregunta.chile.ingles.8.experiences.3": "¿Qué significa \"Have you ever...?\"",
  "pregunta.chile.ingles.8.experiences.3.a": "¿Siempre has...?",
  "pregunta.chile.ingles.8.experiences.3.b": "¿Nunca vas a...?",
  "pregunta.chile.ingles.8.experiences.3.c": "¿Alguna vez has...?",
  "pregunta.chile.ingles.8.experiences.3.por_que": "Ever pregunta por experiencias.",
  "pregunta.chile.ingles.8.experiences.4": "¿Cuál es correcto?",
  "pregunta.chile.ingles.8.experiences.4.a": "I have seen that movie",
  "pregunta.chile.ingles.8.experiences.4.b": "I have saw that movie",
  "pregunta.chile.ingles.8.experiences.4.c": "I has seen that movie",
  "pregunta.chile.ingles.8.experiences.4.por_que": "Have + participio (seen).",
  "pregunta.chile.ingles.8.experiences.5": "Completa: \"She ___ never eaten sushi.\"",
  "pregunta.chile.ingles.8.experiences.5.a": "have",
  "pregunta.chile.ingles.8.experiences.5.b": "has",
  "pregunta.chile.ingles.8.experiences.5.c": "is",
  "pregunta.chile.ingles.8.experiences.5.por_que": "Con she: has.",
  "pregunta.chile.ingles.8.experiences.6": "¿Cuál es el participio de \"go\"?",
  "pregunta.chile.ingles.8.experiences.6.a": "Went",
  "pregunta.chile.ingles.8.experiences.6.b": "Goed",
  "pregunta.chile.ingles.8.experiences.6.c": "Gone",
  "pregunta.chile.ingles.8.experiences.6.por_que": "Go, went, gone.",
  "pregunta.chile.ingles.8.experiences.7": "¿Qué significa \"never\"?",
  "pregunta.chile.ingles.8.experiences.7.a": "Nunca",
  "pregunta.chile.ingles.8.experiences.7.b": "Siempre",
  "pregunta.chile.ingles.8.experiences.7.c": "Ya",
  "pregunta.chile.ingles.8.experiences.7.por_que": "He has never flown.",
  "pregunta.chile.ingles.8.experiences.8": "¿Cuál es el participio de \"write\"?",
  "pregunta.chile.ingles.8.experiences.8.a": "Wrote",
  "pregunta.chile.ingles.8.experiences.8.b": "Written",
  "pregunta.chile.ingles.8.experiences.8.c": "Writed",
  "pregunta.chile.ingles.8.experiences.8.por_que": "Write, wrote, written.",
  "pregunta.chile.ingles.8.experiences.9": "¿Qué significa \"already\"?",
  "pregunta.chile.ingles.8.experiences.9.a": "Todavía no",
  "pregunta.chile.ingles.8.experiences.9.b": "Nunca",
  "pregunta.chile.ingles.8.experiences.9.c": "Ya",
  "pregunta.chile.ingles.8.experiences.9.por_que": "I have already finished = ya terminé.",
  "pregunta.chile.ingles.8.experiences.10": "¿Qué significa \"yet\" en una negación?",
  "pregunta.chile.ingles.8.experiences.10.a": "Todavía",
  "pregunta.chile.ingles.8.experiences.10.b": "Ya",
  "pregunta.chile.ingles.8.experiences.10.c": "Siempre",
  "pregunta.chile.ingles.8.experiences.10.por_que": "I haven't finished yet = todavía no termino.",
  "tema.chile.ingles.8.technology": "Technology and social media",
  "tema.chile.ingles.8.technology.texto": "Many teenagers use social media every day. It helps them to stay in touch with friends, but it can also be a problem: some people spend too much time online and don't sleep enough.\n\nNever share your password, and think before you post a photo.",
  "pregunta.chile.ingles.8.technology.1": "¿Qué ventaja menciona el texto?",
  "pregunta.chile.ingles.8.technology.1.a": "Mantenerse en contacto con amigos",
  "pregunta.chile.ingles.8.technology.1.b": "Dormir más",
  "pregunta.chile.ingles.8.technology.1.c": "Ganar dinero",
  "pregunta.chile.ingles.8.technology.1.por_que": "Stay in touch with friends.",
  "pregunta.chile.ingles.8.technology.2": "¿Qué problema menciona?",
  "pregunta.chile.ingles.8.technology.2.a": "Que es muy caro",
  "pregunta.chile.ingles.8.technology.2.b": "Pasar demasiado tiempo en línea y dormir poco",
  "pregunta.chile.ingles.8.technology.2.c": "Que no hay internet",
  "pregunta.chile.ingles.8.technology.2.por_que": "Spend too much time online.",
  "pregunta.chile.ingles.8.technology.3": "¿Qué consejo da?",
  "pregunta.chile.ingles.8.technology.3.a": "Publicar todo",
  "pregunta.chile.ingles.8.technology.3.b": "Compartir tu dirección",
  "pregunta.chile.ingles.8.technology.3.c": "Nunca compartir tu contraseña",
  "pregunta.chile.ingles.8.technology.3.por_que": "Never share your password.",
  "pregunta.chile.ingles.8.technology.4": "¿Qué significa \"teenagers\"?",
  "pregunta.chile.ingles.8.technology.4.a": "Adolescentes",
  "pregunta.chile.ingles.8.technology.4.b": "Profesores",
  "pregunta.chile.ingles.8.technology.4.c": "Niños pequeños",
  "pregunta.chile.ingles.8.technology.4.por_que": "De 13 a 19 años (thirteen to nineteen).",
  "pregunta.chile.ingles.8.technology.5": "¿Qué significa \"think before you post\"?",
  "pregunta.chile.ingles.8.technology.5.a": "Publica rápido",
  "pregunta.chile.ingles.8.technology.5.b": "Piensa antes de publicar",
  "pregunta.chile.ingles.8.technology.5.c": "No pienses",
  "pregunta.chile.ingles.8.technology.5.por_que": "Post = publicar.",
  "pregunta.chile.ingles.8.technology.6": "¿Qué significa \"online\"?",
  "pregunta.chile.ingles.8.technology.6.a": "Apagado",
  "pregunta.chile.ingles.8.technology.6.b": "En fila",
  "pregunta.chile.ingles.8.technology.6.c": "En línea, conectado",
  "pregunta.chile.ingles.8.technology.6.por_que": "Offline = desconectado.",
  "pregunta.chile.ingles.8.technology.7": "Completa: \"Social media can ___ dangerous.\"",
  "pregunta.chile.ingles.8.technology.7.a": "be",
  "pregunta.chile.ingles.8.technology.7.b": "is",
  "pregunta.chile.ingles.8.technology.7.c": "being",
  "pregunta.chile.ingles.8.technology.7.por_que": "Después de can va el verbo base.",
  "pregunta.chile.ingles.8.technology.8": "¿Qué significa \"enough\"?",
  "pregunta.chile.ingles.8.technology.8.a": "Demasiado",
  "pregunta.chile.ingles.8.technology.8.b": "Suficiente",
  "pregunta.chile.ingles.8.technology.8.c": "Poco",
  "pregunta.chile.ingles.8.technology.8.por_que": "Don't sleep enough = no duermen lo suficiente.",
  "pregunta.chile.ingles.8.technology.9": "¿Qué significa \"password\"?",
  "pregunta.chile.ingles.8.technology.9.a": "Pasaporte",
  "pregunta.chile.ingles.8.technology.9.b": "Mensaje",
  "pregunta.chile.ingles.8.technology.9.c": "Contraseña",
  "pregunta.chile.ingles.8.technology.9.por_que": "Sirve para entrar a una cuenta.",
  "pregunta.chile.ingles.8.technology.10": "¿Qué significa \"too much\"?",
  "pregunta.chile.ingles.8.technology.10.a": "Demasiado",
  "pregunta.chile.ingles.8.technology.10.b": "Muy poco",
  "pregunta.chile.ingles.8.technology.10.c": "Nada",
  "pregunta.chile.ingles.8.technology.10.por_que": "Too much time = demasiado tiempo.",
  "tema.chile.ingles.8.comparisons": "Comparing things",
  "tema.chile.ingles.8.comparisons.texto": "Santiago is bigger than Valparaíso, but Valparaíso is more colourful. The Atacama Desert is the driest desert in the world.\n\nShort adjectives add -er and -est (big, bigger, the biggest). Long adjectives use more and the most (more interesting, the most interesting).",
  "pregunta.chile.ingles.8.comparisons.1": "Según el texto, ¿cuál es más grande?",
  "pregunta.chile.ingles.8.comparisons.1.a": "Santiago",
  "pregunta.chile.ingles.8.comparisons.1.b": "Valparaíso",
  "pregunta.chile.ingles.8.comparisons.1.c": "Son iguales",
  "pregunta.chile.ingles.8.comparisons.1.por_que": "Santiago is bigger than Valparaíso.",
  "pregunta.chile.ingles.8.comparisons.2": "¿Qué es el desierto de Atacama?",
  "pregunta.chile.ingles.8.comparisons.2.a": "El más grande del mundo",
  "pregunta.chile.ingles.8.comparisons.2.b": "El más seco del mundo",
  "pregunta.chile.ingles.8.comparisons.2.c": "El más frío",
  "pregunta.chile.ingles.8.comparisons.2.por_que": "The driest desert.",
  "pregunta.chile.ingles.8.comparisons.3": "¿Cuál es el comparativo de \"tall\"?",
  "pregunta.chile.ingles.8.comparisons.3.a": "More tall",
  "pregunta.chile.ingles.8.comparisons.3.b": "Tallest",
  "pregunta.chile.ingles.8.comparisons.3.c": "Taller",
  "pregunta.chile.ingles.8.comparisons.3.por_que": "Adjetivo corto: -er.",
  "pregunta.chile.ingles.8.comparisons.4": "¿Cuál es el superlativo de \"interesting\"?",
  "pregunta.chile.ingles.8.comparisons.4.a": "The most interesting",
  "pregunta.chile.ingles.8.comparisons.4.b": "The interestingest",
  "pregunta.chile.ingles.8.comparisons.4.c": "More interesting",
  "pregunta.chile.ingles.8.comparisons.4.por_que": "Adjetivo largo: the most.",
  "pregunta.chile.ingles.8.comparisons.5": "¿Cuál es el comparativo de \"good\"?",
  "pregunta.chile.ingles.8.comparisons.5.a": "Gooder",
  "pregunta.chile.ingles.8.comparisons.5.b": "Better",
  "pregunta.chile.ingles.8.comparisons.5.c": "Best",
  "pregunta.chile.ingles.8.comparisons.5.por_que": "Irregular: good, better, the best.",
  "pregunta.chile.ingles.8.comparisons.6": "¿Cuál es el superlativo de \"bad\"?",
  "pregunta.chile.ingles.8.comparisons.6.a": "The baddest",
  "pregunta.chile.ingles.8.comparisons.6.b": "Worse",
  "pregunta.chile.ingles.8.comparisons.6.c": "The worst",
  "pregunta.chile.ingles.8.comparisons.6.por_que": "Bad, worse, the worst.",
  "pregunta.chile.ingles.8.comparisons.7": "Completa: \"A car is ___ than a bike.\"",
  "pregunta.chile.ingles.8.comparisons.7.a": "faster",
  "pregunta.chile.ingles.8.comparisons.7.b": "fastest",
  "pregunta.chile.ingles.8.comparisons.7.c": "more fast",
  "pregunta.chile.ingles.8.comparisons.7.por_que": "Comparativo de fast.",
  "pregunta.chile.ingles.8.comparisons.8": "¿Qué significa \"than\"?",
  "pregunta.chile.ingles.8.comparisons.8.a": "Entonces",
  "pregunta.chile.ingles.8.comparisons.8.b": "Que (en comparaciones)",
  "pregunta.chile.ingles.8.comparisons.8.c": "Gracias",
  "pregunta.chile.ingles.8.comparisons.8.por_que": "Bigger than = más grande que.",
  "pregunta.chile.ingles.8.comparisons.9": "¿Cuál es correcto?",
  "pregunta.chile.ingles.8.comparisons.9.a": "Math is difficulter than art",
  "pregunta.chile.ingles.8.comparisons.9.b": "Math is most difficult than art",
  "pregunta.chile.ingles.8.comparisons.9.c": "Math is more difficult than art",
  "pregunta.chile.ingles.8.comparisons.9.por_que": "Difficult es largo: more.",
  "pregunta.chile.ingles.8.comparisons.10": "¿Cuál es el comparativo de \"big\"?",
  "pregunta.chile.ingles.8.comparisons.10.a": "Bigger",
  "pregunta.chile.ingles.8.comparisons.10.b": "Biger",
  "pregunta.chile.ingles.8.comparisons.10.c": "More big",
  "pregunta.chile.ingles.8.comparisons.10.por_que": "Se duplica la consonante final: bigger.",
  "tema.chile.ingles.8.jobs": "Jobs and the future",
  "tema.chile.ingles.8.jobs.texto": "When I grow up, I would like to be a doctor because I want to help people. My sister wants to be an engineer; she is good at maths.\n\nTo talk about jobs we ask: \"What do you want to be?\" and \"What does your mother do?\" \"She's an accountant.\"",
  "pregunta.chile.ingles.8.jobs.1": "¿Qué quiere ser el que escribe?",
  "pregunta.chile.ingles.8.jobs.1.a": "Doctor",
  "pregunta.chile.ingles.8.jobs.1.b": "Ingeniero",
  "pregunta.chile.ingles.8.jobs.1.c": "Contador",
  "pregunta.chile.ingles.8.jobs.1.por_que": "I would like to be a doctor.",
  "pregunta.chile.ingles.8.jobs.2": "¿Por qué?",
  "pregunta.chile.ingles.8.jobs.2.a": "Porque gana mucho",
  "pregunta.chile.ingles.8.jobs.2.b": "Porque quiere ayudar a la gente",
  "pregunta.chile.ingles.8.jobs.2.c": "Porque es fácil",
  "pregunta.chile.ingles.8.jobs.2.por_que": "Because I want to help people.",
  "pregunta.chile.ingles.8.jobs.3": "¿Qué quiere ser su hermana?",
  "pregunta.chile.ingles.8.jobs.3.a": "Doctora",
  "pregunta.chile.ingles.8.jobs.3.b": "Profesora",
  "pregunta.chile.ingles.8.jobs.3.c": "Ingeniera",
  "pregunta.chile.ingles.8.jobs.3.por_que": "An engineer.",
  "pregunta.chile.ingles.8.jobs.4": "¿Qué significa \"accountant\"?",
  "pregunta.chile.ingles.8.jobs.4.a": "Contador o contadora",
  "pregunta.chile.ingles.8.jobs.4.b": "Abogado",
  "pregunta.chile.ingles.8.jobs.4.c": "Cocinero",
  "pregunta.chile.ingles.8.jobs.4.por_que": "Lleva las cuentas de una empresa.",
  "pregunta.chile.ingles.8.jobs.5": "¿Qué significa \"What does your mother do?\"",
  "pregunta.chile.ingles.8.jobs.5.a": "¿Qué hace tu mamá ahora?",
  "pregunta.chile.ingles.8.jobs.5.b": "¿En qué trabaja tu mamá?",
  "pregunta.chile.ingles.8.jobs.5.c": "¿Cómo está tu mamá?",
  "pregunta.chile.ingles.8.jobs.5.por_que": "Pregunta por su trabajo.",
  "pregunta.chile.ingles.8.jobs.6": "¿Qué significa \"I would like to\"?",
  "pregunta.chile.ingles.8.jobs.6.a": "Me gusta",
  "pregunta.chile.ingles.8.jobs.6.b": "Tengo que",
  "pregunta.chile.ingles.8.jobs.6.c": "Me gustaría",
  "pregunta.chile.ingles.8.jobs.6.por_que": "Would like = desear.",
  "pregunta.chile.ingles.8.jobs.7": "¿Qué significa \"when I grow up\"?",
  "pregunta.chile.ingles.8.jobs.7.a": "Cuando sea grande",
  "pregunta.chile.ingles.8.jobs.7.b": "Cuando me levante",
  "pregunta.chile.ingles.8.jobs.7.c": "Cuando llegue",
  "pregunta.chile.ingles.8.jobs.7.por_que": "Grow up = crecer.",
  "pregunta.chile.ingles.8.jobs.8": "¿Qué hace un \"firefighter\"?",
  "pregunta.chile.ingles.8.jobs.8.a": "Cocina",
  "pregunta.chile.ingles.8.jobs.8.b": "Apaga incendios",
  "pregunta.chile.ingles.8.jobs.8.c": "Enseña",
  "pregunta.chile.ingles.8.jobs.8.por_que": "Fire = fuego.",
  "pregunta.chile.ingles.8.jobs.9": "¿Qué significa \"good at maths\"?",
  "pregunta.chile.ingles.8.jobs.9.a": "Mala para las matemáticas",
  "pregunta.chile.ingles.8.jobs.9.b": "Le gustan las matemáticas",
  "pregunta.chile.ingles.8.jobs.9.c": "Buena para las matemáticas",
  "pregunta.chile.ingles.8.jobs.9.por_que": "Good at = bueno para.",
  "pregunta.chile.ingles.8.jobs.10": "Completa: \"He ___ a teacher.\"",
  "pregunta.chile.ingles.8.jobs.10.a": "is",
  "pregunta.chile.ingles.8.jobs.10.b": "are",
  "pregunta.chile.ingles.8.jobs.10.c": "am",
  "pregunta.chile.ingles.8.jobs.10.por_que": "He is."
}
