{
  "tema.chile.ingles.m3.global": "Global issues",
  "tema.chile.ingles.m3.global.texto": "Climate change, poverty and migration are global issues: they affect many countries and can only be solved through cooperation. If governments had acted earlier, the effects of climate change would have been smaller.\n\nThe third conditional (if + past perfect, would have + participle) talks about unreal situations in the past.",
  "pregunta.chile.ingles.m3.global.1": "¿Qué son los global issues?",
  "pregunta.chile.ingles.m3.global.1.a": "Problemas que afectan a muchos países",
  "pregunta.chile.ingles.m3.global.1.b": "Problemas de una ciudad",
  "pregunta.chile.ingles.m3.global.1.c": "Problemas personales",
  "pregunta.chile.ingles.m3.global.1.por_que": "Cambio climático, pobreza, migración.",
  "pregunta.chile.ingles.m3.global.2": "¿Cómo se resuelven según el texto?",
  "pregunta.chile.ingles.m3.global.2.a": "Con guerra",
  "pregunta.chile.ingles.m3.global.2.b": "Con cooperación",
  "pregunta.chile.ingles.m3.global.2.c": "Ignorándolos",
  "pregunta.chile.ingles.m3.global.2.por_que": "Through cooperation.",
  "pregunta.chile.ingles.m3.global.3": "¿Para qué se usa el third conditional?",
  "pregunta.chile.ingles.m3.global.3.a": "Planes futuros",
  "pregunta.chile.ingles.m3.global.3.b": "Hechos generales",
  "pregunta.chile.ingles.m3.global.3.c": "Situaciones irreales en el pasado",
  "pregunta.chile.ingles.m3.global.3.por_que": "If I had known...",
  "pregunta.chile.ingles.m3.global.4": "Completa: \"If I had studied, I ___ passed.\"",
  "pregunta.chile.ingles.m3.global.4.a": "would have",
  "pregunta.chile.ingles.m3.global.4.b": "will have",
  "pregunta.chile.ingles.m3.global.4.c": "would",
  "pregunta.chile.ingles.m3.global.4.por_que": "Would have + participio.",
  "pregunta.chile.ingles.m3.global.5": "¿Qué significa \"If they had acted earlier\"?",
  "pregunta.chile.ingles.m3.global.5.a": "Si actúan antes",
  "pregunta.chile.ingles.m3.global.5.b": "Si hubieran actuado antes",
  "pregunta.chile.ingles.m3.global.5.c": "Si actuaran después",
  "pregunta.chile.ingles.m3.global.5.por_que": "Past perfect.",
  "pregunta.chile.ingles.m3.global.6": "¿Qué significa \"poverty\"?",
  "pregunta.chile.ingles.m3.global.6.a": "Poder",
  "pregunta.chile.ingles.m3.global.6.b": "Población",
  "pregunta.chile.ingles.m3.global.6.c": "Pobreza",
  "pregunta.chile.ingles.m3.global.6.por_que": "Poor = pobre.",
  "pregunta.chile.ingles.m3.global.7": "Completa: \"If she ___ the bus, she wouldn't have been late.\"",
  "pregunta.chile.ingles.m3.global.7.a": "hadn't missed",
  "pregunta.chile.ingles.m3.global.7.b": "didn't miss",
  "pregunta.chile.ingles.m3.global.7.c": "doesn't miss",
  "pregunta.chile.ingles.m3.global.7.por_que": "Past perfect negativo.",
  "pregunta.chile.ingles.m3.global.8": "¿Qué significa \"effects\"?",
  "pregunta.chile.ingles.m3.global.8.a": "Esfuerzos",
  "pregunta.chile.ingles.m3.global.8.b": "Efectos, consecuencias",
  "pregunta.chile.ingles.m3.global.8.c": "Afectos",
  "pregunta.chile.ingles.m3.global.8.por_que": "Effect = efecto.",
  "pregunta.chile.ingles.m3.global.9": "¿Qué significa \"cooperation\"?",
  "pregunta.chile.ingles.m3.global.9.a": "Competencia",
  "pregunta.chile.ingles.m3.global.9.b": "Corrupción",
  "pregunta.chile.ingles.m3.global.9.c": "Cooperación",
  "pregunta.chile.ingles.m3.global.9.por_que": "Trabajar juntos.",
  "pregunta.chile.ingles.m3.global.10": "¿Qué significa \"migration\"?",
  "pregunta.chile.ingles.m3.global.10.a": "Migración",
  "pregunta.chile.ingles.m3.global.10.b": "Imaginación",
  "pregunta.chile.ingles.m3.global.10.c": "Mitigación",
  "pregunta.chile.ingles.m3.global.10.por_que": "Movimiento de personas.",
  "tema.chile.ingles.m3.deduction": "Science and mysteries",
  "tema.chile.ingles.m3.deduction.texto": "Scientists found footprints in the Atacama Desert. They must be very old, because the rocks are millions of years old. They might belong to a dinosaur, but they can't be human: humans didn't exist then.\n\nModals of deduction: must (almost sure it's true), might/may/could (possible), can't (almost sure it's false).",
  "pregunta.chile.ingles.m3.deduction.1": "¿Qué encontraron los científicos?",
  "pregunta.chile.ingles.m3.deduction.1.a": "Huellas en el desierto de Atacama",
  "pregunta.chile.ingles.m3.deduction.1.b": "Un meteorito",
  "pregunta.chile.ingles.m3.deduction.1.c": "Agua",
  "pregunta.chile.ingles.m3.deduction.1.por_que": "Footprints.",
  "pregunta.chile.ingles.m3.deduction.2": "¿Por qué no pueden ser humanas?",
  "pregunta.chile.ingles.m3.deduction.2.a": "Porque son muy chicas",
  "pregunta.chile.ingles.m3.deduction.2.b": "Porque los humanos no existían entonces",
  "pregunta.chile.ingles.m3.deduction.2.c": "Porque son nuevas",
  "pregunta.chile.ingles.m3.deduction.2.por_que": "They can't be human.",
  "pregunta.chile.ingles.m3.deduction.3": "¿Qué expresa \"must\" en deducciones?",
  "pregunta.chile.ingles.m3.deduction.3.a": "Que es posible",
  "pregunta.chile.ingles.m3.deduction.3.b": "Que es imposible",
  "pregunta.chile.ingles.m3.deduction.3.c": "Que estamos casi seguros de que es verdad",
  "pregunta.chile.ingles.m3.deduction.3.por_que": "Alta certeza.",
  "pregunta.chile.ingles.m3.deduction.4": "¿Qué expresa \"might\"?",
  "pregunta.chile.ingles.m3.deduction.4.a": "Posibilidad",
  "pregunta.chile.ingles.m3.deduction.4.b": "Certeza total",
  "pregunta.chile.ingles.m3.deduction.4.c": "Obligación",
  "pregunta.chile.ingles.m3.deduction.4.por_que": "Podría ser.",
  "pregunta.chile.ingles.m3.deduction.5": "¿Qué expresa \"can't be\"?",
  "pregunta.chile.ingles.m3.deduction.5.a": "Que es posible",
  "pregunta.chile.ingles.m3.deduction.5.b": "Que estamos casi seguros de que es falso",
  "pregunta.chile.ingles.m3.deduction.5.c": "Que es obligatorio",
  "pregunta.chile.ingles.m3.deduction.5.por_que": "Imposibilidad lógica.",
  "pregunta.chile.ingles.m3.deduction.6": "\"He's wearing a uniform with a stethoscope. He ___ be a doctor.\"",
  "pregunta.chile.ingles.m3.deduction.6.a": "can't",
  "pregunta.chile.ingles.m3.deduction.6.b": "mustn't",
  "pregunta.chile.ingles.m3.deduction.6.c": "must",
  "pregunta.chile.ingles.m3.deduction.6.por_que": "Evidencia fuerte.",
  "pregunta.chile.ingles.m3.deduction.7": "\"She's not answering. She ___ be asleep.\"",
  "pregunta.chile.ingles.m3.deduction.7.a": "might",
  "pregunta.chile.ingles.m3.deduction.7.b": "must not ever",
  "pregunta.chile.ingles.m3.deduction.7.c": "can",
  "pregunta.chile.ingles.m3.deduction.7.por_que": "Es una posibilidad.",
  "pregunta.chile.ingles.m3.deduction.8": "¿Qué significa \"footprints\"?",
  "pregunta.chile.ingles.m3.deduction.8.a": "Huellas dactilares",
  "pregunta.chile.ingles.m3.deduction.8.b": "Huellas de pisadas",
  "pregunta.chile.ingles.m3.deduction.8.c": "Fotos",
  "pregunta.chile.ingles.m3.deduction.8.por_que": "Foot = pie.",
  "pregunta.chile.ingles.m3.deduction.9": "¿Qué significa \"belong to\"?",
  "pregunta.chile.ingles.m3.deduction.9.a": "Ser largo",
  "pregunta.chile.ingles.m3.deduction.9.b": "Vivir con",
  "pregunta.chile.ingles.m3.deduction.9.c": "Pertenecer a",
  "pregunta.chile.ingles.m3.deduction.9.por_que": "Belong = pertenecer.",
  "pregunta.chile.ingles.m3.deduction.10": "\"It's snowing. It ___ be hot outside.\"",
  "pregunta.chile.ingles.m3.deduction.10.a": "can't",
  "pregunta.chile.ingles.m3.deduction.10.b": "must",
  "pregunta.chile.ingles.m3.deduction.10.c": "might",
  "pregunta.chile.ingles.m3.deduction.10.por_que": "Es casi imposible.",
  "tema.chile.ingles.m3.phrasal": "Everyday phrasal verbs",
  "tema.chile.ingles.m3.phrasal.texto": "Phrasal verbs combine a verb with a particle and often change meaning: give up (stop trying), look after (take care of), find out (discover), turn down (reject), get on with (have a good relationship).\n\n\"Don't give up! If you keep on practising, you'll improve.\"",
  "pregunta.chile.ingles.m3.phrasal.1": "¿Qué significa \"give up\"?",
  "pregunta.chile.ingles.m3.phrasal.1.a": "Rendirse, dejar de intentar",
  "pregunta.chile.ingles.m3.phrasal.1.b": "Regalar",
  "pregunta.chile.ingles.m3.phrasal.1.c": "Levantar",
  "pregunta.chile.ingles.m3.phrasal.1.por_que": "Don't give up = no te rindas.",
  "pregunta.chile.ingles.m3.phrasal.2": "¿Qué significa \"look after\"?",
  "pregunta.chile.ingles.m3.phrasal.2.a": "Buscar",
  "pregunta.chile.ingles.m3.phrasal.2.b": "Cuidar",
  "pregunta.chile.ingles.m3.phrasal.2.c": "Mirar después",
  "pregunta.chile.ingles.m3.phrasal.2.por_que": "Look after a child.",
  "pregunta.chile.ingles.m3.phrasal.3": "¿Qué significa \"find out\"?",
  "pregunta.chile.ingles.m3.phrasal.3.a": "Perder",
  "pregunta.chile.ingles.m3.phrasal.3.b": "Salir",
  "pregunta.chile.ingles.m3.phrasal.3.c": "Descubrir, averiguar",
  "pregunta.chile.ingles.m3.phrasal.3.por_que": "Find out the truth.",
  "pregunta.chile.ingles.m3.phrasal.4": "¿Qué significa \"turn down\" una oferta?",
  "pregunta.chile.ingles.m3.phrasal.4.a": "Rechazarla",
  "pregunta.chile.ingles.m3.phrasal.4.b": "Aceptarla",
  "pregunta.chile.ingles.m3.phrasal.4.c": "Subirla",
  "pregunta.chile.ingles.m3.phrasal.4.por_que": "También bajar el volumen.",
  "pregunta.chile.ingles.m3.phrasal.5": "¿Qué significa \"get on with\" someone?",
  "pregunta.chile.ingles.m3.phrasal.5.a": "Subirse a algo",
  "pregunta.chile.ingles.m3.phrasal.5.b": "Llevarse bien con alguien",
  "pregunta.chile.ingles.m3.phrasal.5.c": "Pelear",
  "pregunta.chile.ingles.m3.phrasal.5.por_que": "I get on with my sister.",
  "pregunta.chile.ingles.m3.phrasal.6": "¿Qué significa \"keep on\"?",
  "pregunta.chile.ingles.m3.phrasal.6.a": "Mantener apagado",
  "pregunta.chile.ingles.m3.phrasal.6.b": "Guardar",
  "pregunta.chile.ingles.m3.phrasal.6.c": "Seguir, continuar",
  "pregunta.chile.ingles.m3.phrasal.6.por_que": "Keep on practising.",
  "pregunta.chile.ingles.m3.phrasal.7": "¿Qué significa \"look for\"?",
  "pregunta.chile.ingles.m3.phrasal.7.a": "Buscar",
  "pregunta.chile.ingles.m3.phrasal.7.b": "Cuidar",
  "pregunta.chile.ingles.m3.phrasal.7.c": "Admirar",
  "pregunta.chile.ingles.m3.phrasal.7.por_que": "I'm looking for my keys.",
  "pregunta.chile.ingles.m3.phrasal.8": "¿Qué significa \"run out of\"?",
  "pregunta.chile.ingles.m3.phrasal.8.a": "Correr afuera",
  "pregunta.chile.ingles.m3.phrasal.8.b": "Quedarse sin",
  "pregunta.chile.ingles.m3.phrasal.8.c": "Escapar",
  "pregunta.chile.ingles.m3.phrasal.8.por_que": "We ran out of milk.",
  "pregunta.chile.ingles.m3.phrasal.9": "¿Qué significa \"put off\"?",
  "pregunta.chile.ingles.m3.phrasal.9.a": "Ponerse ropa",
  "pregunta.chile.ingles.m3.phrasal.9.b": "Apagar",
  "pregunta.chile.ingles.m3.phrasal.9.c": "Posponer",
  "pregunta.chile.ingles.m3.phrasal.9.por_que": "Don't put off your homework.",
  "pregunta.chile.ingles.m3.phrasal.10": "¿Qué significa \"set up\"?",
  "pregunta.chile.ingles.m3.phrasal.10.a": "Montar, establecer",
  "pregunta.chile.ingles.m3.phrasal.10.b": "Sentarse",
  "pregunta.chile.ingles.m3.phrasal.10.c": "Levantarse",
  "pregunta.chile.ingles.m3.phrasal.10.por_que": "Set up a business.",
  "tema.chile.ingles.m3.arts": "Arts and culture",
  "tema.chile.ingles.m3.arts.texto": "Although Violeta Parra had no formal training, she became one of the most important artists in Latin America. She collected folk songs, painted and made tapestries. Moreover, in 1964 her work was exhibited at the Louvre in Paris.\n\nLinking words organise ideas: although (contrast), moreover (addition), therefore (result), however (contrast).",
  "pregunta.chile.ingles.m3.arts.1": "¿Qué hizo Violeta Parra según el texto?",
  "pregunta.chile.ingles.m3.arts.1.a": "Recopiló canciones folclóricas, pintó e hizo tapices",
  "pregunta.chile.ingles.m3.arts.1.b": "Escribió novelas",
  "pregunta.chile.ingles.m3.arts.1.c": "Fue científica",
  "pregunta.chile.ingles.m3.arts.1.por_que": "Collected folk songs.",
  "pregunta.chile.ingles.m3.arts.2": "¿Dónde se expuso su obra en 1964?",
  "pregunta.chile.ingles.m3.arts.2.a": "En Nueva York",
  "pregunta.chile.ingles.m3.arts.2.b": "En el Louvre de París",
  "pregunta.chile.ingles.m3.arts.2.c": "En Santiago",
  "pregunta.chile.ingles.m3.arts.2.por_que": "At the Louvre.",
  "pregunta.chile.ingles.m3.arts.3": "¿Qué expresa \"although\"?",
  "pregunta.chile.ingles.m3.arts.3.a": "Adición",
  "pregunta.chile.ingles.m3.arts.3.b": "Resultado",
  "pregunta.chile.ingles.m3.arts.3.c": "Contraste (aunque)",
  "pregunta.chile.ingles.m3.arts.3.por_que": "Although she had no training...",
  "pregunta.chile.ingles.m3.arts.4": "¿Qué expresa \"moreover\"?",
  "pregunta.chile.ingles.m3.arts.4.a": "Adición (además)",
  "pregunta.chile.ingles.m3.arts.4.b": "Contraste",
  "pregunta.chile.ingles.m3.arts.4.c": "Causa",
  "pregunta.chile.ingles.m3.arts.4.por_que": "Agrega información.",
  "pregunta.chile.ingles.m3.arts.5": "¿Qué expresa \"therefore\"?",
  "pregunta.chile.ingles.m3.arts.5.a": "Contraste",
  "pregunta.chile.ingles.m3.arts.5.b": "Resultado (por lo tanto)",
  "pregunta.chile.ingles.m3.arts.5.c": "Tiempo",
  "pregunta.chile.ingles.m3.arts.5.por_que": "Conclusion.",
  "pregunta.chile.ingles.m3.arts.6": "Completa: \"It was raining; ___, we went out.\"",
  "pregunta.chile.ingles.m3.arts.6.a": "therefore",
  "pregunta.chile.ingles.m3.arts.6.b": "moreover",
  "pregunta.chile.ingles.m3.arts.6.c": "however",
  "pregunta.chile.ingles.m3.arts.6.por_que": "Contraste: aun así.",
  "pregunta.chile.ingles.m3.arts.7": "¿Qué significa \"formal training\"?",
  "pregunta.chile.ingles.m3.arts.7.a": "Formación formal",
  "pregunta.chile.ingles.m3.arts.7.b": "Entrenamiento físico",
  "pregunta.chile.ingles.m3.arts.7.c": "Trabajo formal",
  "pregunta.chile.ingles.m3.arts.7.por_que": "Estudios académicos.",
  "pregunta.chile.ingles.m3.arts.8": "¿Qué significa \"tapestries\"?",
  "pregunta.chile.ingles.m3.arts.8.a": "Tapas",
  "pregunta.chile.ingles.m3.arts.8.b": "Tapices",
  "pregunta.chile.ingles.m3.arts.8.c": "Pinturas",
  "pregunta.chile.ingles.m3.arts.8.por_que": "Arpilleras bordadas.",
  "pregunta.chile.ingles.m3.arts.9": "Completa: \"She was tired; ___, she went to bed early.\"",
  "pregunta.chile.ingles.m3.arts.9.a": "although",
  "pregunta.chile.ingles.m3.arts.9.b": "however",
  "pregunta.chile.ingles.m3.arts.9.c": "therefore",
  "pregunta.chile.ingles.m3.arts.9.por_que": "Resultado.",
  "pregunta.chile.ingles.m3.arts.10": "¿Qué significa \"exhibited\"?",
  "pregunta.chile.ingles.m3.arts.10.a": "Expuesto (en una muestra)",
  "pregunta.chile.ingles.m3.arts.10.b": "Escondido",
  "pregunta.chile.ingles.m3.arts.10.c": "Vendido",
  "pregunta.chile.ingles.m3.arts.10.por_que": "Exhibition = exposición."
}
