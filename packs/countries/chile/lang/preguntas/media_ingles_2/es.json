{
  "tema.chile.ingles.m2.passive": "Inventions and discoveries",
  "tema.chile.ingles.m2.passive.texto": "The telephone was invented by Alexander Graham Bell in 1876. Penicillin was discovered by Alexander Fleming in 1928. Today, millions of smartphones are made every year.\n\nThe passive voice (be + past participle) is used when the action is more important than who did it.",
  "pregunta.chile.ingles.m2.passive.1": "¿Quién inventó el teléfono según el texto?",
  "pregunta.chile.ingles.m2.passive.1.a": "Alexander Graham Bell",
  "pregunta.chile.ingles.m2.passive.1.b": "Alexander Fleming",
  "pregunta.chile.ingles.m2.passive.1.c": "Thomas Edison",
  "pregunta.chile.ingles.m2.passive.1.por_que": "Was invented by Bell.",
  "pregunta.chile.ingles.m2.passive.2": "¿Qué se descubrió en 1928?",
  "pregunta.chile.ingles.m2.passive.2.a": "El teléfono",
  "pregunta.chile.ingles.m2.passive.2.b": "La penicilina",
  "pregunta.chile.ingles.m2.passive.2.c": "El smartphone",
  "pregunta.chile.ingles.m2.passive.2.por_que": "Fleming discovered it.",
  "pregunta.chile.ingles.m2.passive.3": "¿Cuál está en voz pasiva?",
  "pregunta.chile.ingles.m2.passive.3.a": "Neruda wrote the book",
  "pregunta.chile.ingles.m2.passive.3.b": "Neruda is writing",
  "pregunta.chile.ingles.m2.passive.3.c": "The book was written by Neruda",
  "pregunta.chile.ingles.m2.passive.3.por_que": "Be + participio.",
  "pregunta.chile.ingles.m2.passive.4": "Completa: \"English ___ spoken all over the world.\"",
  "pregunta.chile.ingles.m2.passive.4.a": "is",
  "pregunta.chile.ingles.m2.passive.4.b": "are",
  "pregunta.chile.ingles.m2.passive.4.c": "was being",
  "pregunta.chile.ingles.m2.passive.4.por_que": "English (singular) + is.",
  "pregunta.chile.ingles.m2.passive.5": "Completa: \"The pyramids ___ built thousands of years ago.\"",
  "pregunta.chile.ingles.m2.passive.5.a": "was",
  "pregunta.chile.ingles.m2.passive.5.b": "were",
  "pregunta.chile.ingles.m2.passive.5.c": "are",
  "pregunta.chile.ingles.m2.passive.5.por_que": "Plural en pasado.",
  "pregunta.chile.ingles.m2.passive.6": "¿Cuándo se usa la voz pasiva?",
  "pregunta.chile.ingles.m2.passive.6.a": "Siempre en el futuro",
  "pregunta.chile.ingles.m2.passive.6.b": "Solo en preguntas",
  "pregunta.chile.ingles.m2.passive.6.c": "Cuando importa más la acción que quien la hace",
  "pregunta.chile.ingles.m2.passive.6.por_que": "Por ejemplo, en noticias y ciencia.",
  "pregunta.chile.ingles.m2.passive.7": "¿Qué significa \"discovered\"?",
  "pregunta.chile.ingles.m2.passive.7.a": "Descubierto",
  "pregunta.chile.ingles.m2.passive.7.b": "Inventado",
  "pregunta.chile.ingles.m2.passive.7.c": "Destruido",
  "pregunta.chile.ingles.m2.passive.7.por_que": "Discover = descubrir.",
  "pregunta.chile.ingles.m2.passive.8": "Completa: \"Cars ___ made in this factory.\"",
  "pregunta.chile.ingles.m2.passive.8.a": "is",
  "pregunta.chile.ingles.m2.passive.8.b": "are",
  "pregunta.chile.ingles.m2.passive.8.c": "be",
  "pregunta.chile.ingles.m2.passive.8.por_que": "Plural presente.",
  "pregunta.chile.ingles.m2.passive.9": "¿Cuál es el participio de \"make\"?",
  "pregunta.chile.ingles.m2.passive.9.a": "Maked",
  "pregunta.chile.ingles.m2.passive.9.b": "Making",
  "pregunta.chile.ingles.m2.passive.9.c": "Made",
  "pregunta.chile.ingles.m2.passive.9.por_que": "Make, made, made.",
  "pregunta.chile.ingles.m2.passive.10": "¿Qué significa \"millions of smartphones are made every year\"?",
  "pregunta.chile.ingles.m2.passive.10.a": "Se fabrican millones de teléfonos al año",
  "pregunta.chile.ingles.m2.passive.10.b": "Millones compran teléfonos",
  "pregunta.chile.ingles.m2.passive.10.c": "Los teléfonos hacen millones",
  "pregunta.chile.ingles.m2.passive.10.por_que": "Pasiva en presente.",
  "tema.chile.ingles.m2.conditionals": "Imagine and wish",
  "tema.chile.ingles.m2.conditionals.texto": "If I had more free time, I would learn to play the guitar. If I won the lottery, I would travel around the world and help my family.\n\nThe second conditional (if + past simple, would + verb) talks about imaginary or unlikely situations.",
  "pregunta.chile.ingles.m2.conditionals.1": "¿Qué haría con más tiempo libre?",
  "pregunta.chile.ingles.m2.conditionals.1.a": "Aprendería a tocar guitarra",
  "pregunta.chile.ingles.m2.conditionals.1.b": "Viajaría",
  "pregunta.chile.ingles.m2.conditionals.1.c": "Dormiría",
  "pregunta.chile.ingles.m2.conditionals.1.por_que": "I would learn to play the guitar.",
  "pregunta.chile.ingles.m2.conditionals.2": "¿Qué haría si ganara la lotería?",
  "pregunta.chile.ingles.m2.conditionals.2.a": "Compraría una casa",
  "pregunta.chile.ingles.m2.conditionals.2.b": "Viajaría por el mundo y ayudaría a su familia",
  "pregunta.chile.ingles.m2.conditionals.2.c": "Nada",
  "pregunta.chile.ingles.m2.conditionals.2.por_que": "Travel around the world.",
  "pregunta.chile.ingles.m2.conditionals.3": "¿Para qué se usa el second conditional?",
  "pregunta.chile.ingles.m2.conditionals.3.a": "Hechos siempre verdaderos",
  "pregunta.chile.ingles.m2.conditionals.3.b": "Planes seguros",
  "pregunta.chile.ingles.m2.conditionals.3.c": "Situaciones imaginarias o poco probables",
  "pregunta.chile.ingles.m2.conditionals.3.por_que": "If I were rich...",
  "pregunta.chile.ingles.m2.conditionals.4": "Completa: \"If I ___ rich, I would buy a house.\"",
  "pregunta.chile.ingles.m2.conditionals.4.a": "were",
  "pregunta.chile.ingles.m2.conditionals.4.b": "am",
  "pregunta.chile.ingles.m2.conditionals.4.c": "will be",
  "pregunta.chile.ingles.m2.conditionals.4.por_que": "En el second conditional se usa were.",
  "pregunta.chile.ingles.m2.conditionals.5": "Completa: \"If she studied more, she ___ pass the exam.\"",
  "pregunta.chile.ingles.m2.conditionals.5.a": "will",
  "pregunta.chile.ingles.m2.conditionals.5.b": "would",
  "pregunta.chile.ingles.m2.conditionals.5.c": "is",
  "pregunta.chile.ingles.m2.conditionals.5.por_que": "Would + verbo.",
  "pregunta.chile.ingles.m2.conditionals.6": "¿Qué significa \"I would travel\"?",
  "pregunta.chile.ingles.m2.conditionals.6.a": "Viajé",
  "pregunta.chile.ingles.m2.conditionals.6.b": "Viajaré",
  "pregunta.chile.ingles.m2.conditionals.6.c": "Viajaría",
  "pregunta.chile.ingles.m2.conditionals.6.por_que": "Would = condicional.",
  "pregunta.chile.ingles.m2.conditionals.7": "Completa: \"If it ___ tomorrow, we will stay home.\"",
  "pregunta.chile.ingles.m2.conditionals.7.a": "rains",
  "pregunta.chile.ingles.m2.conditionals.7.b": "rained",
  "pregunta.chile.ingles.m2.conditionals.7.c": "would rain",
  "pregunta.chile.ingles.m2.conditionals.7.por_que": "First conditional: situación probable.",
  "pregunta.chile.ingles.m2.conditionals.8": "¿Qué significa \"I wish I could fly\"?",
  "pregunta.chile.ingles.m2.conditionals.8.a": "Puedo volar",
  "pregunta.chile.ingles.m2.conditionals.8.b": "Ojalá pudiera volar",
  "pregunta.chile.ingles.m2.conditionals.8.c": "Volé",
  "pregunta.chile.ingles.m2.conditionals.8.por_que": "Deseo irreal.",
  "pregunta.chile.ingles.m2.conditionals.9": "¿Qué significa \"unlikely\"?",
  "pregunta.chile.ingles.m2.conditionals.9.a": "Probable",
  "pregunta.chile.ingles.m2.conditionals.9.b": "Seguro",
  "pregunta.chile.ingles.m2.conditionals.9.c": "Poco probable",
  "pregunta.chile.ingles.m2.conditionals.9.por_que": "Un + likely.",
  "pregunta.chile.ingles.m2.conditionals.10": "Completa: \"What ___ you do if you saw a ghost?\"",
  "pregunta.chile.ingles.m2.conditionals.10.a": "would",
  "pregunta.chile.ingles.m2.conditionals.10.b": "will",
  "pregunta.chile.ingles.m2.conditionals.10.c": "did",
  "pregunta.chile.ingles.m2.conditionals.10.por_que": "Pregunta en second conditional.",
  "tema.chile.ingles.m2.reported": "What did they say?",
  "tema.chile.ingles.m2.reported.texto": "My teacher said, \"The test is on Friday.\" → My teacher said that the test was on Friday.\n\nIn reported speech the verb usually moves one step back in time: is → was, will → would, can → could. Pronouns and time words also change: \"tomorrow\" → \"the next day\".",
  "pregunta.chile.ingles.m2.reported.1": "¿Cómo se reporta \"I am tired\", dijo ella?",
  "pregunta.chile.ingles.m2.reported.1.a": "She said that she was tired",
  "pregunta.chile.ingles.m2.reported.1.b": "She said that I am tired",
  "pregunta.chile.ingles.m2.reported.1.c": "She says I was tired",
  "pregunta.chile.ingles.m2.reported.1.por_que": "Am → was, I → she.",
  "pregunta.chile.ingles.m2.reported.2": "¿Cómo cambia \"will\" en reported speech?",
  "pregunta.chile.ingles.m2.reported.2.a": "Will",
  "pregunta.chile.ingles.m2.reported.2.b": "Would",
  "pregunta.chile.ingles.m2.reported.2.c": "Shall",
  "pregunta.chile.ingles.m2.reported.2.por_que": "Un paso atrás.",
  "pregunta.chile.ingles.m2.reported.3": "¿Cómo cambia \"can\"?",
  "pregunta.chile.ingles.m2.reported.3.a": "Can",
  "pregunta.chile.ingles.m2.reported.3.b": "Might",
  "pregunta.chile.ingles.m2.reported.3.c": "Could",
  "pregunta.chile.ingles.m2.reported.3.por_que": "Can → could.",
  "pregunta.chile.ingles.m2.reported.4": "¿Cómo cambia \"tomorrow\"?",
  "pregunta.chile.ingles.m2.reported.4.a": "The next day",
  "pregunta.chile.ingles.m2.reported.4.b": "Yesterday",
  "pregunta.chile.ingles.m2.reported.4.c": "Today",
  "pregunta.chile.ingles.m2.reported.4.por_que": "Las palabras de tiempo cambian.",
  "pregunta.chile.ingles.m2.reported.5": "He said, \"I like pizza.\" →",
  "pregunta.chile.ingles.m2.reported.5.a": "He said that I like pizza",
  "pregunta.chile.ingles.m2.reported.5.b": "He said that he liked pizza",
  "pregunta.chile.ingles.m2.reported.5.c": "He said he likes pizza yesterday",
  "pregunta.chile.ingles.m2.reported.5.por_que": "Like → liked.",
  "pregunta.chile.ingles.m2.reported.6": "¿Qué es el reported speech?",
  "pregunta.chile.ingles.m2.reported.6.a": "Hablar en futuro",
  "pregunta.chile.ingles.m2.reported.6.b": "Hacer preguntas",
  "pregunta.chile.ingles.m2.reported.6.c": "Contar lo que otra persona dijo",
  "pregunta.chile.ingles.m2.reported.6.por_que": "Estilo indirecto.",
  "pregunta.chile.ingles.m2.reported.7": "She asked, \"Where do you live?\" →",
  "pregunta.chile.ingles.m2.reported.7.a": "She asked where I lived",
  "pregunta.chile.ingles.m2.reported.7.b": "She asked where do I live",
  "pregunta.chile.ingles.m2.reported.7.c": "She asked where I live?",
  "pregunta.chile.ingles.m2.reported.7.por_que": "En preguntas reportadas no va el auxiliar.",
  "pregunta.chile.ingles.m2.reported.8": "¿Qué significa \"said that\"?",
  "pregunta.chile.ingles.m2.reported.8.a": "Dice que",
  "pregunta.chile.ingles.m2.reported.8.b": "Dijo que",
  "pregunta.chile.ingles.m2.reported.8.c": "Diría que",
  "pregunta.chile.ingles.m2.reported.8.por_que": "Said = pasado de say.",
  "pregunta.chile.ingles.m2.reported.9": "They said, \"We will come.\" →",
  "pregunta.chile.ingles.m2.reported.9.a": "They said that we will come",
  "pregunta.chile.ingles.m2.reported.9.b": "They say they come",
  "pregunta.chile.ingles.m2.reported.9.c": "They said that they would come",
  "pregunta.chile.ingles.m2.reported.9.por_que": "Will → would, we → they.",
  "pregunta.chile.ingles.m2.reported.10": "¿Qué diferencia hay entre say y tell?",
  "pregunta.chile.ingles.m2.reported.10.a": "Tell necesita a quién: told me",
  "pregunta.chile.ingles.m2.reported.10.b": "Say necesita a quién",
  "pregunta.chile.ingles.m2.reported.10.c": "No hay diferencia",
  "pregunta.chile.ingles.m2.reported.10.por_que": "He told me / He said to me.",
  "tema.chile.ingles.m2.culture": "Cultures around the world",
  "tema.chile.ingles.m2.culture.texto": "Chile is a country which has many different cultures: the Mapuche, Aymara and Rapa Nui peoples, and immigrants who came from Europe, Asia and other Latin American countries. Festivals such as We Tripantu, which celebrates the new year, keep traditions alive.\n\nRelative pronouns join ideas: who for people, which for things, where for places.",
  "pregunta.chile.ingles.m2.culture.1": "¿Qué pueblos menciona el texto?",
  "pregunta.chile.ingles.m2.culture.1.a": "Mapuche, aymara y rapanui",
  "pregunta.chile.ingles.m2.culture.1.b": "Inca y maya",
  "pregunta.chile.ingles.m2.culture.1.c": "Azteca",
  "pregunta.chile.ingles.m2.culture.1.por_que": "Pueblos originarios de Chile.",
  "pregunta.chile.ingles.m2.culture.2": "¿Qué celebra el We Tripantu?",
  "pregunta.chile.ingles.m2.culture.2.a": "La independencia",
  "pregunta.chile.ingles.m2.culture.2.b": "El año nuevo",
  "pregunta.chile.ingles.m2.culture.2.c": "La Navidad",
  "pregunta.chile.ingles.m2.culture.2.por_que": "Which celebrates the new year.",
  "pregunta.chile.ingles.m2.culture.3": "¿Qué pronombre relativo se usa para personas?",
  "pregunta.chile.ingles.m2.culture.3.a": "Which",
  "pregunta.chile.ingles.m2.culture.3.b": "Where",
  "pregunta.chile.ingles.m2.culture.3.c": "Who",
  "pregunta.chile.ingles.m2.culture.3.por_que": "The man who lives here.",
  "pregunta.chile.ingles.m2.culture.4": "¿Qué pronombre relativo se usa para lugares?",
  "pregunta.chile.ingles.m2.culture.4.a": "Where",
  "pregunta.chile.ingles.m2.culture.4.b": "Who",
  "pregunta.chile.ingles.m2.culture.4.c": "Which",
  "pregunta.chile.ingles.m2.culture.4.por_que": "The city where I was born.",
  "pregunta.chile.ingles.m2.culture.5": "Completa: \"This is the book ___ I bought.\"",
  "pregunta.chile.ingles.m2.culture.5.a": "who",
  "pregunta.chile.ingles.m2.culture.5.b": "which",
  "pregunta.chile.ingles.m2.culture.5.c": "where",
  "pregunta.chile.ingles.m2.culture.5.por_que": "Para cosas.",
  "pregunta.chile.ingles.m2.culture.6": "Completa: \"She is the girl ___ won the prize.\"",
  "pregunta.chile.ingles.m2.culture.6.a": "which",
  "pregunta.chile.ingles.m2.culture.6.b": "where",
  "pregunta.chile.ingles.m2.culture.6.c": "who",
  "pregunta.chile.ingles.m2.culture.6.por_que": "Para personas.",
  "pregunta.chile.ingles.m2.culture.7": "¿Qué significa \"keep traditions alive\"?",
  "pregunta.chile.ingles.m2.culture.7.a": "Mantener vivas las tradiciones",
  "pregunta.chile.ingles.m2.culture.7.b": "Olvidar las tradiciones",
  "pregunta.chile.ingles.m2.culture.7.c": "Cambiar las tradiciones",
  "pregunta.chile.ingles.m2.culture.7.por_que": "Alive = vivo.",
  "pregunta.chile.ingles.m2.culture.8": "Completa: \"Valparaíso is the city ___ Neruda had a house.\"",
  "pregunta.chile.ingles.m2.culture.8.a": "who",
  "pregunta.chile.ingles.m2.culture.8.b": "where",
  "pregunta.chile.ingles.m2.culture.8.c": "which",
  "pregunta.chile.ingles.m2.culture.8.por_que": "Lugar.",
  "pregunta.chile.ingles.m2.culture.9": "¿Qué significa \"immigrants\"?",
  "pregunta.chile.ingles.m2.culture.9.a": "Emigrantes que vuelven",
  "pregunta.chile.ingles.m2.culture.9.b": "Turistas",
  "pregunta.chile.ingles.m2.culture.9.c": "Inmigrantes",
  "pregunta.chile.ingles.m2.culture.9.por_que": "Personas que llegan a vivir a un país.",
  "pregunta.chile.ingles.m2.culture.10": "¿Qué significa \"festival\"?",
  "pregunta.chile.ingles.m2.culture.10.a": "Festival o fiesta",
  "pregunta.chile.ingles.m2.culture.10.b": "Feria de ropa",
  "pregunta.chile.ingles.m2.culture.10.c": "Día feriado de trabajo",
  "pregunta.chile.ingles.m2.culture.10.por_que": "Celebración cultural."
}
