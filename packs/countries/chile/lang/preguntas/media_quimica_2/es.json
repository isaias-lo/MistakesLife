{
  "tema.chile.quimica.m2.disoluciones": "Disoluciones",
  "tema.chile.quimica.m2.disoluciones.texto": "Una disolución es una mezcla homogénea de un soluto (lo que se disuelve) y un solvente (lo que disuelve, normalmente agua). La solubilidad es la máxima cantidad de soluto que se disuelve a cierta temperatura; generalmente aumenta con la temperatura en los sólidos.\n\nUna disolución es diluida si tiene poco soluto, concentrada si tiene mucho y saturada si ya no admite más.",
  "pregunta.chile.quimica.m2.disoluciones.1": "¿Qué es el soluto?",
  "pregunta.chile.quimica.m2.disoluciones.1.a": "La sustancia que se disuelve",
  "pregunta.chile.quimica.m2.disoluciones.1.b": "La que disuelve",
  "pregunta.chile.quimica.m2.disoluciones.1.c": "El recipiente",
  "pregunta.chile.quimica.m2.disoluciones.1.por_que": "Normalmente en menor cantidad.",
  "pregunta.chile.quimica.m2.disoluciones.2": "¿Cuál es el solvente universal?",
  "pregunta.chile.quimica.m2.disoluciones.2.a": "El aceite",
  "pregunta.chile.quimica.m2.disoluciones.2.b": "El agua",
  "pregunta.chile.quimica.m2.disoluciones.2.c": "El alcohol",
  "pregunta.chile.quimica.m2.disoluciones.2.por_que": "Disuelve muchas sustancias.",
  "pregunta.chile.quimica.m2.disoluciones.3": "¿Qué es una disolución saturada?",
  "pregunta.chile.quimica.m2.disoluciones.3.a": "Una sin soluto",
  "pregunta.chile.quimica.m2.disoluciones.3.b": "Una mezcla heterogénea",
  "pregunta.chile.quimica.m2.disoluciones.3.c": "Una que no admite más soluto",
  "pregunta.chile.quimica.m2.disoluciones.3.por_que": "Si agregas más, queda en el fondo.",
  "pregunta.chile.quimica.m2.disoluciones.4": "¿Qué pasa con la solubilidad del azúcar en agua caliente?",
  "pregunta.chile.quimica.m2.disoluciones.4.a": "Aumenta",
  "pregunta.chile.quimica.m2.disoluciones.4.b": "Disminuye",
  "pregunta.chile.quimica.m2.disoluciones.4.c": "No cambia",
  "pregunta.chile.quimica.m2.disoluciones.4.por_que": "Por eso se disuelve mejor en té caliente.",
  "pregunta.chile.quimica.m2.disoluciones.5": "¿Qué pasa con la solubilidad de un gas al calentar el agua?",
  "pregunta.chile.quimica.m2.disoluciones.5.a": "Aumenta",
  "pregunta.chile.quimica.m2.disoluciones.5.b": "Disminuye",
  "pregunta.chile.quimica.m2.disoluciones.5.c": "No cambia",
  "pregunta.chile.quimica.m2.disoluciones.5.por_que": "Por eso una bebida caliente pierde gas.",
  "pregunta.chile.quimica.m2.disoluciones.6": "¿Qué es una disolución diluida?",
  "pregunta.chile.quimica.m2.disoluciones.6.a": "Una con mucho soluto",
  "pregunta.chile.quimica.m2.disoluciones.6.b": "Una sin solvente",
  "pregunta.chile.quimica.m2.disoluciones.6.c": "Una con poco soluto",
  "pregunta.chile.quimica.m2.disoluciones.6.por_que": "Como un jugo muy aguado.",
  "pregunta.chile.quimica.m2.disoluciones.7": "¿Qué tipo de mezcla es una disolución?",
  "pregunta.chile.quimica.m2.disoluciones.7.a": "Homogénea",
  "pregunta.chile.quimica.m2.disoluciones.7.b": "Heterogénea",
  "pregunta.chile.quimica.m2.disoluciones.7.c": "Una sustancia pura",
  "pregunta.chile.quimica.m2.disoluciones.7.por_que": "No se distinguen sus partes.",
  "pregunta.chile.quimica.m2.disoluciones.8": "¿Cuál es una disolución gaseosa?",
  "pregunta.chile.quimica.m2.disoluciones.8.a": "El agua con arena",
  "pregunta.chile.quimica.m2.disoluciones.8.b": "El aire",
  "pregunta.chile.quimica.m2.disoluciones.8.c": "El jugo con pulpa",
  "pregunta.chile.quimica.m2.disoluciones.8.por_que": "Gases disueltos en nitrógeno.",
  "pregunta.chile.quimica.m2.disoluciones.9": "¿Cuál es una aleación (disolución sólida)?",
  "pregunta.chile.quimica.m2.disoluciones.9.a": "La arena",
  "pregunta.chile.quimica.m2.disoluciones.9.b": "El agua",
