  "pregunta.chile.quimica.m2.disoluciones.9.por_que": "Cobre con estaño.",
  "pregunta.chile.quimica.m2.disoluciones.10": "¿Qué factor acelera la disolución de un sólido?",
  "pregunta.chile.quimica.m2.disoluciones.10.a": "Agitar y moler el sólido",
  "pregunta.chile.quimica.m2.disoluciones.10.b": "Enfriar mucho",
  "pregunta.chile.quimica.m2.disoluciones.10.c": "No moverlo",
  "pregunta.chile.quimica.m2.disoluciones.10.por_que": "Aumenta el contacto con el solvente.",
  "tema.chile.quimica.m2.concentracion": "Concentración",
  "tema.chile.quimica.m2.concentracion.texto": "La concentración indica cuánto soluto hay en una disolución. El porcentaje masa/volumen (% m/v) son los gramos de soluto en 100 mL de disolución. La molaridad (M) son los moles de soluto por litro de disolución.\n\nAl diluir, la cantidad de soluto no cambia: C₁ · V₁ = C₂ · V₂.",
  "pregunta.chile.quimica.m2.concentracion.1": "¿Qué indica el % m/v?",
  "pregunta.chile.quimica.m2.concentracion.1.a": "Gramos de soluto en 100 mL de disolución",
  "pregunta.chile.quimica.m2.concentracion.1.b": "Moles por litro",
  "pregunta.chile.quimica.m2.concentracion.1.c": "Litros de agua",
  "pregunta.chile.quimica.m2.concentracion.1.por_que": "Por ejemplo, suero al 0,9 %.",
  "pregunta.chile.quimica.m2.concentracion.2": "¿Qué es la molaridad?",
  "pregunta.chile.quimica.m2.concentracion.2.a": "Gramos por kilo",
  "pregunta.chile.quimica.m2.concentracion.2.b": "Moles de soluto por litro de disolución",
  "pregunta.chile.quimica.m2.concentracion.2.c": "Litros por mol",
  "pregunta.chile.quimica.m2.concentracion.2.por_que": "Se escribe M.",
  "pregunta.chile.quimica.m2.concentracion.3": "Si disuelves 2 moles en 1 L, ¿cuál es la molaridad?",
  "pregunta.chile.quimica.m2.concentracion.3.a": "0,5 M",
  "pregunta.chile.quimica.m2.concentracion.3.b": "1 M",
  "pregunta.chile.quimica.m2.concentracion.3.c": "2 M",
  "pregunta.chile.quimica.m2.concentracion.3.por_que": "2/1.",
  "pregunta.chile.quimica.m2.concentracion.4": "Si disuelves 10 g de sal en 200 mL, ¿cuál es el % m/v?",
  "pregunta.chile.quimica.m2.concentracion.4.a": "5 %",
  "pregunta.chile.quimica.m2.concentracion.4.b": "10 %",
  "pregunta.chile.quimica.m2.concentracion.4.c": "20 %",
  "pregunta.chile.quimica.m2.concentracion.4.por_que": "10/200 · 100.",
  "pregunta.chile.quimica.m2.concentracion.5": "¿Qué pasa con la cantidad de soluto al diluir?",
  "pregunta.chile.quimica.m2.concentracion.5.a": "Aumenta",
  "pregunta.chile.quimica.m2.concentracion.5.b": "Se mantiene",
  "pregunta.chile.quimica.m2.concentracion.5.c": "Desaparece",
  "pregunta.chile.quimica.m2.concentracion.5.por_que": "Solo se agrega solvente.",
  "pregunta.chile.quimica.m2.concentracion.6": "¿Cuántos moles hay en 0,5 L de una disolución 2 M?",
  "pregunta.chile.quimica.m2.concentracion.6.a": "4",
  "pregunta.chile.quimica.m2.concentracion.6.b": "0,25",
  "pregunta.chile.quimica.m2.concentracion.6.c": "1",
  "pregunta.chile.quimica.m2.concentracion.6.por_que": "M · V.",
  "pregunta.chile.quimica.m2.concentracion.7": "Diluyes 100 mL de una disolución 1 M hasta 200 mL. ¿Nueva concentración?",
  "pregunta.chile.quimica.m2.concentracion.7.a": "0,5 M",
  "pregunta.chile.quimica.m2.concentracion.7.b": "2 M",
  "pregunta.chile.quimica.m2.concentracion.7.c": "1 M",
  "pregunta.chile.quimica.m2.concentracion.7.por_que": "C₁V₁ = C₂V₂.",
  "pregunta.chile.quimica.m2.concentracion.8": "¿Qué concentración tiene el suero fisiológico?",
  "pregunta.chile.quimica.m2.concentracion.8.a": "50 % de NaCl",
  "pregunta.chile.quimica.m2.concentracion.8.b": "0,9 % de NaCl",
