  "pregunta.chile.quimica.m2.funcionales.5.c": "Un gas noble",
  "pregunta.chile.quimica.m2.funcionales.5.por_que": "Como el polietileno.",
  "pregunta.chile.quimica.m2.funcionales.6": "¿Qué alcohol hay en las bebidas alcohólicas?",
  "pregunta.chile.quimica.m2.funcionales.6.a": "Metanol",
  "pregunta.chile.quimica.m2.funcionales.6.b": "Glicerina",
  "pregunta.chile.quimica.m2.funcionales.6.c": "Etanol",
  "pregunta.chile.quimica.m2.funcionales.6.por_que": "El metanol es tóxico.",
  "pregunta.chile.quimica.m2.funcionales.7": "¿Qué grupo tienen las aminas?",
  "pregunta.chile.quimica.m2.funcionales.7.a": "–NH₂",
  "pregunta.chile.quimica.m2.funcionales.7.b": "–OH",
  "pregunta.chile.quimica.m2.funcionales.7.c": "–COOH",
  "pregunta.chile.quimica.m2.funcionales.7.por_que": "Contienen nitrógeno.",
  "pregunta.chile.quimica.m2.funcionales.8": "¿Por qué el plástico tarda tanto en degradarse?",
