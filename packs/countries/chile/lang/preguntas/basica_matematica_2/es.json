  "tema.chile.matematica.2.sumar_restar": "Sumar y restar hasta 100",
  "tema.chile.matematica.2.sumar_restar.texto": "Para sumar 34 + 25 se juntan decenas con decenas (30 + 20 = 50) y unidades con unidades (4 + 5 = 9): 59.\n\nSi las unidades suman más de 10 se forma una decena nueva: 27 + 15 = 42. Para restar 56 − 23 se quitan decenas y unidades: 33. Restar es lo contrario de sumar.",
  "pregunta.chile.matematica.2.sumar_restar.1": "¿Cuánto es 34 + 25?",
  "pregunta.chile.matematica.2.sumar_restar.1.a": "59",
  "pregunta.chile.matematica.2.sumar_restar.1.b": "69",
  "pregunta.chile.matematica.2.sumar_restar.1.c": "58",
  "pregunta.chile.matematica.2.sumar_restar.1.por_que": "30 + 20 = 50 y 4 + 5 = 9.",
  "pregunta.chile.matematica.2.sumar_restar.2": "¿Cuánto es 27 + 15?",
  "pregunta.chile.matematica.2.sumar_restar.2.a": "32",
  "pregunta.chile.matematica.2.sumar_restar.2.b": "42",
  "pregunta.chile.matematica.2.sumar_restar.2.c": "312",
  "pregunta.chile.matematica.2.sumar_restar.2.por_que": "7 + 5 = 12: una decena nueva. 20 + 10 + 10 + 2 = 42.",
  "pregunta.chile.matematica.2.sumar_restar.3": "¿Cuánto es 56 − 23?",
  "pregunta.chile.matematica.2.sumar_restar.3.a": "43",
  "pregunta.chile.matematica.2.sumar_restar.3.b": "79",
  "pregunta.chile.matematica.2.sumar_restar.3.c": "33",
  "pregunta.chile.matematica.2.sumar_restar.3.por_que": "50 − 20 = 30 y 6 − 3 = 3.",
  "pregunta.chile.matematica.2.sumar_restar.4": "¿Cuánto es 40 + 40?",
  "pregunta.chile.matematica.2.sumar_restar.4.a": "80",
  "pregunta.chile.matematica.2.sumar_restar.4.b": "44",
  "pregunta.chile.matematica.2.sumar_restar.4.c": "800",
  "pregunta.chile.matematica.2.sumar_restar.4.por_que": "4 decenas + 4 decenas = 8 decenas.",
  "pregunta.chile.matematica.2.sumar_restar.5": "¿Cuánto es 90 − 30?",
