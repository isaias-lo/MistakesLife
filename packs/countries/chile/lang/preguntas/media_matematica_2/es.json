{
  "tema.chile.matematica.m2.raices": "Raíces y logaritmos",
  "tema.chile.matematica.m2.raices.texto": "Una raíz enésima es una potencia de exponente fraccionario: ⁿ√a = a^(1/n). Para multiplicar raíces de igual índice se multiplican las cantidades: √2 · √8 = √16 = 4.\n\nEl logaritmo responde a qué exponente hay que elevar una base para obtener un número: log₂ 8 = 3, porque 2³ = 8. Propiedades: log(a·b) = log a + log b; log(aⁿ) = n · log a.",
  "pregunta.chile.matematica.m2.raices.1": "¿Cuánto es √2 · √8?",
  "pregunta.chile.matematica.m2.raices.1.a": "4",
  "pregunta.chile.matematica.m2.raices.1.b": "√10",
  "pregunta.chile.matematica.m2.raices.1.c": "16",
  "pregunta.chile.matematica.m2.raices.1.por_que": "√16 = 4.",
  "pregunta.chile.matematica.m2.raices.2": "¿Cuánto es log₂ 8?",
  "pregunta.chile.matematica.m2.raices.2.a": "4",
  "pregunta.chile.matematica.m2.raices.2.b": "3",
  "pregunta.chile.matematica.m2.raices.2.c": "16",
  "pregunta.chile.matematica.m2.raices.2.por_que": "2³ = 8.",
  "pregunta.chile.matematica.m2.raices.3": "¿Cuánto es log₁₀ 1 000?",
  "pregunta.chile.matematica.m2.raices.3.a": "100",
  "pregunta.chile.matematica.m2.raices.3.b": "10",
  "pregunta.chile.matematica.m2.raices.3.c": "3",
  "pregunta.chile.matematica.m2.raices.3.por_que": "10³ = 1 000.",
  "pregunta.chile.matematica.m2.raices.4": "¿A qué es igual ∛a?",
  "pregunta.chile.matematica.m2.raices.4.a": "a^(1/3)",
  "pregunta.chile.matematica.m2.raices.4.b": "a³",
  "pregunta.chile.matematica.m2.raices.4.c": "3a",
  "pregunta.chile.matematica.m2.raices.4.por_que": "Raíz cúbica = exponente 1/3.",
  "pregunta.chile.matematica.m2.raices.5": "¿Cuánto es log 1 en cualquier base?",
  "pregunta.chile.matematica.m2.raices.5.a": "1",
  "pregunta.chile.matematica.m2.raices.5.b": "0",
  "pregunta.chile.matematica.m2.raices.5.c": "10",
  "pregunta.chile.matematica.m2.raices.5.por_que": "Toda base elevada a 0 da 1.",
  "pregunta.chile.matematica.m2.raices.6": "Racionaliza 1/√2",
  "pregunta.chile.matematica.m2.raices.6.a": "2/√2",
  "pregunta.chile.matematica.m2.raices.6.b": "√2",
  "pregunta.chile.matematica.m2.raices.6.c": "√2/2",
  "pregunta.chile.matematica.m2.raices.6.por_que": "Se multiplica arriba y abajo por √2.",
  "pregunta.chile.matematica.m2.raices.7": "¿Cuánto es log₃ 81?",
  "pregunta.chile.matematica.m2.raices.7.a": "4",
  "pregunta.chile.matematica.m2.raices.7.b": "27",
  "pregunta.chile.matematica.m2.raices.7.c": "3",
  "pregunta.chile.matematica.m2.raices.7.por_que": "3⁴ = 81.",
  "pregunta.chile.matematica.m2.raices.8": "¿Cuánto es log 2 + log 5 (base 10)?",
  "pregunta.chile.matematica.m2.raices.8.a": "7",
  "pregunta.chile.matematica.m2.raices.8.b": "1",
  "pregunta.chile.matematica.m2.raices.8.c": "log 7",
  "pregunta.chile.matematica.m2.raices.8.por_que": "log(2·5) = log 10 = 1.",
  "pregunta.chile.matematica.m2.raices.9": "¿Cuánto es √50 simplificado?",
  "pregunta.chile.matematica.m2.raices.9.a": "25√2",
  "pregunta.chile.matematica.m2.raices.9.b": "10√5",
  "pregunta.chile.matematica.m2.raices.9.c": "5√2",
  "pregunta.chile.matematica.m2.raices.9.por_que": "√(25·2).",
  "pregunta.chile.matematica.m2.raices.10": "¿Cuánto es 8^(2/3)?",
  "pregunta.chile.matematica.m2.raices.10.a": "4",
  "pregunta.chile.matematica.m2.raices.10.b": "16",
  "pregunta.chile.matematica.m2.raices.10.c": "2",
  "pregunta.chile.matematica.m2.raices.10.por_que": "(∛8)² = 2² = 4.",
  "tema.chile.matematica.m2.cuadratica": "Función y ecuación cuadrática",
  "tema.chile.matematica.m2.cuadratica.texto": "La función cuadrática f(x) = ax² + bx + c tiene como gráfico una parábola. Si a > 0 abre hacia arriba; si a < 0, hacia abajo. El vértice está en x = −b/2a.\n\nLas soluciones de ax² + bx + c = 0 se obtienen con x = (−b ± √(b² − 4ac)) / 2a. El discriminante b² − 4ac indica cuántas soluciones reales hay: positivo, dos; cero, una; negativo, ninguna.",
  "pregunta.chile.matematica.m2.cuadratica.1": "¿Qué gráfico tiene una función cuadrática?",
  "pregunta.chile.matematica.m2.cuadratica.1.a": "Una parábola",
  "pregunta.chile.matematica.m2.cuadratica.1.b": "Una recta",
  "pregunta.chile.matematica.m2.cuadratica.1.c": "Un círculo",
  "pregunta.chile.matematica.m2.cuadratica.1.por_que": "Forma de U o U invertida.",
  "pregunta.chile.matematica.m2.cuadratica.2": "Si a < 0, ¿hacia dónde abre la parábola?",
  "pregunta.chile.matematica.m2.cuadratica.2.a": "Hacia arriba",
  "pregunta.chile.matematica.m2.cuadratica.2.b": "Hacia abajo",
  "pregunta.chile.matematica.m2.cuadratica.2.c": "Hacia la derecha",
  "pregunta.chile.matematica.m2.cuadratica.2.por_que": "Tiene un máximo.",
  "pregunta.chile.matematica.m2.cuadratica.3": "Resuelve x² − 9 = 0",
  "pregunta.chile.matematica.m2.cuadratica.3.a": "x = 9",
  "pregunta.chile.matematica.m2.cuadratica.3.b": "x = 3 solamente",
  "pregunta.chile.matematica.m2.cuadratica.3.c": "x = 3 o x = −3",
  "pregunta.chile.matematica.m2.cuadratica.3.por_que": "x² = 9.",
  "pregunta.chile.matematica.m2.cuadratica.4": "Resuelve x² − 5x + 6 = 0",
  "pregunta.chile.matematica.m2.cuadratica.4.a": "x = 2 o x = 3",
  "pregunta.chile.matematica.m2.cuadratica.4.b": "x = −2 o x = −3",
  "pregunta.chile.matematica.m2.cuadratica.4.c": "x = 1 o x = 6",
  "pregunta.chile.matematica.m2.cuadratica.4.por_que": "(x − 2)(x − 3) = 0.",
  "pregunta.chile.matematica.m2.cuadratica.5": "¿Dónde está el vértice de f(x) = x² − 4x + 1?",
  "pregunta.chile.matematica.m2.cuadratica.5.a": "En x = −2",
  "pregunta.chile.matematica.m2.cuadratica.5.b": "En x = 2",
  "pregunta.chile.matematica.m2.cuadratica.5.c": "En x = 4",
  "pregunta.chile.matematica.m2.cuadratica.5.por_que": "x = −b/2a = 4/2.",
  "pregunta.chile.matematica.m2.cuadratica.6": "Si el discriminante es negativo, ¿cuántas soluciones reales hay?",
  "pregunta.chile.matematica.m2.cuadratica.6.a": "Dos",
  "pregunta.chile.matematica.m2.cuadratica.6.b": "Una",
  "pregunta.chile.matematica.m2.cuadratica.6.c": "Ninguna",
  "pregunta.chile.matematica.m2.cuadratica.6.por_que": "La parábola no corta el eje x.",
  "pregunta.chile.matematica.m2.cuadratica.7": "¿Cuál es el discriminante de x² + 2x + 1?",
  "pregunta.chile.matematica.m2.cuadratica.7.a": "0",
  "pregunta.chile.matematica.m2.cuadratica.7.b": "4",
  "pregunta.chile.matematica.m2.cuadratica.7.c": "8",
  "pregunta.chile.matematica.m2.cuadratica.7.por_que": "4 − 4 = 0: una solución.",
  "pregunta.chile.matematica.m2.cuadratica.8": "¿Dónde corta f(x) = x² + 3x + 5 al eje y?",
  "pregunta.chile.matematica.m2.cuadratica.8.a": "En 3",
  "pregunta.chile.matematica.m2.cuadratica.8.b": "En 5",
  "pregunta.chile.matematica.m2.cuadratica.8.c": "En 0",
  "pregunta.chile.matematica.m2.cuadratica.8.por_que": "Cuando x = 0, f = c.",
  "pregunta.chile.matematica.m2.cuadratica.9": "Resuelve x² = 4x",
  "pregunta.chile.matematica.m2.cuadratica.9.a": "x = 4",
  "pregunta.chile.matematica.m2.cuadratica.9.b": "x = 2",
  "pregunta.chile.matematica.m2.cuadratica.9.c": "x = 0 o x = 4",
  "pregunta.chile.matematica.m2.cuadratica.9.por_que": "x(x − 4) = 0.",
  "pregunta.chile.matematica.m2.cuadratica.10": "Un objeto lanzado sigue h(t) = −5t² + 20t. ¿En qué instante alcanza su altura máxima?",
  "pregunta.chile.matematica.m2.cuadratica.10.a": "t = 2",
  "pregunta.chile.matematica.m2.cuadratica.10.b": "t = 4",
  "pregunta.chile.matematica.m2.cuadratica.10.c": "t = 20",
  "pregunta.chile.matematica.m2.cuadratica.10.por_que": "t = −b/2a = 20/10.",
  "tema.chile.matematica.m2.trigonometria": "Trigonometría",
  "tema.chile.matematica.m2.trigonometria.texto": "En un triángulo rectángulo, las razones trigonométricas relacionan un ángulo agudo con sus lados: seno = cateto opuesto / hipotenusa; coseno = cateto adyacente / hipotenusa; tangente = opuesto / adyacente.\n\nValores conocidos: sen 30° = 0,5; cos 60° = 0,5; tan 45° = 1. Sirven para calcular alturas y distancias que no se pueden medir directamente.",
  "pregunta.chile.matematica.m2.trigonometria.1": "¿Qué es el seno de un ángulo?",
  "pregunta.chile.matematica.m2.trigonometria.1.a": "Cateto opuesto / hipotenusa",
  "pregunta.chile.matematica.m2.trigonometria.1.b": "Cateto adyacente / hipotenusa",
  "pregunta.chile.matematica.m2.trigonometria.1.c": "Opuesto / adyacente",
  "pregunta.chile.matematica.m2.trigonometria.1.por_que": "SOH-CAH-TOA.",
  "pregunta.chile.matematica.m2.trigonometria.2": "¿Cuánto vale sen 30°?",
  "pregunta.chile.matematica.m2.trigonometria.2.a": "1",
  "pregunta.chile.matematica.m2.trigonometria.2.b": "0,5",
  "pregunta.chile.matematica.m2.trigonometria.2.c": "0,87",
  "pregunta.chile.matematica.m2.trigonometria.2.por_que": "sen 30° = 1/2.",
  "pregunta.chile.matematica.m2.trigonometria.3": "¿Cuánto vale tan 45°?",
  "pregunta.chile.matematica.m2.trigonometria.3.a": "0",
  "pregunta.chile.matematica.m2.trigonometria.3.b": "0,5",
  "pregunta.chile.matematica.m2.trigonometria.3.c": "1",
  "pregunta.chile.matematica.m2.trigonometria.3.por_que": "Catetos iguales.",
  "pregunta.chile.matematica.m2.trigonometria.4": "¿Qué es la tangente?",
  "pregunta.chile.matematica.m2.trigonometria.4.a": "Opuesto / adyacente",
  "pregunta.chile.matematica.m2.trigonometria.4.b": "Opuesto / hipotenusa",
  "pregunta.chile.matematica.m2.trigonometria.4.c": "Hipotenusa / opuesto",
  "pregunta.chile.matematica.m2.trigonometria.4.por_que": "También sen/cos.",
  "pregunta.chile.matematica.m2.trigonometria.5": "Si la hipotenusa mide 10 y el ángulo es 30°, ¿cuánto mide el cateto opuesto?",
  "pregunta.chile.matematica.m2.trigonometria.5.a": "10",
  "pregunta.chile.matematica.m2.trigonometria.5.b": "5",
  "pregunta.chile.matematica.m2.trigonometria.5.c": "8,66",
  "pregunta.chile.matematica.m2.trigonometria.5.por_que": "10 · sen 30°.",
  "pregunta.chile.matematica.m2.trigonometria.6": "¿Cuánto vale cos 60°?",
  "pregunta.chile.matematica.m2.trigonometria.6.a": "1",
  "pregunta.chile.matematica.m2.trigonometria.6.b": "0",
  "pregunta.chile.matematica.m2.trigonometria.6.c": "0,5",
  "pregunta.chile.matematica.m2.trigonometria.6.por_que": "cos 60° = 1/2.",
  "pregunta.chile.matematica.m2.trigonometria.7": "Desde 20 m de un edificio se ve su punta con un ángulo de 45°. ¿Cuánto mide de alto?",
  "pregunta.chile.matematica.m2.trigonometria.7.a": "20 m",
  "pregunta.chile.matematica.m2.trigonometria.7.b": "10 m",
  "pregunta.chile.matematica.m2.trigonometria.7.c": "40 m",
  "pregunta.chile.matematica.m2.trigonometria.7.por_que": "tan 45° = h/20.",
  "pregunta.chile.matematica.m2.trigonometria.8": "¿Cuánto vale sen² x + cos² x?",
  "pregunta.chile.matematica.m2.trigonometria.8.a": "0",
  "pregunta.chile.matematica.m2.trigonometria.8.b": "1",
  "pregunta.chile.matematica.m2.trigonometria.8.c": "2",
  "pregunta.chile.matematica.m2.trigonometria.8.por_que": "Identidad fundamental.",
  "pregunta.chile.matematica.m2.trigonometria.9": "¿Cuánto vale cos 0°?",
  "pregunta.chile.matematica.m2.trigonometria.9.a": "0",
  "pregunta.chile.matematica.m2.trigonometria.9.b": "0,5",
  "pregunta.chile.matematica.m2.trigonometria.9.c": "1",
  "pregunta.chile.matematica.m2.trigonometria.9.por_que": "El adyacente igual a la hipotenusa.",
  "pregunta.chile.matematica.m2.trigonometria.10": "¿Para qué sirve la trigonometría?",
  "pregunta.chile.matematica.m2.trigonometria.10.a": "Para calcular distancias y alturas indirectamente",
  "pregunta.chile.matematica.m2.trigonometria.10.b": "Para sumar fracciones",
  "pregunta.chile.matematica.m2.trigonometria.10.c": "Para hacer gráficos de barras",
  "pregunta.chile.matematica.m2.trigonometria.10.por_que": "Se usa en topografía y navegación.",
  "tema.chile.matematica.m2.combinatoria": "Combinatoria y probabilidad",
  "tema.chile.matematica.m2.combinatoria.texto": "Las permutaciones cuentan de cuántas formas se ordenan n elementos: n! (factorial). Con 4 personas en fila: 4! = 24. Las combinaciones cuentan grupos donde el orden no importa: elegir 2 de 4 da 6 grupos.\n\nLa probabilidad condicional P(A|B) es la probabilidad de A sabiendo que ocurrió B. Si A y B son independientes, P(A y B) = P(A) · P(B).",
  "pregunta.chile.matematica.m2.combinatoria.1": "¿Cuánto es 4!?",
  "pregunta.chile.matematica.m2.combinatoria.1.a": "24",
  "pregunta.chile.matematica.m2.combinatoria.1.b": "16",
  "pregunta.chile.matematica.m2.combinatoria.1.c": "10",
  "pregunta.chile.matematica.m2.combinatoria.1.por_que": "4 · 3 · 2 · 1.",
  "pregunta.chile.matematica.m2.combinatoria.2": "¿De cuántas formas se ordenan 3 libros en un estante?",
  "pregunta.chile.matematica.m2.combinatoria.2.a": "3",
  "pregunta.chile.matematica.m2.combinatoria.2.b": "6",
  "pregunta.chile.matematica.m2.combinatoria.2.c": "9",
  "pregunta.chile.matematica.m2.combinatoria.2.por_que": "3! = 6.",
  "pregunta.chile.matematica.m2.combinatoria.3": "¿Cuántos grupos de 2 se forman con 4 personas?",
  "pregunta.chile.matematica.m2.combinatoria.3.a": "8",
  "pregunta.chile.matematica.m2.combinatoria.3.b": "12",
  "pregunta.chile.matematica.m2.combinatoria.3.c": "6",
  "pregunta.chile.matematica.m2.combinatoria.3.por_que": "C(4,2) = 6.",
  "pregunta.chile.matematica.m2.combinatoria.4": "¿En qué se diferencian permutaciones y combinaciones?",
  "pregunta.chile.matematica.m2.combinatoria.4.a": "En las permutaciones importa el orden",
  "pregunta.chile.matematica.m2.combinatoria.4.b": "En las combinaciones importa el orden",
  "pregunta.chile.matematica.m2.combinatoria.4.c": "Son lo mismo",
  "pregunta.chile.matematica.m2.combinatoria.4.por_que": "Un podio es permutación; un equipo, combinación.",
  "pregunta.chile.matematica.m2.combinatoria.5": "¿Cuánto es 0!?",
  "pregunta.chile.matematica.m2.combinatoria.5.a": "0",
  "pregunta.chile.matematica.m2.combinatoria.5.b": "1",
  "pregunta.chile.matematica.m2.combinatoria.5.c": "No existe",
  "pregunta.chile.matematica.m2.combinatoria.5.por_que": "Por definición.",
  "pregunta.chile.matematica.m2.combinatoria.6": "¿Qué es P(A|B)?",
  "pregunta.chile.matematica.m2.combinatoria.6.a": "La probabilidad de A más B",
  "pregunta.chile.matematica.m2.combinatoria.6.b": "La probabilidad de que no ocurra A",
  "pregunta.chile.matematica.m2.combinatoria.6.c": "La probabilidad de A sabiendo que ocurrió B",
  "pregunta.chile.matematica.m2.combinatoria.6.por_que": "Probabilidad condicional.",
  "pregunta.chile.matematica.m2.combinatoria.7": "Si P(A) = 0,5 y P(B) = 0,4 y son independientes, ¿cuánto es P(A y B)?",
  "pregunta.chile.matematica.m2.combinatoria.7.a": "0,2",
  "pregunta.chile.matematica.m2.combinatoria.7.b": "0,9",
  "pregunta.chile.matematica.m2.combinatoria.7.c": "0,1",
  "pregunta.chile.matematica.m2.combinatoria.7.por_que": "0,5 · 0,4.",
  "pregunta.chile.matematica.m2.combinatoria.8": "¿De cuántas formas puede haber 1º, 2º y 3º lugar entre 5 corredores?",
  "pregunta.chile.matematica.m2.combinatoria.8.a": "10",
  "pregunta.chile.matematica.m2.combinatoria.8.b": "60",
  "pregunta.chile.matematica.m2.combinatoria.8.c": "125",
  "pregunta.chile.matematica.m2.combinatoria.8.por_que": "5 · 4 · 3.",
  "pregunta.chile.matematica.m2.combinatoria.9": "¿Cuántas combinaciones de 3 se pueden hacer con 5 elementos?",
  "pregunta.chile.matematica.m2.combinatoria.9.a": "15",
  "pregunta.chile.matematica.m2.combinatoria.9.b": "60",
  "pregunta.chile.matematica.m2.combinatoria.9.c": "10",
  "pregunta.chile.matematica.m2.combinatoria.9.por_que": "C(5,3) = 10.",
  "pregunta.chile.matematica.m2.combinatoria.10": "Se saca una carta roja de una baraja inglesa. ¿Probabilidad de que sea corazón?",
  "pregunta.chile.matematica.m2.combinatoria.10.a": "1/2",
  "pregunta.chile.matematica.m2.combinatoria.10.b": "1/4",
  "pregunta.chile.matematica.m2.combinatoria.10.c": "1/13",
  "pregunta.chile.matematica.m2.combinatoria.10.por_que": "De 26 rojas, 13 son corazones."
}
