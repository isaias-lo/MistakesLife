  "pregunta.software.desarrollo_movil.4.datos.5.a": "En una imagen",
  "pregunta.software.desarrollo_movil.4.datos.5.b": "En las preferencias locales de la app",
  "pregunta.software.desarrollo_movil.4.datos.5.c": "En un correo",
  "pregunta.software.desarrollo_movil.4.datos.5.por_que": "Ajuste simple."
