{
  "tema.software.arquitectura_software.6.capas": "Arquitectura en capas",
  "tema.software.arquitectura_software.6.capas.texto": "Una arquitectura en capas separa presentación, lógica de negocio y datos. Cada capa solo habla con la de al lado. Así se puede cambiar la base de datos sin tocar la interfaz.",
  "pregunta.software.arquitectura_software.6.capas.1": "¿Qué capas tiene una arquitectura típica en capas?",
  "pregunta.software.arquitectura_software.6.capas.1.a": "Presentación, negocio y datos",
  "pregunta.software.arquitectura_software.6.capas.1.b": "Rojo, verde y azul",
  "pregunta.software.arquitectura_software.6.capas.1.c": "Solo una",
  "pregunta.software.arquitectura_software.6.capas.1.por_que": "Tres capas.",
  "pregunta.software.arquitectura_software.6.capas.2": "¿Qué ventaja tiene separar capas?",
  "pregunta.software.arquitectura_software.6.capas.2.a": "Ninguna",
  "pregunta.software.arquitectura_software.6.capas.2.b": "Cambiar una parte sin romper las otras",
  "pregunta.software.arquitectura_software.6.capas.2.c": "Que sea más difícil",
  "pregunta.software.arquitectura_software.6.capas.2.por_que": "Mantenibilidad.",
  "pregunta.software.arquitectura_software.6.capas.3": "¿Dónde van las reglas del negocio?",
  "pregunta.software.arquitectura_software.6.capas.3.a": "En la de presentación",
  "pregunta.software.arquitectura_software.6.capas.3.b": "En el CSS",
  "pregunta.software.arquitectura_software.6.capas.3.c": "En la capa de negocio",
  "pregunta.software.arquitectura_software.6.capas.3.por_que": "Lógica.",
  "pregunta.software.arquitectura_software.6.capas.4": "¿Qué hace la capa de datos?",
  "pregunta.software.arquitectura_software.6.capas.4.a": "Lee y guarda en la base de datos",
  "pregunta.software.arquitectura_software.6.capas.4.b": "Dibuja pantallas",
  "pregunta.software.arquitectura_software.6.capas.4.c": "Envía correos de marketing",
  "pregunta.software.arquitectura_software.6.capas.4.por_que": "Persistencia.",
  "pregunta.software.arquitectura_software.6.capas.5": "¿Qué es el acoplamiento?",
  "pregunta.software.arquitectura_software.6.capas.5.a": "Un tipo de cable",
  "pregunta.software.arquitectura_software.6.capas.5.b": "Cuánto depende un módulo de otro",
  "pregunta.software.arquitectura_software.6.capas.5.c": "Una base de datos",
  "pregunta.software.arquitectura_software.6.capas.5.por_que": "Bajo es mejor.",
  "tema.software.arquitectura_software.6.microservicios": "Monolito y microservicios",
  "tema.software.arquitectura_software.6.microservicios.texto": "Un monolito es una sola aplicación con todo adentro. Los microservicios dividen el sistema en servicios pequeños e independientes que se comunican por la red.\n\nLos microservicios escalan por partes pero son más complejos de operar.",
  "pregunta.software.arquitectura_software.6.microservicios.1": "¿Qué es un monolito?",
  "pregunta.software.arquitectura_software.6.microservicios.1.a": "Una sola aplicación con todas sus partes juntas",
  "pregunta.software.arquitectura_software.6.microservicios.1.b": "Una piedra",
  "pregunta.software.arquitectura_software.6.microservicios.1.c": "Un microservicio",
  "pregunta.software.arquitectura_software.6.microservicios.1.por_que": "Un despliegue.",
  "pregunta.software.arquitectura_software.6.microservicios.2": "¿Qué ventaja tienen los microservicios?",
  "pregunta.software.arquitectura_software.6.microservicios.2.a": "Son siempre más simples",
  "pregunta.software.arquitectura_software.6.microservicios.2.b": "Escalar y desplegar partes por separado",
  "pregunta.software.arquitectura_software.6.microservicios.2.c": "No usan red",
  "pregunta.software.arquitectura_software.6.microservicios.2.por_que": "Independencia.",
  "pregunta.software.arquitectura_software.6.microservicios.3": "¿Qué desventaja tienen los microservicios?",
  "pregunta.software.arquitectura_software.6.microservicios.3.a": "No escalan",
  "pregunta.software.arquitectura_software.6.microservicios.3.b": "No se pueden probar",
  "pregunta.software.arquitectura_software.6.microservicios.3.c": "Son más complejos de operar",
  "pregunta.software.arquitectura_software.6.microservicios.3.por_que": "Red, monitoreo.",
  "pregunta.software.arquitectura_software.6.microservicios.4": "¿Cómo se comunican los microservicios?",
  "pregunta.software.arquitectura_software.6.microservicios.4.a": "Por la red (APIs o mensajes)",
  "pregunta.software.arquitectura_software.6.microservicios.4.b": "Por correo postal",
  "pregunta.software.arquitectura_software.6.microservicios.4.c": "No se comunican",
  "pregunta.software.arquitectura_software.6.microservicios.4.por_que": "HTTP, colas.",
  "pregunta.software.arquitectura_software.6.microservicios.5": "¿Qué conviene a un proyecto chico que recién parte?",
  "pregunta.software.arquitectura_software.6.microservicios.5.a": "100 microservicios",
  "pregunta.software.arquitectura_software.6.microservicios.5.b": "Muchas veces un monolito bien ordenado",
  "pregunta.software.arquitectura_software.6.microservicios.5.c": "Ninguna arquitectura",
  "pregunta.software.arquitectura_software.6.microservicios.5.por_que": "Simplicidad primero.",
  "tema.software.arquitectura_software.6.patrones": "Patrones de diseño",
  "tema.software.arquitectura_software.6.patrones.texto": "Los patrones son soluciones conocidas a problemas comunes. Singleton asegura una sola instancia; Observer avisa a varios objetos cuando algo cambia; Factory crea objetos sin decir su clase exacta.",
  "pregunta.software.arquitectura_software.6.patrones.1": "¿Qué hace el patrón Singleton?",
  "pregunta.software.arquitectura_software.6.patrones.1.a": "Asegura una sola instancia de una clase",
  "pregunta.software.arquitectura_software.6.patrones.1.b": "Crea muchas copias",
  "pregunta.software.arquitectura_software.6.patrones.1.c": "Borra objetos",
  "pregunta.software.arquitectura_software.6.patrones.1.por_que": "Ej.: configuración global.",
  "pregunta.software.arquitectura_software.6.patrones.2": "¿Qué hace el patrón Observer?",
  "pregunta.software.arquitectura_software.6.patrones.2.a": "Oculta datos",
  "pregunta.software.arquitectura_software.6.patrones.2.b": "Avisa a varios objetos cuando algo cambia",
  "pregunta.software.arquitectura_software.6.patrones.2.c": "Ordena listas",
  "pregunta.software.arquitectura_software.6.patrones.2.por_que": "Suscriptores.",
  "pregunta.software.arquitectura_software.6.patrones.3": "¿Para qué sirve el patrón Factory?",
  "pregunta.software.arquitectura_software.6.patrones.3.a": "Para fabricar hardware",
  "pregunta.software.arquitectura_software.6.patrones.3.b": "Para borrar clases",
  "pregunta.software.arquitectura_software.6.patrones.3.c": "Para crear objetos sin acoplarse a su clase exacta",
  "pregunta.software.arquitectura_software.6.patrones.3.por_que": "Creación.",
  "pregunta.software.arquitectura_software.6.patrones.4": "¿Qué libro famoso reunió 23 patrones de diseño?",
  "pregunta.software.arquitectura_software.6.patrones.4.a": "Design Patterns, de la \"Banda de los Cuatro\"",
  "pregunta.software.arquitectura_software.6.patrones.4.b": "El Quijote",
  "pregunta.software.arquitectura_software.6.patrones.4.c": "Clean Code",
  "pregunta.software.arquitectura_software.6.patrones.4.por_que": "1994.",
  "pregunta.software.arquitectura_software.6.patrones.5": "¿Qué es un antipatrón?",
  "pregunta.software.arquitectura_software.6.patrones.5.a": "Un patrón muy bueno",
  "pregunta.software.arquitectura_software.6.patrones.5.b": "Una solución común que trae más problemas",
  "pregunta.software.arquitectura_software.6.patrones.5.c": "Un virus",
  "pregunta.software.arquitectura_software.6.patrones.5.por_que": "Ej.: objeto Dios.",
  "tema.software.arquitectura_software.6.calidad": "Atributos de calidad",
  "tema.software.arquitectura_software.6.calidad.texto": "La arquitectura se decide pensando en atributos de calidad: rendimiento, disponibilidad, seguridad, escalabilidad y mantenibilidad. Mejorar uno puede empeorar otro: son compromisos.",
  "pregunta.software.arquitectura_software.6.calidad.1": "¿Qué es la escalabilidad?",
  "pregunta.software.arquitectura_software.6.calidad.1.a": "La capacidad de atender más carga agregando recursos",
  "pregunta.software.arquitectura_software.6.calidad.1.b": "Un tipo de escalera",
  "pregunta.software.arquitectura_software.6.calidad.1.c": "La seguridad",
  "pregunta.software.arquitectura_software.6.calidad.1.por_que": "Más usuarios.",
  "pregunta.software.arquitectura_software.6.calidad.2": "¿Qué es la disponibilidad?",
  "pregunta.software.arquitectura_software.6.calidad.2.a": "La velocidad",
  "pregunta.software.arquitectura_software.6.calidad.2.b": "El tiempo que el sistema está funcionando",
  "pregunta.software.arquitectura_software.6.calidad.2.c": "El precio",
  "pregunta.software.arquitectura_software.6.calidad.2.por_que": "Ej.: 99,9 %.",
  "pregunta.software.arquitectura_software.6.calidad.3": "¿Por qué se habla de compromisos (trade-offs)?",
  "pregunta.software.arquitectura_software.6.calidad.3.a": "Porque todo se mejora a la vez",
  "pregunta.software.arquitectura_software.6.calidad.3.b": "No existen",
  "pregunta.software.arquitectura_software.6.calidad.3.c": "Porque mejorar un atributo puede empeorar otro",
  "pregunta.software.arquitectura_software.6.calidad.3.por_que": "Ej.: seguridad vs. rapidez.",
  "pregunta.software.arquitectura_software.6.calidad.4": "¿Qué es la mantenibilidad?",
  "pregunta.software.arquitectura_software.6.calidad.4.a": "Qué tan fácil es cambiar y corregir el sistema",
  "pregunta.software.arquitectura_software.6.calidad.4.b": "Cuánta memoria usa",
  "pregunta.software.arquitectura_software.6.calidad.4.c": "Cuántos usuarios tiene",
  "pregunta.software.arquitectura_software.6.calidad.4.por_que": "Código claro.",
  "pregunta.software.arquitectura_software.6.calidad.5": "Un 99,9 % de disponibilidad al año permite caídas de unas:",
  "pregunta.software.arquitectura_software.6.calidad.5.a": "5 minutos",
  "pregunta.software.arquitectura_software.6.calidad.5.b": "9 horas",
  "pregunta.software.arquitectura_software.6.calidad.5.c": "30 días",
  "pregunta.software.arquitectura_software.6.calidad.5.por_que": "0,1 % de 8.760 h."
}
