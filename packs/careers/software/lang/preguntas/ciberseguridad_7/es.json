  "pregunta.software.ciberseguridad.7.cia.3.por_que": "DDoS.",
  "pregunta.software.ciberseguridad.7.cia.4": "¿Qué ley chilena de 2024 crea la Agencia Nacional de Ciberseguridad?",
  "pregunta.software.ciberseguridad.7.cia.4.a": "La Ley Marco de Ciberseguridad (21.663)",
  "pregunta.software.ciberseguridad.7.cia.4.b": "La Ley Zamudio",
  "pregunta.software.ciberseguridad.7.cia.4.c": "La Ley de Etiquetado",
  "pregunta.software.ciberseguridad.7.cia.4.por_que": "ANCI.",
  "pregunta.software.ciberseguridad.7.cia.5": "¿Qué es el cifrado?",
