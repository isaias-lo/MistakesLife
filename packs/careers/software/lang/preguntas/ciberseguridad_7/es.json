{
  "tema.software.ciberseguridad.7.cia": "Confidencialidad, integridad y disponibilidad",
  "tema.software.ciberseguridad.7.cia.texto": "La seguridad de la información protege tres cosas: confidencialidad (solo quien debe ve los datos), integridad (los datos no se alteran sin permiso) y disponibilidad (el sistema funciona cuando se necesita).",
  "pregunta.software.ciberseguridad.7.cia.1": "¿Qué protege la confidencialidad?",
  "pregunta.software.ciberseguridad.7.cia.1.a": "Que solo quien debe vea los datos",
  "pregunta.software.ciberseguridad.7.cia.1.b": "Que el sistema sea rápido",
  "pregunta.software.ciberseguridad.7.cia.1.c": "Que los datos sean bonitos",
  "pregunta.software.ciberseguridad.7.cia.1.por_que": "Tríada CIA.",
  "pregunta.software.ciberseguridad.7.cia.2": "¿Qué protege la integridad?",
  "pregunta.software.ciberseguridad.7.cia.2.a": "Que se vean",
  "pregunta.software.ciberseguridad.7.cia.2.b": "Que los datos no se alteren sin permiso",
  "pregunta.software.ciberseguridad.7.cia.2.c": "Que se borren",
  "pregunta.software.ciberseguridad.7.cia.2.por_que": "Exactitud.",
