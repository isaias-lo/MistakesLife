  "pregunta.software.base_datos.4.transacciones.1.a": "Atomicidad: todo o nada",
  "pregunta.software.base_datos.4.transacciones.1.b": "Ataque",
  "pregunta.software.base_datos.4.transacciones.1.c": "Ancho de banda",
  "pregunta.software.base_datos.4.transacciones.1.por_que": "Indivisible.",
  "pregunta.software.base_datos.4.transacciones.2": "¿Qué significa durabilidad?",
  "pregunta.software.base_datos.4.transacciones.2.a": "Que dure poco",
  "pregunta.software.base_datos.4.transacciones.2.b": "Que lo confirmado no se pierde aunque se caiga el sistema",
  "pregunta.software.base_datos.4.transacciones.2.c": "Que sea rápido",
  "pregunta.software.base_datos.4.transacciones.2.por_que": "Persistencia.",
  "pregunta.software.base_datos.4.transacciones.3": "¿Por qué una transferencia va en una transacción?",
  "pregunta.software.base_datos.4.transacciones.3.a": "Para que sea lenta",
  "pregunta.software.base_datos.4.transacciones.3.b": "No es necesario",
  "pregunta.software.base_datos.4.transacciones.3.c": "Para que no se descuente sin sumar en la otra cuenta",
  "pregunta.software.base_datos.4.transacciones.3.por_que": "Atomicidad.",
