  "tema.software.modelamiento_datos.3.agregacion.texto": "Las funciones de agregación resumen datos: COUNT cuenta, SUM suma, AVG promedia. GROUP BY agrupa: SELECT comuna, COUNT(*) FROM clientes GROUP BY comuna.\n\nHAVING filtra grupos; WHERE filtra filas.",
