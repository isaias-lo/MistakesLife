  {
    "id": "evento.software.tarea.bug_produccion",
    "con": "jefe",
    "condiciones": "jugador.tarea_pendiente == 'tarea.software.bug_produccion'",
    "probabilidad_anual": 1,
    "opciones": [
      {
        "texto": "opcion.software.tarea.bug_produccion.calma",
        "tendencia": "jugador.responsabilidad / 2 + 10",
        "efectos": [
          "jugador.hacer_tarea('calma')",
          "jugador.energia -= 8"
        ]
      },
      {
        "texto": "opcion.software.tarea.bug_produccion.rapido",
        "tendencia": "(100 - jugador.responsabilidad) / 3 + jugador.inteligencia / 4",
        "efectos": [
          "jugador.hacer_tarea('rapido')",
          "jugador.energia -= 2"
        ]
      },
      {
        "texto": "opcion.software.tarea.bug_produccion.ayuda",
        "condiciones": "jugador.colega != nada",
        "tendencia": "jugador.amabilidad / 3 + jugador.extraversion / 4",
        "efectos": [
          "jugador.hacer_tarea('ayuda')",
          "jugador.energia -= 4",
          "jugador.colega.carino += 2"
        ]
      },
      {
        "texto": "opcion.software.tarea.bug_produccion.dejar",
        "condiciones": "!jugador.tarea_postergada",
        "tendencia": "(100 - jugador.responsabilidad) / 4 + jugador.neuroticismo / 5",
        "efectos": [
          "jugador.hacer_tarea('dejar')",
          "jugador.energia += 3",
          "jugador.felicidad += 1"
        ]
      },
      {
        "texto": "opcion.tarea.saber",
        "condiciones": "jugador.tarea_con_preguntas",
        "tendencia": "jugador.inteligencia / 3 + jugador.responsabilidad / 5",
