    "peso": 100,
    "unico": true,
    "opciones": [
      {
        "texto": "opcion.contabilidad.balance.cuadrar",
        "tendencia": "jugador.responsabilidad",
        "efectos": [
          "jugador.inteligencia += 3",
          "jugador.felicidad -= 1"
        ]
      },
      {
        "texto": "opcion.contabilidad.balance.ayuda",
        "efectos": [
          "jugador.inteligencia += 2",
          "jugador.marcar('tiene_contacto')"
        ]
      },
      {
        "texto": "opcion.contabilidad.balance.dejar",
        "tendencia": "(100 - jugador.responsabilidad) / 3",
        "efectos": [
          "jugador.inteligencia -= 1"
        ]
      }
    ]
  },
  {
    "id": "evento.contabilidad.ramo_reprobado",
    "condiciones": "jugador.estudia == 'carrera.contabilidad' && jugador.inteligencia < 50",
    "peso": 6,
    "enfriamiento_semanas": 52,
    "efectos": [
      "jugador.felicidad -= 4",
      "jugador.semestres_aprobados -= 1",
      "jugador.inteligencia += 2",
      "diario('diario.contabilidad.ramo_reprobado')"
    ]
  },
  {
    "id": "evento.contabilidad.operacion_renta",
    "condiciones": "jugador.estudia == 'carrera.contabilidad' && jugador.semestres_aprobados >= 2",
    "peso": 8,
    "unico": true,
    "opciones": [
      {
        "texto": "opcion.contabilidad.renta.ayudar",
