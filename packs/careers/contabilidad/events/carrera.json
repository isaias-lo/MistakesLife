      },
      {
        "texto": "opcion.contabilidad.cierre.irse",
        "tendencia": "100 - jugador.responsabilidad",
        "efectos": [
          "jugador.felicidad += 1"
        ]
      }
    ]
  },
  {
    "id": "evento.contabilidad.fiscalizacion",
    "semilla": "semilla.contabilidad.gasto_falso",
    "peso": 10,
    "dia_clave": true,
    "opciones": [
      {
        "texto": "opcion.contabilidad.fiscalizacion.reconocer",
        "tendencia": "jugador.amabilidad / 2 + 20",
        "efectos": [
          "jugador.felicidad -= 4"
        ]
      },
      {
        "texto": "opcion.contabilidad.fiscalizacion.culpar",
        "tendencia": "(100 - jugador.amabilidad) / 2",
        "efectos": [
          "jugador.felicidad -= 1",
          "plantar('semilla.mentira_entrevista')"
        ]
      }
    ]
  },
  {
    "id": "evento.contabilidad.cliente_recomendado",
    "semilla": "semilla.contabilidad.cliente_recomendado",
    "peso": 10,
    "opciones": [
      {
        "texto": "opcion.contabilidad.cliente.aceptar",
        "efectos": [
          "jugador.felicidad += 4",
          "jugador.marcar('tiene_clientes_propios')"
        ]
      },
      {
        "texto": "opcion.contabilidad.cliente.rechazar"
      }
    ]
  }
]
