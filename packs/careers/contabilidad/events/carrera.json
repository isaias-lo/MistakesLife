          "plantar('semilla.contabilidad.cliente_recomendado')"
        ]
      },
      {
        "texto": "opcion.contabilidad.renta.cobrar",
        "efectos": [
          "jugador.felicidad += 2"
        ]
      },
      {
        "texto": "opcion.contabilidad.renta.no",
        "tendencia": "(100 - jugador.extraversion) / 3",
        "efectos": []
      }
    ]
  },
  {
    "id": "evento.contabilidad.practica",
    "condiciones": "jugador.estudia == 'carrera.contabilidad' && jugador.semestres_aprobados >= jugador.semestres_carrera - 2 && !jugador.tiene('hizo_practica')",
    "peso": 40,
    "unico": true,
    "opciones": [
      {
        "texto": "opcion.contabilidad.practica.auditora",
        "efectos": [
          "jugador.marcar('hizo_practica')",
          "jugador.marcar('practica_auditora')",
          "jugador.inteligencia += 2",
          "jugador.salud -= 2"
        ]
      },
      {
        "texto": "opcion.contabilidad.practica.estudio",
        "efectos": [
          "jugador.marcar('hizo_practica')",
          "jugador.inteligencia += 1"
        ]
      },
      {
        "texto": "opcion.contabilidad.practica.municipalidad",
        "efectos": [
          "jugador.marcar('hizo_practica')",
          "jugador.felicidad += 1"
        ]
      }
    ]
  },
  {
    "id": "evento.contabilidad.boleta_asado",
    "condiciones": "jugador.estudia == 'carrera.contabilidad' && jugador.tiene('hizo_practica')",
    "peso": 30,
    "unico": true,
    "dia_clave": true,
    "opciones": [
      {
        "texto": "opcion.contabilidad.boleta.registrar",
        "tendencia": "(100 - jugador.responsabilidad) / 3 + jugador.neuroticismo / 4",
        "efectos": [
          "plantar('semilla.contabilidad.gasto_falso')"
        ]
      },
      {
        "texto": "opcion.contabilidad.boleta.negarse",
        "tendencia": "jugador.responsabilidad / 2",
        "efectos": [
          "jugador.felicidad -= 2",
          "jugador.marcar('se_nego_gasto_falso')"
        ]
      },
      {
        "texto": "opcion.contabilidad.boleta.preguntar",
        "tendencia": "30",
        "efectos": [
          "jugador.inteligencia += 1"
        ]
      }
    ]
  },
  {
    "id": "evento.contabilidad.titulacion",
    "condiciones": "jugador.estudia == 'carrera.contabilidad' && jugador.tiene('hizo_practica') && jugador.semestres_aprobados >= jugador.semestres_carrera",
    "peso": 100,
    "dia_clave": true,
    "unico": true,
    "efectos": [
      "jugador.titularse()",
