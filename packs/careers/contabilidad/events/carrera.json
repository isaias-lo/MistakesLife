        "efectos": [
          "jugador.desmarcar('buscando_trabajo')",
          "jugador.marcar('trabajando')",
          "jugador.marcar('trabaja_contabilidad')",
          "jugador.marcar('trabaja_auditoria')",
          "jugador.trabajar(sueldo_titulo() * 1.1)",
          "jugador.felicidad += 4",
          "jugador.salud -= 2"
        ]
      },
      {
        "texto": "opcion.contabilidad.trabajo.asistente",
        "efectos": [
          "jugador.desmarcar('buscando_trabajo')",
          "jugador.marcar('trabajando')",
          "jugador.marcar('trabaja_contabilidad')",
          "jugador.trabajar(sueldo_titulo() * 0.9)",
          "jugador.felicidad += 4"
        ]
      },
      {
        "texto": "opcion.contabilidad.trabajo.esperar",
        "tendencia": "15"
      }
    ]
  },
  {
    "id": "evento.contabilidad.cierre_anual",
    "condiciones": "jugador.tiene('trabaja_contabilidad') && jugador.tiene('trabajando')",
    "peso": 8,
    "enfriamiento_semanas": 52,
    "opciones": [
      {
        "texto": "opcion.contabilidad.cierre.quedarse",
        "tendencia": "jugador.responsabilidad",
        "efectos": [
          "jugador.salud -= 3",
          "jugador.inteligencia += 1"
