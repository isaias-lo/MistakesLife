[
  {
    "id": "evento.contabilidad.tarea.cierre_mes",
    "con": "jefe",
    "condiciones": "jugador.tarea_pendiente == 'tarea.contabilidad.cierre_mes'",
    "probabilidad_anual": 1,
    "opciones": [
      {
        "texto": "opcion.contabilidad.tarea.cierre_mes.calma",
        "tendencia": "jugador.responsabilidad / 2 + 10",
        "efectos": [
          "jugador.hacer_tarea('calma')",
          "jugador.energia -= 8"
        ]
      },
      {
        "texto": "opcion.contabilidad.tarea.cierre_mes.rapido",
        "tendencia": "(100 - jugador.responsabilidad) / 3 + jugador.inteligencia / 4",
        "efectos": [
          "jugador.hacer_tarea('rapido')",
          "jugador.energia -= 2"
        ]
      },
      {
        "texto": "opcion.contabilidad.tarea.cierre_mes.ayuda",
        "condiciones": "jugador.colega != nada",
        "tendencia": "jugador.amabilidad / 3 + jugador.extraversion / 4",
        "efectos": [
          "jugador.hacer_tarea('ayuda')",
          "jugador.energia -= 4",
          "jugador.colega.carino += 2"
        ]
      },
      {
        "texto": "opcion.contabilidad.tarea.cierre_mes.dejar",
        "condiciones": "!jugador.tarea_postergada",
        "tendencia": "(100 - jugador.responsabilidad) / 4 + jugador.neuroticismo / 5",
        "efectos": [
          "jugador.hacer_tarea('dejar')",
          "jugador.energia += 3",
          "jugador.felicidad += 1"
        ]
      },
      {
        "texto": "opcion.tarea.no_entregar",
        "condiciones": "jugador.tarea_postergada",
        "tendencia": "(100 - jugador.responsabilidad) / 4",
        "efectos": [
          "jugador.hacer_tarea('dejar')",
          "jugador.felicidad -= 1"
        ]
      }
    ]
  },
