  "pregunta.contabilidad.legislacion_laboral.3.contrato.2.b": "15 días",
  "pregunta.contabilidad.legislacion_laboral.3.contrato.2.c": "1 año",
  "pregunta.contabilidad.legislacion_laboral.3.contrato.2.por_que": "Código del Trabajo.",
  "pregunta.contabilidad.legislacion_laboral.3.contrato.3": "¿Cuánto puede durar como máximo un plazo fijo de un no profesional?",
  "pregunta.contabilidad.legislacion_laboral.3.contrato.3.a": "3 meses",
  "pregunta.contabilidad.legislacion_laboral.3.contrato.3.b": "5 años",
  "pregunta.contabilidad.legislacion_laboral.3.contrato.3.c": "1 año",
  "pregunta.contabilidad.legislacion_laboral.3.contrato.3.por_que": "2 años si tiene título.",
  "pregunta.contabilidad.legislacion_laboral.3.contrato.4": "¿Qué pasa si un contrato a plazo fijo se renueva por segunda vez?",
  "pregunta.contabilidad.legislacion_laboral.3.contrato.4.a": "Pasa a ser indefinido",
