  "pregunta.contabilidad.legislacion_laboral.3.contrato.4.por_que": "Protege al trabajador.",
  "pregunta.contabilidad.legislacion_laboral.3.contrato.5": "¿Qué ley rige las relaciones laborales en Chile?",
  "pregunta.contabilidad.legislacion_laboral.3.contrato.5.a": "El Código Civil",
  "pregunta.contabilidad.legislacion_laboral.3.contrato.5.b": "El Código del Trabajo",
  "pregunta.contabilidad.legislacion_laboral.3.contrato.5.c": "El Código Tributario",
  "pregunta.contabilidad.legislacion_laboral.3.contrato.5.por_que": "Con sus leyes complementarias.",
  "tema.contabilidad.legislacion_laboral.3.jornada": "Jornada y descansos",
  "tema.contabilidad.legislacion_laboral.3.jornada.texto": "La ley de 40 horas (2023) baja la jornada ordinaria de 45 a 40 horas semanales de a poco, hasta 2028. Las horas extra se pagan con un recargo de 50 % y no pueden pasar de 2 por día.\n\nQuien tiene más de un año trabajando tiene 15 días hábiles de feriado legal pagado.",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.1": "¿Hasta cuántas horas semanales baja la jornada la ley de 2023?",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.1.a": "40 horas",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.1.b": "35 horas",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.1.c": "48 horas",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.1.por_que": "Gradual hasta 2028.",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.2": "¿Con qué recargo se pagan las horas extra?",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.2.a": "10 %",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.2.b": "50 %",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.2.c": "100 %",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.2.por_que": "Sobre el sueldo convenido.",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.3": "¿Cuántas horas extra se pueden hacer como máximo por día?",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.3.a": "4",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.3.b": "Las que quiera el jefe",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.3.c": "2",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.3.por_que": "Y deben pactarse por escrito.",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.4": "¿Cuántos días de feriado legal tiene quien lleva más de un año?",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.4.a": "15 días hábiles",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.4.b": "30 días corridos",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.4.c": "7 días",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.4.por_que": "Vacaciones pagadas.",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.5": "¿Qué es el feriado progresivo?",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.5.a": "Un feriado religioso",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.5.b": "Un día más por cada 3 años nuevos trabajados, después de 10 años de trabajo",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.5.c": "Vacaciones sin goce de sueldo",
  "pregunta.contabilidad.legislacion_laboral.3.jornada.5.por_que": "Premia la antigüedad.",
  "tema.contabilidad.legislacion_laboral.3.termino": "Término del contrato",
  "tema.contabilidad.legislacion_laboral.3.termino.texto": "El contrato termina por causales de la ley: mutuo acuerdo, renuncia o vencimiento del plazo (art. 159); conductas graves del trabajador, sin indemnización (art. 160); o necesidades de la empresa (art. 161), con aviso de 30 días o pago de ese mes.\n\nPor necesidades de la empresa se paga un mes por año de servicio, con tope de 11 años. El finiquito se firma ante un ministro de fe.",
  "pregunta.contabilidad.legislacion_laboral.3.termino.1": "¿Qué causal permite despedir sin indemnización?",
  "pregunta.contabilidad.legislacion_laboral.3.termino.1.a": "Conductas graves del trabajador (art. 160)",
  "pregunta.contabilidad.legislacion_laboral.3.termino.1.b": "Necesidades de la empresa",
  "pregunta.contabilidad.legislacion_laboral.3.termino.1.c": "Mutuo acuerdo",
  "pregunta.contabilidad.legislacion_laboral.3.termino.1.por_que": "Por ejemplo, faltas graves de probidad.",
  "pregunta.contabilidad.legislacion_laboral.3.termino.2": "¿Cuánto es la indemnización por años de servicio?",
  "pregunta.contabilidad.legislacion_laboral.3.termino.2.a": "Una semana por año",
  "pregunta.contabilidad.legislacion_laboral.3.termino.2.b": "Un mes por año, con tope de 11 años",
  "pregunta.contabilidad.legislacion_laboral.3.termino.2.c": "Siempre 6 meses",
  "pregunta.contabilidad.legislacion_laboral.3.termino.2.por_que": "Art. 163.",
  "pregunta.contabilidad.legislacion_laboral.3.termino.3": "Si despiden por necesidades de la empresa sin aviso, ¿qué se paga?",
  "pregunta.contabilidad.legislacion_laboral.3.termino.3.a": "Nada",
  "pregunta.contabilidad.legislacion_laboral.3.termino.3.b": "Medio sueldo",
  "pregunta.contabilidad.legislacion_laboral.3.termino.3.c": "Un mes de sueldo en vez del aviso",
  "pregunta.contabilidad.legislacion_laboral.3.termino.3.por_que": "Indemnización sustitutiva del aviso previo.",
  "pregunta.contabilidad.legislacion_laboral.3.termino.4": "¿Ante quién se firma el finiquito?",
  "pregunta.contabilidad.legislacion_laboral.3.termino.4.a": "Ante un ministro de fe, como un notario o la Inspección del Trabajo",
  "pregunta.contabilidad.legislacion_laboral.3.termino.4.b": "Solo ante el jefe",
  "pregunta.contabilidad.legislacion_laboral.3.termino.4.c": "Ante el SII",
  "pregunta.contabilidad.legislacion_laboral.3.termino.4.por_que": "Para que valga.",
  "pregunta.contabilidad.legislacion_laboral.3.termino.5": "¿Qué causal es la renuncia?",
  "pregunta.contabilidad.legislacion_laboral.3.termino.5.a": "Una del art. 160",
  "pregunta.contabilidad.legislacion_laboral.3.termino.5.b": "Una del art. 159",
  "pregunta.contabilidad.legislacion_laboral.3.termino.5.c": "Una del art. 161",
  "pregunta.contabilidad.legislacion_laboral.3.termino.5.por_que": "Con aviso de 30 días.",
  "tema.contabilidad.legislacion_laboral.3.proteccion": "Protección y fiscalización",
  "tema.contabilidad.legislacion_laboral.3.proteccion.texto": "La Dirección del Trabajo fiscaliza que se cumpla la ley: las inspecciones reciben denuncias y multan. La maternidad tiene fuero: no se puede despedir desde el embarazo hasta un año después del postnatal sin permiso de un juez.\n\nLos trabajadores pueden formar sindicatos y negociar colectivamente.",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.1": "¿Quién fiscaliza el cumplimiento de la ley laboral?",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.1.a": "La Dirección del Trabajo",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.1.b": "El SII",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.1.c": "Carabineros",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.1.por_que": "A través de las inspecciones.",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.2": "¿Hasta cuándo dura el fuero maternal?",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.2.a": "Solo durante el embarazo",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.2.b": "Hasta un año después del postnatal",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.2.c": "Hasta que el hijo cumpla 18",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.2.por_que": "Protege a la madre.",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.3": "¿Cuánto dura el postnatal en Chile?",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.3.a": "1 semana",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.3.b": "1 año completo pagado",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.3.c": "12 semanas, más 12 de postnatal parental",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.3.por_que": "El parental se puede compartir con el padre.",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.4": "¿Qué es la negociación colectiva?",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.4.a": "Cuando un grupo o sindicato negocia condiciones con la empresa",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.4.b": "Una venta de la empresa",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.4.c": "Un juicio penal",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.4.por_que": "Se firma un contrato colectivo.",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.5": "¿Qué puede hacer un trabajador si no le pagan las cotizaciones?",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.5.a": "Nada",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.5.b": "Denunciar en la Inspección del Trabajo",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.5.c": "Dejar de pagar impuestos",
  "pregunta.contabilidad.legislacion_laboral.3.proteccion.5.por_que": "Además el despido no vale (ley Bustos)."
