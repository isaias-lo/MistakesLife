{
  "tema.contabilidad.auditoria_tributaria.9.revision": "Revisión tributaria",
  "tema.contabilidad.auditoria_tributaria.9.revision.texto": "La auditoría tributaria revisa que la empresa haya cumplido con sus impuestos: IVA mensual, PPM, retenciones y renta anual. Cuadra el F29 con el Registro de Compras y Ventas y el F22 con la contabilidad.",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.1": "¿Qué revisa una auditoría tributaria?",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.1.a": "Que se hayan declarado y pagado bien los impuestos",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.1.b": "Que los empleados lleguen a la hora",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.1.c": "Solo la caja",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.1.por_que": "Cumplimiento.",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.2": "¿Con qué se cuadra el IVA del F29?",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.2.a": "Con la planilla de sueldos",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.2.b": "Con el Registro de Compras y Ventas",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.2.c": "Con el inventario",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.2.por_que": "Débitos y créditos.",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.3": "¿Con qué se cuadra el F22?",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.3.a": "Con el F29 de un mes",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.3.b": "Con el horario",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.3.c": "Con la contabilidad y la renta líquida",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.3.por_que": "Renta anual.",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.4": "¿Qué se revisa en las facturas de compra?",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.4.a": "Que sean del giro y estén respaldadas",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.4.b": "Su color",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.4.c": "Que sean de papel",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.4.por_que": "Crédito fiscal válido.",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.5": "¿Qué riesgo tiene una diferencia entre el RCV y el F29?",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.5.a": "Ninguno",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.5.b": "Que el SII la detecte y cobre con multas",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.5.c": "Una devolución",
  "pregunta.contabilidad.auditoria_tributaria.9.revision.5.por_que": "Inconsistencia.",
  "tema.contabilidad.auditoria_tributaria.9.procedimientos": "Procedimientos del SII",
  "tema.contabilidad.auditoria_tributaria.9.procedimientos.texto": "El SII puede citar al contribuyente (art. 63 del Código Tributario) para que explique o corrija. Si no queda conforme, liquida el impuesto adeudado y luego gira la orden de pago. El contribuyente puede pedir revisión o reclamar ante el Tribunal Tributario y Aduanero.",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.1": "¿Qué es la citación del art. 63?",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.1.a": "Un llamado del SII para explicar o corregir una declaración",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.1.b": "Una invitación a una fiesta",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.1.c": "Una devolución",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.1.por_que": "Primer paso.",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.2": "¿Qué hace el SII si no queda conforme?",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.2.a": "Cierra el caso",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.2.b": "Liquida el impuesto adeudado",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.2.c": "Devuelve el IVA",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.2.por_que": "Liquidación.",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.3": "¿Dónde se puede reclamar contra una liquidación?",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.3.a": "En el Registro Civil",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.3.b": "En un juzgado de familia",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.3.c": "Ante el Tribunal Tributario y Aduanero",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.3.por_que": "TTA.",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.4": "¿Qué es el giro?",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.4.a": "La orden de pago del impuesto",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.4.b": "Un tipo de banco",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.4.c": "Una vuelta",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.4.por_que": "Después de la liquidación.",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.5": "¿Puede pedirse una revisión administrativa antes de reclamar?",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.5.a": "No",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.5.b": "Sí, la RAV",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.5.c": "Solo en el extranjero",
  "pregunta.contabilidad.auditoria_tributaria.9.procedimientos.5.por_que": "Revisión de la actuación fiscalizadora.",
  "tema.contabilidad.auditoria_tributaria.9.prescripcion": "Plazos de prescripción",
  "tema.contabilidad.auditoria_tributaria.9.prescripcion.texto": "El SII tiene en general 3 años para revisar y cobrar impuestos. El plazo sube a 6 años si no se declaró o la declaración fue maliciosamente falsa.\n\nLos documentos se deben guardar mientras pueda revisarlos.",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.1": "¿Cuál es el plazo general de prescripción tributaria?",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.1.a": "3 años",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.1.b": "1 año",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.1.c": "20 años",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.1.por_que": "Art. 200.",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.2": "¿Cuándo se extiende a 6 años?",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.2.a": "Siempre",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.2.b": "Si no se declaró o la declaración fue maliciosamente falsa",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.2.c": "Si la empresa es grande",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.2.por_que": "Art. 200.",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.3": "¿Cuánto tiempo hay que guardar los respaldos?",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.3.a": "Una semana",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.3.b": "No hay que guardarlos",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.3.c": "Mientras el SII pueda revisar",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.3.por_que": "Prescripción.",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.4": "¿Qué pasa si una deuda tributaria prescribe?",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.4.a": "El SII ya no puede cobrarla",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.4.b": "Se duplica",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.4.c": "Pasa a los hijos",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.4.por_que": "Extinción.",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.5": "¿Por qué importa conocer la prescripción?",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.5.a": "No importa",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.5.b": "Para saber qué años puede revisar el SII",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.5.c": "Para pagar dos veces",
  "pregunta.contabilidad.auditoria_tributaria.9.prescripcion.5.por_que": "Riesgo.",
  "tema.contabilidad.auditoria_tributaria.9.contingencias": "Contingencias tributarias",
  "tema.contabilidad.auditoria_tributaria.9.contingencias.texto": "Al comprar una empresa o al auditarla, se buscan contingencias tributarias: impuestos que podrían cobrarse por errores pasados. Se estima su monto, la probabilidad y se informa al cliente.\n\nLas multas e intereses se suman al impuesto que no se pagó a tiempo.",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.1": "¿Qué es una contingencia tributaria?",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.1.a": "Un impuesto que podrían cobrar por errores pasados",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.1.b": "Un ahorro",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.1.c": "Un subsidio",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.1.por_que": "Riesgo.",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.2": "¿Por qué se revisan al comprar una empresa?",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.2.a": "Por costumbre",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.2.b": "Porque el comprador hereda esas deudas",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.2.c": "Para pagar menos sueldo",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.2.por_que": "Due diligence.",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.3": "¿Qué se suma al impuesto atrasado?",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.3.a": "Nada",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.3.b": "Un regalo",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.3.c": "Reajuste, intereses y multas",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.3.por_que": "Costo del atraso.",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.4": "¿Qué hace el auditor con una contingencia probable?",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.4.a": "Estima su monto e informa",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.4.b": "La esconde",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.4.c": "La paga él",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.4.por_que": "Provisión o revelación.",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.5": "¿Puede la empresa corregir antes de que el SII la cite?",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.5.a": "No",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.5.b": "Sí, rectificando y pagando",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.5.c": "Solo con abogado extranjero",
  "pregunta.contabilidad.auditoria_tributaria.9.contingencias.5.por_que": "Rebaja de multas."
}
