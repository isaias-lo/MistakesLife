  "pregunta.contabilidad.matematica.1.funciones.1.por_que": "200.000 + 30.000.",
  "pregunta.contabilidad.matematica.1.funciones.2": "¿Cuál es la utilidad?",
  "pregunta.contabilidad.matematica.1.funciones.2.a": "Ingresos más costos",
  "pregunta.contabilidad.matematica.1.funciones.2.b": "Ingresos menos costos",
  "pregunta.contabilidad.matematica.1.funciones.2.c": "Solo los ingresos",
  "pregunta.contabilidad.matematica.1.funciones.2.por_que": "U = I − C.",
