  "pregunta.contabilidad.evaluacion_proyectos.10.van.2.por_que": "121 / 1,21 − 100.",
  "pregunta.contabilidad.evaluacion_proyectos.10.van.3": "¿Qué tasa se usa para descontar?",
  "pregunta.contabilidad.evaluacion_proyectos.10.van.3.a": "La tasa del IVA",
  "pregunta.contabilidad.evaluacion_proyectos.10.van.3.b": "Cero",
  "pregunta.contabilidad.evaluacion_proyectos.10.van.3.c": "La tasa exigida o costo de capital",
  "pregunta.contabilidad.evaluacion_proyectos.10.van.3.por_que": "Tasa de descuento.",
  "pregunta.contabilidad.evaluacion_proyectos.10.van.4": "Si la tasa de descuento sube, ¿qué pasa con el VAN?",
  "pregunta.contabilidad.evaluacion_proyectos.10.van.4.a": "Baja",
  "pregunta.contabilidad.evaluacion_proyectos.10.van.4.b": "Sube",
  "pregunta.contabilidad.evaluacion_proyectos.10.van.4.c": "No cambia",
  "pregunta.contabilidad.evaluacion_proyectos.10.van.4.por_que": "Se descuenta más.",
  "pregunta.contabilidad.evaluacion_proyectos.10.van.5": "Entre dos proyectos excluyentes, ¿cuál se elige con el VAN?",
  "pregunta.contabilidad.evaluacion_proyectos.10.van.5.a": "El de menor inversión",
  "pregunta.contabilidad.evaluacion_proyectos.10.van.5.b": "El de mayor VAN",
  "pregunta.contabilidad.evaluacion_proyectos.10.van.5.c": "El más antiguo",
  "pregunta.contabilidad.evaluacion_proyectos.10.van.5.por_que": "Más riqueza.",
  "tema.contabilidad.evaluacion_proyectos.10.tir": "TIR y recuperación",
  "tema.contabilidad.evaluacion_proyectos.10.tir.texto": "La tasa interna de retorno (TIR) es la tasa que hace el VAN igual a cero. Si la TIR es mayor que la tasa exigida, el proyecto conviene.\n\nEl período de recuperación dice en cuántos años se recupera la inversión, sin mirar el valor del dinero en el tiempo.",
  "pregunta.contabilidad.evaluacion_proyectos.10.tir.1": "¿Qué es la TIR?",
  "pregunta.contabilidad.evaluacion_proyectos.10.tir.1.a": "La tasa que hace el VAN igual a cero",
  "pregunta.contabilidad.evaluacion_proyectos.10.tir.1.b": "La tasa del banco",
  "pregunta.contabilidad.evaluacion_proyectos.10.tir.1.c": "El impuesto a la renta",
  "pregunta.contabilidad.evaluacion_proyectos.10.tir.1.por_que": "Rentabilidad del proyecto.",
  "pregunta.contabilidad.evaluacion_proyectos.10.tir.2": "TIR 15 % y tasa exigida 10 %. ¿Conviene?",
  "pregunta.contabilidad.evaluacion_proyectos.10.tir.2.a": "No",
  "pregunta.contabilidad.evaluacion_proyectos.10.tir.2.b": "Sí",
  "pregunta.contabilidad.evaluacion_proyectos.10.tir.2.c": "No se sabe nunca",
  "pregunta.contabilidad.evaluacion_proyectos.10.tir.2.por_que": "TIR > tasa.",
  "pregunta.contabilidad.evaluacion_proyectos.10.tir.3": "Inversión $300 y flujos de $100 al año. ¿Período de recuperación?",
  "pregunta.contabilidad.evaluacion_proyectos.10.tir.3.a": "1 año",
  "pregunta.contabilidad.evaluacion_proyectos.10.tir.3.b": "30 años",
  "pregunta.contabilidad.evaluacion_proyectos.10.tir.3.c": "3 años",
  "pregunta.contabilidad.evaluacion_proyectos.10.tir.3.por_que": "300 / 100.",
  "pregunta.contabilidad.evaluacion_proyectos.10.tir.4": "¿Qué defecto tiene el período de recuperación simple?",
  "pregunta.contabilidad.evaluacion_proyectos.10.tir.4.a": "No considera el valor del dinero en el tiempo ni los flujos posteriores",
