  "pregunta.contabilidad.auditoria.7.opinion.2.b": "Cuando los estados no son razonables en general",
  "pregunta.contabilidad.auditoria.7.opinion.2.c": "Siempre el primer año",
  "pregunta.contabilidad.auditoria.7.opinion.2.por_que": "Errores generalizados.",
  "pregunta.contabilidad.auditoria.7.opinion.3": "¿Qué es la abstención de opinión?",
  "pregunta.contabilidad.auditoria.7.opinion.3.a": "Una opinión limpia",
  "pregunta.contabilidad.auditoria.7.opinion.3.b": "Una multa",
