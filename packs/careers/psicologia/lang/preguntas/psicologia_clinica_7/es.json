  "pregunta.psicologia.psicologia_clinica.7.crisis.3.por_que": "Mito.",
  "pregunta.psicologia.psicologia_clinica.7.crisis.4": "¿Qué es un plan de seguridad?",
  "pregunta.psicologia.psicologia_clinica.7.crisis.4.a": "Pasos y contactos que la persona usa en una crisis",
