  "pregunta.psicologia.psicologia_clinica.7.infantojuvenil.1.a": "Porque el niño depende de su entorno familiar",
  "pregunta.psicologia.psicologia_clinica.7.infantojuvenil.1.b": "Para cobrarles",
  "pregunta.psicologia.psicologia_clinica.7.infantojuvenil.1.c": "No se trabaja",
  "pregunta.psicologia.psicologia_clinica.7.infantojuvenil.1.por_que": "Sistema.",
  "pregunta.psicologia.psicologia_clinica.7.infantojuvenil.2": "¿Qué es la terapia de juego?",
