  "pregunta.psicologia.psicologia_clinica.7.infantojuvenil.3.b": "Hablar solo con el niño",
  "pregunta.psicologia.psicologia_clinica.7.infantojuvenil.3.c": "Informar a las instituciones que corresponden",
  "pregunta.psicologia.psicologia_clinica.7.infantojuvenil.3.por_que": "Protección.",
