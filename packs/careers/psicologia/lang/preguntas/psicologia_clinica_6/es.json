  "pregunta.psicologia.psicologia_clinica.6.salud_mental_chile.2.a": "El sueldo de los psicólogos",
  "pregunta.psicologia.psicologia_clinica.6.salud_mental_chile.2.b": "Los derechos de las personas en la atención de salud mental",
  "pregunta.psicologia.psicologia_clinica.6.salud_mental_chile.2.c": "Las licencias de conducir",
  "pregunta.psicologia.psicologia_clinica.6.salud_mental_chile.2.por_que": "2021.",
