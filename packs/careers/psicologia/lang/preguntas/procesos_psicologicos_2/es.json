{
  "tema.psicologia.procesos_psicologicos.2.pensamiento": "Pensamiento y decisiones",
  "tema.psicologia.procesos_psicologicos.2.pensamiento.texto": "Para decidir rápido usamos atajos mentales (heurísticos), que a veces llevan a sesgos. El sesgo de confirmación es buscar solo lo que confirma lo que ya creemos.\n\nDaniel Kahneman distinguió un pensamiento rápido e intuitivo y otro lento y deliberado.",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.1": "¿Qué es el sesgo de confirmación?",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.1.a": "Buscar solo lo que confirma lo que ya creemos",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.1.b": "Dudar de todo",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.1.c": "Confirmar una cita",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.1.por_que": "Muy común en redes.",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.2": "¿Qué es un heurístico?",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.2.a": "Un error de cálculo",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.2.b": "Un atajo mental para decidir rápido",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.2.c": "Una enfermedad",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.2.por_que": "Útil pero falible.",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.3": "¿Quién distinguió el pensamiento rápido y el lento?",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.3.a": "Sigmund Freud",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.3.b": "Iván Pávlov",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.3.c": "Daniel Kahneman",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.3.por_que": "Premio Nobel de Economía 2002.",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.4": "¿Qué es el razonamiento deductivo?",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.4.a": "Sacar conclusiones particulares de reglas generales",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.4.b": "Adivinar",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.4.c": "Generalizar de pocos casos",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.4.por_que": "Si todos... entonces este.",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.5": "¿Qué es el efecto de anclaje?",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.5.a": "Quedarse en un lugar",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.5.b": "Dejarse llevar por el primer número que se escucha",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.5.c": "Recordar mejor",
  "pregunta.psicologia.procesos_psicologicos.2.pensamiento.5.por_que": "Influye en precios.",
  "tema.psicologia.procesos_psicologicos.2.lenguaje": "Lenguaje",
  "tema.psicologia.procesos_psicologicos.2.lenguaje.texto": "El lenguaje permite comunicar ideas con símbolos y reglas. Los niños aprenden a hablar sin que se les enseñe gramática explícita, lo que llevó a Chomsky a proponer una capacidad innata.\n\nEl área de Broca participa en producir el habla y la de Wernicke en comprenderla.",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.1": "¿Qué área cerebral participa en producir el habla?",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.1.a": "El área de Broca",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.1.b": "El área de Wernicke",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.1.c": "El cerebelo",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.1.por_que": "Lóbulo frontal.",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.2": "¿Qué área participa en comprender el lenguaje?",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.2.a": "El área de Broca",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.2.b": "El área de Wernicke",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.2.c": "La amígdala",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.2.por_que": "Lóbulo temporal.",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.3": "¿Quién propuso una capacidad innata para el lenguaje?",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.3.a": "B. F. Skinner",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.3.b": "Freud",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.3.c": "Noam Chomsky",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.3.por_que": "Gramática universal.",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.4": "¿Qué es la afasia?",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.4.a": "Una alteración del lenguaje por daño cerebral",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.4.b": "Un acento",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.4.c": "Un idioma",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.4.por_que": "Puede ser de Broca o Wernicke.",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.5": "¿A qué edad suelen decir sus primeras palabras los niños?",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.5.a": "A los 5 años",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.5.b": "Cerca del año",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.5.c": "Al nacer",
  "pregunta.psicologia.procesos_psicologicos.2.lenguaje.5.por_que": "Primeras palabras.",
  "tema.psicologia.procesos_psicologicos.2.motivacion": "Motivación",
  "tema.psicologia.procesos_psicologicos.2.motivacion.texto": "La motivación es lo que inicia y sostiene una conducta. Puede ser intrínseca (hacer algo porque te gusta) o extrínseca (por un premio o para evitar un castigo).\n\nSegún Maslow, primero se cubren necesidades básicas y luego las de pertenencia, estima y autorrealización.",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.1": "¿Qué es la motivación intrínseca?",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.1.a": "Hacer algo porque te gusta o te interesa",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.1.b": "Hacer algo por un premio",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.1.c": "Hacer algo obligado",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.1.por_que": "Viene de adentro.",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.2": "¿Qué es la motivación extrínseca?",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.2.a": "Hacer algo por gusto",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.2.b": "Hacer algo por un premio o para evitar un castigo",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.2.c": "No hacer nada",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.2.por_que": "Viene de afuera.",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.3": "¿Qué está en la cima de la pirámide de Maslow?",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.3.a": "La comida",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.3.b": "La seguridad",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.3.c": "La autorrealización",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.3.por_que": "Desarrollar tu potencial.",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.4": "¿Qué está en la base de la pirámide de Maslow?",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.4.a": "Las necesidades fisiológicas",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.4.b": "La estima",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.4.c": "La autorrealización",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.4.por_que": "Comer, dormir.",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.5": "¿Qué puede pasar si se premia algo que ya se hacía por gusto?",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.5.a": "Siempre sube",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.5.b": "Puede bajar la motivación intrínseca",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.5.c": "No pasa nada nunca",
  "pregunta.psicologia.procesos_psicologicos.2.motivacion.5.por_que": "Efecto de sobrejustificación.",
  "tema.psicologia.procesos_psicologicos.2.emocion": "Emoción",
  "tema.psicologia.procesos_psicologicos.2.emocion.texto": "Las teorías de la emoción discuten qué va primero. Para James-Lange, sentimos miedo porque temblamos; para Cannon-Bard, cuerpo y emoción ocurren a la vez; para Schachter-Singer, interpretamos la activación según la situación.\n\nLa inteligencia emocional es reconocer y manejar las propias emociones y las de otros.",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.1": "Según James-Lange, ¿qué va primero?",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.1.a": "La reacción corporal y luego la emoción",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.1.b": "La emoción y luego el cuerpo",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.1.c": "Nada",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.1.por_que": "\"Tenemos miedo porque temblamos\".",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.2": "¿Qué propone Cannon-Bard?",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.2.a": "Que el cuerpo va primero",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.2.b": "Que cuerpo y emoción ocurren a la vez",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.2.c": "Que no hay emociones",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.2.por_que": "Simultáneas.",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.3": "¿Qué agrega Schachter-Singer?",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.3.a": "Que solo hay seis emociones",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.3.b": "Que todo es genético",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.3.c": "Que interpretamos la activación según la situación",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.3.por_que": "Teoría de los dos factores.",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.4": "¿Qué es la inteligencia emocional?",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.4.a": "Reconocer y manejar las emociones propias y ajenas",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.4.b": "Tener un CI alto",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.4.c": "No sentir nada",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.4.por_que": "Popularizada por Goleman.",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.5": "¿Qué es la regulación emocional?",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.5.a": "Eliminar las emociones",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.5.b": "Manejar la intensidad y expresión de las emociones",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.5.c": "Un medicamento",
  "pregunta.psicologia.procesos_psicologicos.2.emocion.5.por_que": "Ej.: respirar antes de responder."
}
