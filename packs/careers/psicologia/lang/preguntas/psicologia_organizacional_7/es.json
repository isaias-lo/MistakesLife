  "pregunta.psicologia.psicologia_organizacional.7.motivacion.2.c": "Comida, techo y abrigo",
  "pregunta.psicologia.psicologia_organizacional.7.motivacion.2.por_que": "Deci y Ryan.",
  "pregunta.psicologia.psicologia_organizacional.7.motivacion.3": "¿Qué metas mejoran más el desempeño?",
  "pregunta.psicologia.psicologia_organizacional.7.motivacion.3.a": "Vagas",
  "pregunta.psicologia.psicologia_organizacional.7.motivacion.3.b": "Imposibles",
  "pregunta.psicologia.psicologia_organizacional.7.motivacion.3.c": "Claras y desafiantes",
  "pregunta.psicologia.psicologia_organizacional.7.motivacion.3.por_que": "Locke.",
