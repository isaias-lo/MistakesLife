{
  "tema.psicologia.psicopatologia.6.psicosis": "Esquizofrenia y psicosis",
  "tema.psicologia.psicopatologia.6.psicosis.texto": "La esquizofrenia tiene síntomas positivos (delirios, alucinaciones, pensamiento desorganizado) y negativos (aplanamiento afectivo, falta de motivación). Suele empezar al final de la adolescencia o en la adultez temprana. Con tratamiento temprano el pronóstico mejora.",
  "pregunta.psicologia.psicopatologia.6.psicosis.1": "¿Qué es un delirio?",
  "pregunta.psicologia.psicopatologia.6.psicosis.1.a": "Una creencia falsa firme que no cambia con la evidencia",
  "pregunta.psicologia.psicopatologia.6.psicosis.1.b": "Un sueño",
  "pregunta.psicologia.psicopatologia.6.psicosis.1.c": "Un olvido",
  "pregunta.psicologia.psicopatologia.6.psicosis.1.por_que": "Síntoma positivo.",
  "pregunta.psicologia.psicopatologia.6.psicosis.2": "¿Qué es una alucinación?",
  "pregunta.psicologia.psicopatologia.6.psicosis.2.a": "Imaginar a propósito",
  "pregunta.psicologia.psicopatologia.6.psicosis.2.b": "Percibir algo que no está, como oír voces",
  "pregunta.psicologia.psicopatologia.6.psicosis.2.c": "Ver mal de lejos",
  "pregunta.psicologia.psicopatologia.6.psicosis.2.por_que": "Percepción sin estímulo.",
  "pregunta.psicologia.psicopatologia.6.psicosis.3": "¿Cuál es un síntoma negativo?",
  "pregunta.psicologia.psicopatologia.6.psicosis.3.a": "Una alucinación",
  "pregunta.psicologia.psicopatologia.6.psicosis.3.b": "Un delirio",
  "pregunta.psicologia.psicopatologia.6.psicosis.3.c": "El aplanamiento afectivo",
  "pregunta.psicologia.psicopatologia.6.psicosis.3.por_que": "Algo que falta.",
  "pregunta.psicologia.psicopatologia.6.psicosis.4": "¿Cuándo suele comenzar la esquizofrenia?",
  "pregunta.psicologia.psicopatologia.6.psicosis.4.a": "Al final de la adolescencia o en la adultez temprana",
  "pregunta.psicologia.psicopatologia.6.psicosis.4.b": "En la vejez",
  "pregunta.psicologia.psicopatologia.6.psicosis.4.c": "Al nacer",
  "pregunta.psicologia.psicopatologia.6.psicosis.4.por_que": "Primer episodio.",
  "pregunta.psicologia.psicopatologia.6.psicosis.5": "¿Es lo mismo esquizofrenia que 'doble personalidad'?",
  "pregunta.psicologia.psicopatologia.6.psicosis.5.a": "Sí",
  "pregunta.psicologia.psicopatologia.6.psicosis.5.b": "No",
  "pregunta.psicologia.psicopatologia.6.psicosis.5.c": "Solo en Chile",
  "pregunta.psicologia.psicopatologia.6.psicosis.5.por_que": "Mito común.",
  "tema.psicologia.psicopatologia.6.personalidad": "Trastornos de personalidad",
  "tema.psicologia.psicopatologia.6.personalidad.texto": "Un trastorno de personalidad es un patrón rígido y duradero de pensar, sentir y relacionarse que causa malestar o problemas. El trastorno límite tiene inestabilidad emocional, impulsividad, miedo al abandono y relaciones intensas. La terapia dialéctico conductual tiene buena evidencia para él.",
  "pregunta.psicologia.psicopatologia.6.personalidad.1": "¿Qué es un trastorno de personalidad?",
  "pregunta.psicologia.psicopatologia.6.personalidad.1.a": "Un patrón rígido y duradero que causa problemas",
  "pregunta.psicologia.psicopatologia.6.personalidad.1.b": "Un mal día",
  "pregunta.psicologia.psicopatologia.6.personalidad.1.c": "Tener carácter fuerte",
  "pregunta.psicologia.psicopatologia.6.personalidad.1.por_que": "Desde la adolescencia.",
  "pregunta.psicologia.psicopatologia.6.personalidad.2": "¿Qué caracteriza al trastorno límite?",
  "pregunta.psicologia.psicopatologia.6.personalidad.2.a": "Mucha calma",
  "pregunta.psicologia.psicopatologia.6.personalidad.2.b": "Inestabilidad emocional, impulsividad y miedo al abandono",
  "pregunta.psicologia.psicopatologia.6.personalidad.2.c": "Falta de emociones",
  "pregunta.psicologia.psicopatologia.6.personalidad.2.por_que": "Borderline.",
  "pregunta.psicologia.psicopatologia.6.personalidad.3": "¿Qué terapia tiene buena evidencia para el trastorno límite?",
  "pregunta.psicologia.psicopatologia.6.personalidad.3.a": "No hay tratamiento",
  "pregunta.psicologia.psicopatologia.6.personalidad.3.b": "Solo descanso",
  "pregunta.psicologia.psicopatologia.6.personalidad.3.c": "La terapia dialéctico conductual",
  "pregunta.psicologia.psicopatologia.6.personalidad.3.por_que": "Linehan.",
  "pregunta.psicologia.psicopatologia.6.personalidad.4": "¿Qué caracteriza al trastorno antisocial?",
  "pregunta.psicologia.psicopatologia.6.personalidad.4.a": "Desprecio y violación de los derechos de otros",
  "pregunta.psicologia.psicopatologia.6.personalidad.4.b": "Timidez",
  "pregunta.psicologia.psicopatologia.6.personalidad.4.c": "No querer salir",
  "pregunta.psicologia.psicopatologia.6.personalidad.4.por_que": "Desde los 15.",
  "pregunta.psicologia.psicopatologia.6.personalidad.5": "¿Qué caracteriza al trastorno obsesivo compulsivo de la personalidad?",
  "pregunta.psicologia.psicopatologia.6.personalidad.5.a": "Lavarse las manos por pensamientos intrusivos",
  "pregunta.psicologia.psicopatologia.6.personalidad.5.b": "Perfeccionismo y rigidez",
  "pregunta.psicologia.psicopatologia.6.personalidad.5.c": "Impulsividad",
  "pregunta.psicologia.psicopatologia.6.personalidad.5.por_que": "Distinto del TOC.",
  "tema.psicologia.psicopatologia.6.alimentacion": "Alimentación y sustancias",
  "tema.psicologia.psicopatologia.6.alimentacion.texto": "La anorexia nerviosa tiene restricción de comida, peso bajo y miedo intenso a engordar; la bulimia, atracones con conductas para compensar. Los trastornos por uso de sustancias incluyen tolerancia, abstinencia y seguir consumiendo pese al daño.",
  "pregunta.psicologia.psicopatologia.6.alimentacion.1": "¿Qué caracteriza a la anorexia nerviosa?",
  "pregunta.psicologia.psicopatologia.6.alimentacion.1.a": "Restricción, peso bajo y miedo intenso a engordar",
  "pregunta.psicologia.psicopatologia.6.alimentacion.1.b": "Comer en exceso",
  "pregunta.psicologia.psicopatologia.6.alimentacion.1.c": "Alergias",
  "pregunta.psicologia.psicopatologia.6.alimentacion.1.por_que": "Imagen corporal.",
  "pregunta.psicologia.psicopatologia.6.alimentacion.2": "¿Qué caracteriza a la bulimia?",
  "pregunta.psicologia.psicopatologia.6.alimentacion.2.a": "Comer poco siempre",
  "pregunta.psicologia.psicopatologia.6.alimentacion.2.b": "Atracones con conductas compensatorias",
  "pregunta.psicologia.psicopatologia.6.alimentacion.2.c": "No tener hambre",
  "pregunta.psicologia.psicopatologia.6.alimentacion.2.por_que": "Vómito, laxantes, ejercicio.",
  "pregunta.psicologia.psicopatologia.6.alimentacion.3": "¿Qué es la tolerancia en el consumo de sustancias?",
  "pregunta.psicologia.psicopatologia.6.alimentacion.3.a": "Aceptar a otros",
  "pregunta.psicologia.psicopatologia.6.alimentacion.3.b": "Dejar de consumir",
  "pregunta.psicologia.psicopatologia.6.alimentacion.3.c": "Necesitar más cantidad para el mismo efecto",
  "pregunta.psicologia.psicopatologia.6.alimentacion.3.por_que": "Adaptación.",
  "pregunta.psicologia.psicopatologia.6.alimentacion.4": "¿Qué es la abstinencia?",
  "pregunta.psicologia.psicopatologia.6.alimentacion.4.a": "Síntomas al dejar o bajar el consumo",
  "pregunta.psicologia.psicopatologia.6.alimentacion.4.b": "No consumir nunca",
  "pregunta.psicologia.psicopatologia.6.alimentacion.4.c": "Un deporte",
  "pregunta.psicologia.psicopatologia.6.alimentacion.4.por_que": "Malestar físico y psíquico.",
  "pregunta.psicologia.psicopatologia.6.alimentacion.5": "¿Qué institución chilena trabaja en prevención de drogas y alcohol?",
  "pregunta.psicologia.psicopatologia.6.alimentacion.5.a": "SENCE",
  "pregunta.psicologia.psicopatologia.6.alimentacion.5.b": "SENDA",
  "pregunta.psicologia.psicopatologia.6.alimentacion.5.c": "SERNAC",
  "pregunta.psicologia.psicopatologia.6.alimentacion.5.por_que": "Servicio Nacional.",
  "tema.psicologia.psicopatologia.6.infancia": "Trastornos del neurodesarrollo",
  "tema.psicologia.psicopatologia.6.infancia.texto": "Los trastornos del neurodesarrollo aparecen en la infancia: el trastorno del espectro autista (dificultades en la comunicación social e intereses restringidos), el TDAH (inatención, hiperactividad e impulsividad) y la discapacidad intelectual.\n\nEn Chile la Ley TEA (21.545, de 2023) protege los derechos de las personas autistas.",
  "pregunta.psicologia.psicopatologia.6.infancia.1": "¿Qué caracteriza al espectro autista?",
  "pregunta.psicologia.psicopatologia.6.infancia.1.a": "Dificultades en la comunicación social e intereses restringidos",
  "pregunta.psicologia.psicopatologia.6.infancia.1.b": "Tristeza profunda",
  "pregunta.psicologia.psicopatologia.6.infancia.1.c": "Mucha memoria siempre",
  "pregunta.psicologia.psicopatologia.6.infancia.1.por_que": "Espectro amplio.",
  "pregunta.psicologia.psicopatologia.6.infancia.2": "¿Qué síntomas tiene el TDAH?",
  "pregunta.psicologia.psicopatologia.6.infancia.2.a": "Delirios",
  "pregunta.psicologia.psicopatologia.6.infancia.2.b": "Inatención, hiperactividad e impulsividad",
  "pregunta.psicologia.psicopatologia.6.infancia.2.c": "Pérdida de memoria",
  "pregunta.psicologia.psicopatologia.6.infancia.2.por_que": "Desde la infancia.",
  "pregunta.psicologia.psicopatologia.6.infancia.3": "¿Qué ley chilena protege a las personas autistas?",
  "pregunta.psicologia.psicopatologia.6.infancia.3.a": "La Ley 20.720",
  "pregunta.psicologia.psicopatologia.6.infancia.3.b": "La Ley de Tránsito",
  "pregunta.psicologia.psicopatologia.6.infancia.3.c": "La Ley 21.545 (Ley TEA)",
  "pregunta.psicologia.psicopatologia.6.infancia.3.por_que": "2023.",
  "pregunta.psicologia.psicopatologia.6.infancia.4": "¿Causan las vacunas el autismo?",
  "pregunta.psicologia.psicopatologia.6.infancia.4.a": "No, la evidencia lo descarta",
  "pregunta.psicologia.psicopatologia.6.infancia.4.b": "Sí",
  "pregunta.psicologia.psicopatologia.6.infancia.4.c": "Solo algunas",
  "pregunta.psicologia.psicopatologia.6.infancia.4.por_que": "Mito desmentido.",
  "pregunta.psicologia.psicopatologia.6.infancia.5": "¿Desaparece el TDAH en la adultez?",
  "pregunta.psicologia.psicopatologia.6.infancia.5.a": "Siempre desaparece",
  "pregunta.psicologia.psicopatologia.6.infancia.5.b": "En muchas personas continúa, aunque cambie",
  "pregunta.psicologia.psicopatologia.6.infancia.5.c": "Nunca existió",
  "pregunta.psicologia.psicopatologia.6.infancia.5.por_que": "Persistencia."
}
