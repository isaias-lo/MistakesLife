{
  "tema.psicologia.psicologia_social.3.conformidad": "Conformidad",
  "tema.psicologia.psicologia_social.3.conformidad.texto": "Asch mostró que muchas personas dan una respuesta que saben falsa para coincidir con el grupo: en sus experimentos de líneas, cerca de un tercio de las respuestas se conformaron. La conformidad baja si hay al menos un aliado que disiente.",
  "pregunta.psicologia.psicologia_social.3.conformidad.1": "¿Qué mostró Asch con las líneas?",
  "pregunta.psicologia.psicologia_social.3.conformidad.1.a": "Que muchas personas se conforman con el grupo aunque sepan que está equivocado",
  "pregunta.psicologia.psicologia_social.3.conformidad.1.b": "Que nadie se deja influir",
  "pregunta.psicologia.psicologia_social.3.conformidad.1.c": "Que la vista falla con la edad",
  "pregunta.psicologia.psicologia_social.3.conformidad.1.por_que": "Presión de grupo.",
  "pregunta.psicologia.psicologia_social.3.conformidad.2": "¿Qué baja la conformidad en el experimento de Asch?",
  "pregunta.psicologia.psicologia_social.3.conformidad.2.a": "Que el grupo sea más grande",
  "pregunta.psicologia.psicologia_social.3.conformidad.2.b": "Que haya al menos otra persona que disienta",
  "pregunta.psicologia.psicologia_social.3.conformidad.2.c": "Que la tarea sea más difícil",
  "pregunta.psicologia.psicologia_social.3.conformidad.2.por_que": "Un aliado.",
  "pregunta.psicologia.psicologia_social.3.conformidad.3": "¿Qué es la influencia normativa?",
  "pregunta.psicologia.psicologia_social.3.conformidad.3.a": "Conformarse porque el grupo sabe más",
  "pregunta.psicologia.psicologia_social.3.conformidad.3.b": "Obedecer la ley",
  "pregunta.psicologia.psicologia_social.3.conformidad.3.c": "Conformarse para ser aceptado",
  "pregunta.psicologia.psicologia_social.3.conformidad.3.por_que": "Deseo de pertenecer.",
  "pregunta.psicologia.psicologia_social.3.conformidad.4": "¿Qué es la influencia informativa?",
  "pregunta.psicologia.psicologia_social.3.conformidad.4.a": "Conformarse porque se cree que el grupo tiene razón",
  "pregunta.psicologia.psicologia_social.3.conformidad.4.b": "Conformarse por miedo",
  "pregunta.psicologia.psicologia_social.3.conformidad.4.c": "Leer el diario",
  "pregunta.psicologia.psicologia_social.3.conformidad.4.por_que": "Cuando hay incertidumbre.",
  "pregunta.psicologia.psicologia_social.3.conformidad.5": "¿Qué es el pensamiento de grupo?",
  "pregunta.psicologia.psicologia_social.3.conformidad.5.a": "Pensar todos lo mismo por casualidad",
  "pregunta.psicologia.psicologia_social.3.conformidad.5.b": "Cuando un grupo busca acuerdo y deja de evaluar alternativas",
  "pregunta.psicologia.psicologia_social.3.conformidad.5.c": "Una técnica de estudio",
  "pregunta.psicologia.psicologia_social.3.conformidad.5.por_que": "Janis.",
  "tema.psicologia.psicologia_social.3.obediencia": "Obediencia a la autoridad",
  "tema.psicologia.psicologia_social.3.obediencia.texto": "Milgram mostró que dos tercios de los participantes siguieron dando lo que creían descargas eléctricas peligrosas porque un investigador se lo pedía. La obediencia baja si la autoridad está lejos o si la víctima está cerca.\n\nEstos experimentos llevaron a reglas éticas más estrictas.",
  "pregunta.psicologia.psicologia_social.3.obediencia.1": "¿Qué estudió Milgram?",
  "pregunta.psicologia.psicologia_social.3.obediencia.1.a": "La obediencia a la autoridad",
  "pregunta.psicologia.psicologia_social.3.obediencia.1.b": "La memoria",
  "pregunta.psicologia.psicologia_social.3.obediencia.1.c": "El sueño",
  "pregunta.psicologia.psicologia_social.3.obediencia.1.por_que": "Descargas falsas.",
  "pregunta.psicologia.psicologia_social.3.obediencia.2": "¿Qué proporción llegó al máximo en el estudio clásico?",
  "pregunta.psicologia.psicologia_social.3.obediencia.2.a": "Casi nadie",
  "pregunta.psicologia.psicologia_social.3.obediencia.2.b": "Cerca de dos tercios",
  "pregunta.psicologia.psicologia_social.3.obediencia.2.c": "Todos",
  "pregunta.psicologia.psicologia_social.3.obediencia.2.por_que": "65 %.",
  "pregunta.psicologia.psicologia_social.3.obediencia.3": "¿Qué baja la obediencia?",
  "pregunta.psicologia.psicologia_social.3.obediencia.3.a": "Que el investigador use bata",
  "pregunta.psicologia.psicologia_social.3.obediencia.3.b": "Que sea en una universidad famosa",
  "pregunta.psicologia.psicologia_social.3.obediencia.3.c": "Que la víctima esté cerca o la autoridad lejos",
  "pregunta.psicologia.psicologia_social.3.obediencia.3.por_que": "Proximidad.",
  "pregunta.psicologia.psicologia_social.3.obediencia.4": "¿Por qué hoy no se puede repetir igual el estudio de Milgram?",
  "pregunta.psicologia.psicologia_social.3.obediencia.4.a": "Por el daño psicológico a los participantes",
  "pregunta.psicologia.psicologia_social.3.obediencia.4.b": "Porque ya no hay electricidad",
  "pregunta.psicologia.psicologia_social.3.obediencia.4.c": "Porque es aburrido",
  "pregunta.psicologia.psicologia_social.3.obediencia.4.por_que": "Ética.",
  "pregunta.psicologia.psicologia_social.3.obediencia.5": "¿Qué mostró el experimento de la cárcel de Stanford, según sus críticos?",
  "pregunta.psicologia.psicologia_social.3.obediencia.5.a": "Que es totalmente confiable",
  "pregunta.psicologia.psicologia_social.3.obediencia.5.b": "Que tuvo problemas de método y guía del investigador",
  "pregunta.psicologia.psicologia_social.3.obediencia.5.c": "Que nadie cambió",
  "pregunta.psicologia.psicologia_social.3.obediencia.5.por_que": "Zimbardo, revisado.",
  "tema.psicologia.psicologia_social.3.actitudes": "Actitudes y disonancia",
  "tema.psicologia.psicologia_social.3.actitudes.texto": "Una actitud es una evaluación de algo (personas, ideas). Festinger propuso la disonancia cognitiva: incomodidad al actuar contra lo que se piensa, que lleva a cambiar la actitud o justificarse.\n\nLa persuasión depende de quién habla, qué dice y a quién.",
  "pregunta.psicologia.psicologia_social.3.actitudes.1": "¿Qué es la disonancia cognitiva?",
  "pregunta.psicologia.psicologia_social.3.actitudes.1.a": "La incomodidad al tener ideas o actos contradictorios",
  "pregunta.psicologia.psicologia_social.3.actitudes.1.b": "Un trastorno del oído",
  "pregunta.psicologia.psicologia_social.3.actitudes.1.c": "Escuchar mala música",
  "pregunta.psicologia.psicologia_social.3.actitudes.1.por_que": "Festinger.",
  "pregunta.psicologia.psicologia_social.3.actitudes.2": "Un fumador que dice 'de algo hay que morir' está...",
  "pregunta.psicologia.psicologia_social.3.actitudes.2.a": "Siendo objetivo",
  "pregunta.psicologia.psicologia_social.3.actitudes.2.b": "Reduciendo su disonancia",
  "pregunta.psicologia.psicologia_social.3.actitudes.2.c": "Mostrando apego seguro",
  "pregunta.psicologia.psicologia_social.3.actitudes.2.por_que": "Justificación.",
  "pregunta.psicologia.psicologia_social.3.actitudes.3": "¿Qué es una actitud?",
  "pregunta.psicologia.psicologia_social.3.actitudes.3.a": "Una postura del cuerpo",
  "pregunta.psicologia.psicologia_social.3.actitudes.3.b": "Una conducta obligada",
  "pregunta.psicologia.psicologia_social.3.actitudes.3.c": "Una evaluación favorable o desfavorable de algo",
  "pregunta.psicologia.psicologia_social.3.actitudes.3.por_que": "Componentes afectivo, cognitivo, conductual.",
  "pregunta.psicologia.psicologia_social.3.actitudes.4": "¿Qué propone el modelo de probabilidad de elaboración?",
  "pregunta.psicologia.psicologia_social.3.actitudes.4.a": "Que se persuade por la vía central (argumentos) o periférica (señales)",
  "pregunta.psicologia.psicologia_social.3.actitudes.4.b": "Que nadie cambia de idea",
  "pregunta.psicologia.psicologia_social.3.actitudes.4.c": "Que solo importa el precio",
  "pregunta.psicologia.psicologia_social.3.actitudes.4.por_que": "Petty y Cacioppo.",
  "pregunta.psicologia.psicologia_social.3.actitudes.5": "Una celebridad que vende un producto apela a la vía...",
  "pregunta.psicologia.psicologia_social.3.actitudes.5.a": "Central",
  "pregunta.psicologia.psicologia_social.3.actitudes.5.b": "Periférica",
  "pregunta.psicologia.psicologia_social.3.actitudes.5.c": "Lógica",
  "pregunta.psicologia.psicologia_social.3.actitudes.5.por_que": "Señal superficial.",
  "tema.psicologia.psicologia_social.3.atribucion": "Atribución",
  "tema.psicologia.psicologia_social.3.atribucion.texto": "Atribuir es explicar por qué pasa algo. El error fundamental de atribución es explicar la conducta de otros por cómo son, olvidando la situación. El sesgo de autobeneficio es atribuir los éxitos a uno mismo y los fracasos a fuera.",
  "pregunta.psicologia.psicologia_social.3.atribucion.1": "¿Qué es el error fundamental de atribución?",
  "pregunta.psicologia.psicologia_social.3.atribucion.1.a": "Explicar la conducta de otros por su forma de ser, ignorando la situación",
  "pregunta.psicologia.psicologia_social.3.atribucion.1.b": "Equivocarse al sumar",
  "pregunta.psicologia.psicologia_social.3.atribucion.1.c": "Culparse siempre",
  "pregunta.psicologia.psicologia_social.3.atribucion.1.por_que": "Ross.",
  "pregunta.psicologia.psicologia_social.3.atribucion.2": "Alguien te cierra en la calle y piensas 'es un pesado', sin saber que va al hospital. ¿Qué es?",
  "pregunta.psicologia.psicologia_social.3.atribucion.2.a": "Disonancia",
  "pregunta.psicologia.psicologia_social.3.atribucion.2.b": "Error fundamental de atribución",
  "pregunta.psicologia.psicologia_social.3.atribucion.2.c": "Conformidad",
  "pregunta.psicologia.psicologia_social.3.atribucion.2.por_que": "Ignora la situación.",
  "pregunta.psicologia.psicologia_social.3.atribucion.3": "¿Qué es el sesgo de autobeneficio?",
  "pregunta.psicologia.psicologia_social.3.atribucion.3.a": "Ayudar a otros",
  "pregunta.psicologia.psicologia_social.3.atribucion.3.b": "Compararse",
  "pregunta.psicologia.psicologia_social.3.atribucion.3.c": "Atribuirse los éxitos y culpar a otros de los fracasos",
  "pregunta.psicologia.psicologia_social.3.atribucion.3.por_que": "Protege la autoestima.",
  "pregunta.psicologia.psicologia_social.3.atribucion.4": "¿Qué es una atribución externa?",
  "pregunta.psicologia.psicologia_social.3.atribucion.4.a": "Explicar una conducta por la situación",
  "pregunta.psicologia.psicologia_social.3.atribucion.4.b": "Explicarla por la personalidad",
  "pregunta.psicologia.psicologia_social.3.atribucion.4.c": "Una herencia",
  "pregunta.psicologia.psicologia_social.3.atribucion.4.por_que": "Situacional.",
  "pregunta.psicologia.psicologia_social.3.atribucion.5": "¿Qué es el efecto del falso consenso?",
  "pregunta.psicologia.psicologia_social.3.atribucion.5.a": "Que todos piensan distinto",
  "pregunta.psicologia.psicologia_social.3.atribucion.5.b": "Creer que los demás piensan como uno más de lo que es real",
  "pregunta.psicologia.psicologia_social.3.atribucion.5.c": "Un acuerdo legal",
  "pregunta.psicologia.psicologia_social.3.atribucion.5.por_que": "Sobreestimación."
}
