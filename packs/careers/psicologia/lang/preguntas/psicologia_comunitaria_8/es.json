{
  "tema.psicologia.psicologia_comunitaria.8.fundamentos": "Fundamentos",
  "tema.psicologia.psicologia_comunitaria.8.fundamentos.texto": "La psicología comunitaria trabaja con las comunidades, no solo con individuos. Busca prevenir, promover el bienestar y fortalecer (empoderar) a las personas para que tomen decisiones sobre su vida. Nació en Latinoamérica muy ligada a los barrios y a la participación.",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.1": "¿Con quién trabaja la psicología comunitaria?",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.1.a": "Con las comunidades y sus organizaciones",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.1.b": "Solo con individuos en consulta",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.1.c": "Solo con empresas",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.1.por_que": "Nivel comunitario.",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.2": "¿Qué es el empoderamiento?",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.2.a": "Dar poder al psicólogo",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.2.b": "Fortalecer a las personas para que decidan sobre su vida",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.2.c": "Un cargo político",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.2.por_que": "Rappaport, Montero.",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.3": "¿Qué privilegia sobre el tratamiento individual?",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.3.a": "Los fármacos",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.3.b": "Los tests",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.3.c": "La prevención y la promoción",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.3.por_que": "Antes de que aparezca el problema.",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.4": "¿Quién es una autora clave de la psicología comunitaria latinoamericana?",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.4.a": "Maritza Montero",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.4.b": "Melanie Klein",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.4.c": "Karen Horney",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.4.por_que": "Venezuela.",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.5": "¿Qué rol tiene la comunidad en una intervención?",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.5.a": "Solo recibe ayuda",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.5.b": "Participa activamente en definir problemas y soluciones",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.5.c": "Ninguno",
  "pregunta.psicologia.psicologia_comunitaria.8.fundamentos.5.por_que": "Participación.",
  "tema.psicologia.psicologia_comunitaria.8.redes": "Redes y apoyo social",
  "tema.psicologia.psicologia_comunitaria.8.redes.texto": "Las redes de apoyo (familia, vecinos, juntas de vecinos, organizaciones) protegen la salud mental. El capital social son los lazos de confianza y cooperación de una comunidad. El trabajo en red une a las instituciones del territorio: Cesfam, colegios, municipio.",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.1": "¿Qué es el capital social?",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.1.a": "Los lazos de confianza y cooperación de una comunidad",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.1.b": "El dinero de una empresa",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.1.c": "El número de amigos en redes",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.1.por_que": "Putnam.",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.2": "¿Qué es el trabajo en red?",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.2.a": "Trabajar en internet",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.2.b": "Coordinar a las instituciones de un territorio",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.2.c": "Pescar",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.2.por_que": "Intersectorial.",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.3": "¿Qué organización vecinal existe en Chile por ley?",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.3.a": "El sindicato",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.3.b": "La AFP",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.3.c": "La junta de vecinos",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.3.por_que": "Ley 19.418.",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.4": "¿Por qué protege el apoyo social?",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.4.a": "Amortigua el efecto del estrés",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.4.b": "No protege",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.4.c": "Porque da dinero",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.4.por_que": "Efecto amortiguador.",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.5": "¿Qué es un diagnóstico participativo?",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.5.a": "Un test aplicado a todos",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.5.b": "Identificar problemas junto con la comunidad",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.5.c": "Un diagnóstico médico",
  "pregunta.psicologia.psicologia_comunitaria.8.redes.5.por_que": "Con los vecinos.",
  "tema.psicologia.psicologia_comunitaria.8.intervencion": "Intervención en el territorio",
  "tema.psicologia.psicologia_comunitaria.8.intervencion.texto": "Una intervención comunitaria parte del diagnóstico, define objetivos con la comunidad, se implementa y se evalúa. La investigación acción participativa une conocer y transformar. Programas públicos como Chile Crece Contigo y Senda Previene trabajan en el territorio.",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.1": "¿Qué es la investigación acción participativa?",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.1.a": "Investigar junto con la comunidad para transformar su realidad",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.1.b": "Un experimento de laboratorio",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.1.c": "Una encuesta telefónica",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.1.por_que": "Fals Borda.",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.2": "¿Qué programa chileno acompaña el desarrollo infantil desde la gestación?",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.2.a": "Senda Previene",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.2.b": "Chile Crece Contigo",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.2.c": "Fonasa",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.2.por_que": "Desde 2007.",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.3": "¿Qué hace Senda Previene?",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.3.a": "Entrega licencias",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.3.b": "Fiscaliza impuestos",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.3.c": "Prevención del consumo de drogas y alcohol en las comunas",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.3.por_que": "Municipal.",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.4": "¿Por qué se evalúa una intervención?",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.4.a": "Para saber si logró lo que buscaba",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.4.b": "Por burocracia",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.4.c": "No se evalúa",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.4.por_que": "Resultados.",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.5": "¿Qué riesgo tiene llegar con soluciones listas a una comunidad?",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.5.a": "Ninguno",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.5.b": "Que no respondan a lo que la comunidad necesita",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.5.c": "Que sea muy barato",
  "pregunta.psicologia.psicologia_comunitaria.8.intervencion.5.por_que": "Asistencialismo.",
  "tema.psicologia.psicologia_comunitaria.8.prevencion": "Niveles de prevención",
  "tema.psicologia.psicologia_comunitaria.8.prevencion.texto": "La prevención primaria actúa antes de que aparezca el problema (talleres en colegios); la secundaria lo detecta temprano (tamizaje); la terciaria reduce sus consecuencias (rehabilitación). También se distinguen prevención universal, selectiva e indicada.",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.1": "¿Qué es la prevención primaria?",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.1.a": "Actuar antes de que aparezca el problema",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.1.b": "Tratar a quien ya está enfermo",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.1.c": "Rehabilitar",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.1.por_que": "Ejemplo: talleres.",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.2": "Un tamizaje de depresión en adolescentes es prevención...",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.2.a": "Primaria",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.2.b": "Secundaria",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.2.c": "Terciaria",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.2.por_que": "Detección temprana.",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.3": "¿Qué es la prevención terciaria?",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.3.a": "Evitar que aparezca",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.3.b": "Detectarlo",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.3.c": "Reducir las consecuencias de un problema ya presente",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.3.por_que": "Rehabilitación.",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.4": "¿Qué es la prevención universal?",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.4.a": "Dirigida a toda la población",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.4.b": "Solo a personas en riesgo",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.4.c": "Solo a enfermos",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.4.por_que": "Gordon.",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.5": "¿Qué es la prevención selectiva?",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.5.a": "A toda la población",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.5.b": "Dirigida a grupos con más riesgo",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.5.c": "A quienes ya tienen síntomas",
  "pregunta.psicologia.psicologia_comunitaria.8.prevencion.5.por_que": "Grupo de riesgo."
}
