  "pregunta.psicologia.evaluacion_psicologica.6.personalidad_tests.1.a": "Un inventario de personalidad con escalas clínicas y de validez",
  "pregunta.psicologia.evaluacion_psicologica.6.personalidad_tests.1.b": "Un test de inteligencia",
  "pregunta.psicologia.evaluacion_psicologica.6.personalidad_tests.1.c": "Un examen de sangre",
  "pregunta.psicologia.evaluacion_psicologica.6.personalidad_tests.1.por_que": "Minnesota.",
