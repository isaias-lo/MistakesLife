{
  "tema.psicologia.psicologia_desarrollo.3.piaget": "Piaget y el pensamiento",
  "tema.psicologia.psicologia_desarrollo.3.piaget.texto": "Para Piaget el niño construye su pensamiento por etapas: sensoriomotora (0-2 años), preoperacional (2-7), operaciones concretas (7-11) y operaciones formales (desde los 11-12).\n\nEn la preoperacional el niño es egocéntrico y aún no logra la conservación.",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.1": "¿Qué etapa de Piaget va de los 2 a los 7 años?",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.1.a": "Preoperacional",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.1.b": "Sensoriomotora",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.1.c": "Operaciones formales",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.1.por_que": "Pensamiento simbólico.",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.2": "¿Qué es la conservación?",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.2.a": "Guardar juguetes",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.2.b": "Entender que la cantidad no cambia si cambia la forma",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.2.c": "Recordar a la madre",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.2.por_que": "Se logra en operaciones concretas.",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.3": "¿Qué logra el bebé en la etapa sensoriomotora?",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.3.a": "El pensamiento abstracto",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.3.b": "La lectura",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.3.c": "La permanencia del objeto",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.3.por_que": "Sabe que algo existe aunque no lo vea.",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.4": "¿Desde qué etapa se razona de forma abstracta e hipotética?",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.4.a": "Operaciones formales",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.4.b": "Preoperacional",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.4.c": "Sensoriomotora",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.4.por_que": "Adolescencia.",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.5": "¿Qué es el egocentrismo infantil para Piaget?",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.5.a": "Ser egoísta",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.5.b": "No poder ver las cosas desde el punto de vista de otro",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.5.c": "Querer ser el centro",
  "pregunta.psicologia.psicologia_desarrollo.3.piaget.5.por_que": "Es cognitivo, no moral.",
  "tema.psicologia.psicologia_desarrollo.3.vygotsky": "Vygotsky y el aprendizaje social",
  "tema.psicologia.psicologia_desarrollo.3.vygotsky.texto": "Para Vygotsky el niño aprende en interacción con otros. La zona de desarrollo próximo es la distancia entre lo que hace solo y lo que logra con ayuda. El andamiaje es esa ayuda que se retira de a poco.\n\nEl lenguaje es la principal herramienta del pensamiento.",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.1": "¿Qué es la zona de desarrollo próximo?",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.1.a": "Lo que el niño logra con ayuda pero aún no solo",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.1.b": "Un lugar del colegio",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.1.c": "La edad mental",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.1.por_que": "Vygotsky.",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.2": "¿Qué es el andamiaje?",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.2.a": "Un castigo",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.2.b": "La ayuda que se ajusta y se retira de a poco",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.2.c": "Una prueba de inteligencia",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.2.por_que": "Bruner, desde Vygotsky.",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.3": "¿Qué destaca Vygotsky frente a Piaget?",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.3.a": "Que no hay etapas de ningún tipo",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.3.b": "Que todo es genético",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.3.c": "El papel de la cultura y de los otros",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.3.por_que": "Aprendizaje social.",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.4": "¿Qué es el habla privada?",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.4.a": "Cuando el niño se habla a sí mismo para guiarse",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.4.b": "Un trastorno del lenguaje",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.4.c": "Hablar en secreto",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.4.por_que": "Se interioriza.",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.5": "Un profe que da pistas hasta que el niño resuelve solo está aplicando...",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.5.a": "Condicionamiento clásico",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.5.b": "Andamiaje",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.5.c": "Castigo",
  "pregunta.psicologia.psicologia_desarrollo.3.vygotsky.5.por_que": "Apoyo graduado.",
  "tema.psicologia.psicologia_desarrollo.3.apego": "Apego",
  "tema.psicologia.psicologia_desarrollo.3.apego.texto": "Bowlby propuso que el bebé busca cercanía con su cuidador para sentirse seguro. Ainsworth, con la situación extraña, describió tipos de apego: seguro, inseguro evitativo, inseguro ambivalente y, después, desorganizado.\n\nUn apego seguro nace de cuidadores sensibles y disponibles.",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.1": "¿Quién propuso la teoría del apego?",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.1.a": "John Bowlby",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.1.b": "Sigmund Freud",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.1.c": "B. F. Skinner",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.1.por_que": "Años 50 y 60.",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.2": "¿Qué es la situación extraña?",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.2.a": "Un sueño raro",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.2.b": "Un procedimiento que observa al bebé al separarse y reencontrarse con su cuidador",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.2.c": "Un test de inteligencia",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.2.por_que": "Mary Ainsworth.",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.3": "Un bebé que se calma rápido al volver su madre, ¿qué apego muestra?",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.3.a": "Evitativo",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.3.b": "Desorganizado",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.3.c": "Seguro",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.3.por_que": "Base segura.",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.4": "¿De qué depende sobre todo un apego seguro?",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.4.a": "De un cuidador sensible y disponible",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.4.b": "De tener muchos juguetes",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.4.c": "Del sexo del bebé",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.4.por_que": "Sensibilidad.",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.5": "Un bebé que ignora a su cuidador al volver muestra apego...",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.5.a": "Seguro",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.5.b": "Inseguro evitativo",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.5.c": "Ambivalente",
  "pregunta.psicologia.psicologia_desarrollo.3.apego.5.por_que": "Evita el contacto.",
  "tema.psicologia.psicologia_desarrollo.3.moral": "Desarrollo moral y social",
  "tema.psicologia.psicologia_desarrollo.3.moral.texto": "Kohlberg describió tres niveles del juicio moral: preconvencional (evitar castigo), convencional (cumplir normas y ser buena persona) y posconvencional (principios universales). Gilligan criticó que dejaba fuera la ética del cuidado.\n\nErikson describe la niñez como etapas de confianza, autonomía, iniciativa y laboriosidad.",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.1": "¿Qué nivel de Kohlberg se guía por evitar el castigo?",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.1.a": "Preconvencional",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.1.b": "Convencional",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.1.c": "Posconvencional",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.1.por_que": "Nivel 1.",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.2": "¿Qué criticó Carol Gilligan a Kohlberg?",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.2.a": "Que usaba números",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.2.b": "Que dejaba fuera la ética del cuidado",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.2.c": "Que estudiaba a niños",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.2.por_que": "Perspectiva de género.",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.3": "¿Qué etapa de Erikson corresponde a la edad escolar?",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.3.a": "Intimidad vs. aislamiento",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.3.b": "Integridad vs. desesperación",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.3.c": "Laboriosidad vs. inferioridad",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.3.por_que": "6 a 12 años.",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.4": "¿Qué etapa de Erikson va primero?",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.4.a": "Confianza vs. desconfianza",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.4.b": "Identidad vs. confusión",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.4.c": "Iniciativa vs. culpa",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.4.por_que": "Primer año.",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.5": "El nivel posconvencional se guía por...",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.5.a": "El miedo al castigo",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.5.b": "Principios éticos universales",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.5.c": "La aprobación del grupo",
  "pregunta.psicologia.psicologia_desarrollo.3.moral.5.por_que": "Pocos lo alcanzan."
}
